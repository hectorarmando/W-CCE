---
import { programas } from "../data/programas";
import { sitio } from "../data/sitio";

interface Props { modo?: "persona" | "empresa"; programaInicial?: string; }
const { modo = "persona", programaInicial = "" } = Astro.props;

// Si no hay endpoint configurado, el formulario arma el mensaje y lo abre en el WhatsApp oficial.
const endpoint = import.meta.env.PUBLIC_FORM_ENDPOINT ?? "";
const usaWhatsapp = !endpoint;
const paises = ["Perú", "Ecuador", "México", "Colombia", "Costa Rica", "Panamá", "Otro país"];
const id = `f-${modo}`;
---
<form class="form" novalidate data-formulario data-modo={modo} data-endpoint={endpoint} data-whatsapp={sitio.whatsapp.numero} aria-describedby={`${id}-nota`}>
  <div class="form__rejilla">
    <div class="campo">
      <label for={`${id}-nombre`}>Nombre y apellido</label>
      <input id={`${id}-nombre`} name="nombre" type="text" autocomplete="name" required maxlength="80" />
      <p class="campo__error" id={`${id}-nombre-error`} hidden></p>
    </div>
    <div class="campo">
      <label for={`${id}-correo`}>Correo electrónico</label>
      <input id={`${id}-correo`} name="correo" type="email" autocomplete="email" required maxlength="120" />
      <p class="campo__error" id={`${id}-correo-error`} hidden></p>
    </div>
    <div class="campo">
      <label for={`${id}-telefono`}>Celular o WhatsApp</label>
      <input id={`${id}-telefono`} name="telefono" type="tel" autocomplete="tel" inputmode="tel" required maxlength="20" placeholder="+51 999 999 999" />
      <p class="campo__ayuda">Incluye el código de país si no estás en Perú.</p>
      <p class="campo__error" id={`${id}-telefono-error`} hidden></p>
    </div>
    <div class="campo">
      <label for={`${id}-pais`}>País</label>
      <select id={`${id}-pais`} name="pais" required>
        {paises.map((p) => <option value={p}>{p}</option>)}
      </select>
    </div>

    {modo === "empresa" ? (
      <>
        <div class="campo">
          <label for={`${id}-empresa`}>Empresa</label>
          <input id={`${id}-empresa`} name="empresa" type="text" autocomplete="organization" required maxlength="120" />
          <p class="campo__error" id={`${id}-empresa-error`} hidden></p>
        </div>
        <div class="campo">
          <label for={`${id}-colaboradores`}>Personas a capacitar</label>
          <select id={`${id}-colaboradores`} name="colaboradores" required>
            <option value="">Selecciona</option>
            <option>Hasta 10</option><option>De 11 a 30</option><option>De 31 a 100</option><option>Más de 100</option>
          </select>
          <p class="campo__error" id={`${id}-colaboradores-error`} hidden></p>
        </div>
      </>
    ) : (
      <div class="campo campo--ancho">
        <label for={`${id}-interes`}>¿Qué te interesa?</label>
        <select id={`${id}-interes`} name="interes" required>
          <option value="">Selecciona un programa</option>
          {programas.map((p) => <option value={p.nombre} data-slug={p.slug} selected={p.slug === programaInicial}>{p.nombre}</option>)}
          <option value="Otro curso del catálogo">Otro curso del catálogo</option>
          <option value="Capacitación para empresas">Capacitación para empresas</option>
          <option value="Necesito orientación">No lo sé, necesito orientación</option>
        </select>
        <p class="campo__error" id={`${id}-interes-error`} hidden></p>
      </div>
    )}

    <div class="campo campo--ancho">
      <label for={`${id}-mensaje`}>{modo === "empresa" ? "¿Qué necesita aprender tu equipo?" : "Mensaje"} <span class="opcional">(opcional)</span></label>
      <textarea id={`${id}-mensaje`} name="mensaje" rows="4" maxlength="1000"></textarea>
    </div>

    <!-- Campo trampa para bots: oculto para personas -->
    <div class="trampa" aria-hidden="true">
      <label for={`${id}-web`}>No completar</label>
      <input id={`${id}-web`} name="web" type="text" tabindex="-1" autocomplete="off" />
    </div>

    <div class="campo campo--ancho campo--check">
      <input id={`${id}-acepto`} name="acepto" type="checkbox" required />
      <label for={`${id}-acepto`}>Autorizo a la Cámara de Comercio Exterior a usar estos datos para responder mi consulta, conforme a la Ley N.° 29733 de Protección de Datos Personales.</label>
      <p class="campo__error" id={`${id}-acepto-error`} hidden></p>
    </div>
  </div>

  <div class="form__pie">
    <button class="btn btn--negro" type="submit" data-enviar>
      <span data-texto>{usaWhatsapp ? "Enviar por WhatsApp" : "Enviar consulta"}</span>
      <span class="btn__flecha" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 14 14"><path d="M2 7h9M7.5 3 11.5 7l-4 4" fill="none" stroke="currentColor" stroke-width="2" /></svg></span>
    </button>
    <p class="form__nota" id={`${id}-nota`}>
      {usaWhatsapp
        ? "Al enviar se abrirá WhatsApp con tu mensaje listo para el equipo de atención."
        : "Te responderemos por correo o WhatsApp."}
    </p>
  </div>

  <div class="form__estado" role="status" aria-live="polite" tabindex="-1" data-estado hidden></div>
</form>

<style>
  .form__rejilla { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s-5) var(--s-5); }
  .campo { display: grid; gap: 6px; align-content: start; }
  .campo--ancho { grid-column: 1 / -1; }
  .campo label { font-weight: 700; font-size: var(--t-sm); }
  .opcional { font-weight: 400; color: var(--gris-oscuro); }
  .campo input:not([type="checkbox"]), .campo select, .campo textarea {
    width: 100%; min-height: 3.1rem; padding: 0.75rem 0.9rem; border: 1.5px solid var(--gris-claro); border-radius: var(--radio);
    background: var(--blanco); font-size: 1rem; transition: border-color 150ms var(--ease), box-shadow 150ms var(--ease);
  }
  .campo textarea { resize: vertical; min-height: 7rem; }
  .campo input:hover, .campo select:hover, .campo textarea:hover { border-color: var(--gris); }
  .campo input:focus, .campo select:focus, .campo textarea:focus { outline: none; border-color: var(--negro); box-shadow: 0 0 0 3px var(--amarillo-60); }
  .campo [aria-invalid="true"] { border-color: #b3261e !important; }
  .campo__ayuda { font-size: var(--t-xs); color: var(--gris-oscuro); }
  .campo__error { font-size: var(--t-xs); color: #b3261e; font-weight: 600; }
  .campo--check { grid-template-columns: auto 1fr; column-gap: var(--s-3); align-items: start; }
  .campo--check input { width: 1.35rem; height: 1.35rem; margin-top: 2px; accent-color: var(--negro); }
  .campo--check label { font-weight: 400; color: var(--gris-oscuro); }
  .campo--check .campo__error { grid-column: 2; }
  .trampa { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .form__pie { display: flex; flex-wrap: wrap; gap: var(--s-4); align-items: center; margin-top: var(--s-6); }
  .form__nota { font-size: var(--t-xs); color: var(--gris-oscuro); max-width: 36ch; }
  .form__estado { margin-top: var(--s-5); padding: var(--s-5); border-radius: var(--radio); font-weight: 600; }
  .form__estado[data-tipo="ok"] { background: var(--amarillo-30); border: 1px solid var(--amarillo); }
  .form__estado[data-tipo="error"] { background: #fdecea; border: 1px solid #f5c2bd; color: #6b1a14; }
  .form__estado a { font-weight: 800; }
  [data-enviar][aria-busy="true"] { cursor: progress; opacity: 0.75; }
  @media (max-width: 640px) { .form__rejilla { grid-template-columns: 1fr; } .form__pie .btn { width: 100%; justify-content: space-between; padding-left: 1.5rem; } }
</style>

<script>
  import { iniciarFormularios } from "../scripts/formulario";
  iniciarFormularios();
</script>
