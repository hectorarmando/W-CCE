---
// Pie del prototipo «negro y dorado»: una línea con la institución y los países, y los enlaces de servicio.
// «Validar certificado», «Libro de reclamaciones» y «Políticas» no tienen dirección todavía (docs/pendientes.md).
import { sitio, enlaceWhatsapp } from "../data/sitio";
import { paises } from "../data/paises";
const anio = new Date().getFullYear();
---
<footer class="pie">
  <div class="contenedor pie__fila">
    <a class="pie__logo" href="/" aria-label="Cámara de Comercio Exterior, ir al inicio">
      <img src="/brand/imagotipo-blanco.svg" alt="" width="168" height="110" loading="lazy" />
    </a>
    <nav aria-label="Sitio" class="pie__nav">
      <a href="/programas">Programas</a>
      <a href="/empresas">Empresas</a>
      <a href="/nosotros">Nosotros</a>
      <a href="/comunidad">Comunidad</a>
      <a href="/blog">Blog</a>
      <a href="/contacto">Contacto</a>
      <a href={enlaceWhatsapp("Hola, quiero información sobre los programas de la Cámara de Comercio Exterior.")} target="_blank" rel="noopener">WhatsApp {sitio.whatsapp.visible}</a>
    </nav>
  </div>
  <div class="contenedor pie__fila pie__legal">
    <span>© {anio} {sitio.nombre} ({sitio.sigla}) · {paises.filter((p) => p.codigo !== "OT").map((p) => p.nombre).join(" · ")}</span>
    <span class="pie__servicio">Validar certificado · Libro de reclamaciones · Políticas <span class="pendiente">Enlaces pendientes</span></span>
  </div>
</footer>

<style>
  .pie { border-top: 1px solid var(--line); color: var(--mut); font-size: 0.82rem; }
  .pie__fila { display: flex; justify-content: space-between; align-items: center; gap: 20px; flex-wrap: wrap; padding-block: 34px; }
  .pie__logo img { width: 100px; height: auto; }
  .pie__nav { display: flex; flex-wrap: wrap; gap: 4px 22px; }
  .pie__nav a { display: inline-flex; align-items: center; min-height: 44px; color: var(--mut); text-decoration: none; letter-spacing: 0.08em; text-transform: uppercase; font-size: 0.74rem; }
  .pie__nav a:hover { color: var(--gold2); }
  .pie__legal { border-top: 1px solid var(--line); padding-block: 22px 34px; }
</style>
