---
// Arco amarillo de la marca: la "C" envolvente del isologo llevada a gran escala (Manual 1.5 y piezas 7.1).
// `animado`: se dibuja una sola vez al cargar; con prefers-reduced-motion aparece completo.
interface Props { class?: string; animado?: boolean; grosor?: number; }
const { class: clase = "", animado = false, grosor = 15 } = Astro.props;
---
<svg class:list={["arco", clase, { "arco--animado": animado }]} viewBox="0 0 200 200" aria-hidden="true" focusable="false">
  <!-- Abertura hacia la derecha, como la "C" del isologo -->
  <path d="M 156.6 43.4 A 80 80 0 1 0 156.6 156.6" fill="none" stroke="var(--amarillo)" stroke-width={grosor} stroke-linecap="butt" pathLength="100" />
</svg>

<style>
  .arco { overflow: visible; }
  @media (prefers-reduced-motion: no-preference) {
    .arco--animado path { stroke-dasharray: 100; stroke-dashoffset: 100; animation: trazar 1.4s var(--ease) 0.15s forwards; }
  }
  @keyframes trazar { to { stroke-dashoffset: 0; } }
</style>
