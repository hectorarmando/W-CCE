---
// Cabecera del prototipo «negro y dorado»: logo, cuatro enlaces en mayúsculas espaciadas, selector de país
// (precios por país) y botón «Matrícula». En pantallas angostas, menú desplegable.
import SelectorPais from "./SelectorPais.astro";

const actual = Astro.url.pathname.replace(/\.html$/, "").replace(/\/$/, "") || "/";
const activo = (href: string) => (href === "/" ? actual === "/" : actual === href || actual.startsWith(href + "/"));
const enlaces = [
  { href: "/", texto: "Inicio" },
  { href: "/programas", texto: "Programas" },
  { href: "/nosotros", texto: "Nosotros" },
  { href: "/blog", texto: "Blog" },
];
const extra = [
  { href: "/empresas", texto: "Empresas" },
  { href: "/comunidad", texto: "Comunidad" },
  { href: "/contacto", texto: "Contacto" },
];
---
<header class="cabecera" data-cabecera>
  <div class="contenedor cabecera__fila">
    <a class="cabecera__logo" href="/" aria-label="Cámara de Comercio Exterior, ir al inicio">
      <img src="/brand/imagotipo-blanco.svg" alt="" width="168" height="110" />
    </a>

    <nav class="nav" aria-label="Principal">
      <ul role="list">
        {enlaces.map((n) => (
          <li><a href={n.href} aria-current={activo(n.href) ? "page" : undefined}>{n.texto}</a></li>
        ))}
      </ul>
    </nav>

    <div class="cabecera__acciones">
      <SelectorPais />
      <a class="boton cabecera__cta" href="/contacto">Matrícula</a>
      <button class="menu-movil__abrir" type="button" aria-expanded="false" aria-controls="menu-movil" data-menu-movil>
        <span class="sr-only">Abrir menú</span>
        <span class="hamburguesa" aria-hidden="true"><span></span><span></span><span></span></span>
      </button>
    </div>
  </div>

  <nav class="menu-movil" id="menu-movil" aria-label="Principal (móvil)" hidden>
    {[...enlaces, ...extra].map((n) => (
      <a href={n.href} aria-current={activo(n.href) ? "page" : undefined}>{n.texto}</a>
    ))}
    <a href="/contacto" class="menu-movil__cta">Matrícula</a>
  </nav>
</header>

<style>
  .cabecera { position: sticky; top: 0; z-index: 50; background: rgba(10, 10, 10, 0.88); -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px); border-bottom: 1px solid var(--line); }
  .cabecera__fila { display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: var(--header-h); }
  /* Imagotipo oficial a 100 px de ancho: el mínimo digital del manual */
  .cabecera__logo { display: block; flex: none; }
  .cabecera__logo img { width: 100px; height: auto; }

  .nav ul { display: flex; gap: 26px; }
  .nav a { display: inline-flex; align-items: center; min-height: 44px; font-size: 0.82rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--mut); text-decoration: none; transition: color 0.2s; }
  .nav a:hover { color: var(--gold2); }
  .nav a[aria-current="page"] { color: var(--gold2); box-shadow: inset 0 -1px 0 var(--gold); }

  .cabecera__acciones { display: flex; align-items: center; gap: 12px; }
  .cabecera__acciones :global(.pais-boton) { border-radius: 0; background: transparent; border: 1px solid var(--line); font-family: var(--sans); font-weight: 500; }
  .cabecera__cta { --alto: 2.75rem; padding-inline: 1.4rem; }

  .menu-movil__abrir { display: none; place-items: center; width: 44px; height: 44px; background: none; border: 1px solid var(--line); color: var(--gold); cursor: pointer; }
  .hamburguesa { display: grid; gap: 5px; width: 18px; }
  .hamburguesa span { height: 1px; background: var(--gold); }
  .menu-movil { border-top: 1px solid var(--line); background: var(--bg2); max-height: calc(100dvh - var(--header-h)); overflow-y: auto; }
  .menu-movil a { display: block; padding: 15px 22px; border-bottom: 1px solid var(--line); font-size: 0.82rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--mut); text-decoration: none; }
  .menu-movil a[aria-current="page"], .menu-movil__cta { color: var(--gold2) !important; }

  @media (max-width: 900px) {
    .nav, .cabecera__cta { display: none; }
    .menu-movil__abrir { display: grid; }
  }
  @media (min-width: 901px) { .menu-movil { display: none !important; } }
</style>

<script>
  const boton = document.querySelector<HTMLButtonElement>("[data-menu-movil]");
  const menu = document.getElementById("menu-movil");
  if (boton && menu) {
    const alternar = (abrir: boolean) => {
      boton.setAttribute("aria-expanded", String(abrir));
      menu.hidden = !abrir;
      boton.querySelector(".sr-only")!.textContent = abrir ? "Cerrar menú" : "Abrir menú";
    };
    boton.addEventListener("click", () => alternar(menu.hidden));
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !menu.hidden) { alternar(false); boton.focus(); }
    });
  }
</script>
