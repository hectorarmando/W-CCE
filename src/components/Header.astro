---
import { navegacion, enlaceWhatsapp } from "../data/sitio";
import { programas } from "../data/programas";

const actual = Astro.url.pathname.replace(/\.html$/, "");
const activo = (href: string) => actual === href || actual.startsWith(href + "/");
---
<header class="cabecera" data-cabecera>
  <div class="contenedor cabecera__fila">
    <a class="cabecera__logo" href="/" aria-label="Cámara de Comercio Exterior, ir al inicio">
      <img src="/brand/imagotipo-negro.svg" alt="" width="168" height="110" />
    </a>

    <nav class="nav" aria-label="Principal">
      <ul role="list" class="nav__lista">
        <li class="nav__item nav__item--menu">
          <button class="nav__enlace nav__boton" type="button" aria-expanded="false" aria-controls="menu-programas" data-desplegable>
            Programas
            <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M2 4.5 6 8.5l4-4" fill="none" stroke="currentColor" stroke-width="1.8" /></svg>
          </button>
          <div class="desplegable" id="menu-programas" hidden>
            <p class="desplegable__titulo">Programas con temario completo</p>
            <ul role="list">
              {programas.map((p) => (
                <li><a href={`/programas/${p.slug}`}>{p.nombre}</a></li>
              ))}
            </ul>
            <a class="desplegable__todo enlace" href="/programas">Ver el catálogo completo</a>
          </div>
        </li>
        {navegacion.filter((n) => n.href !== "/programas").map((n) => (
          <li class="nav__item">
            <a class="nav__enlace" href={n.href} aria-current={activo(n.href) ? "page" : undefined}>{n.texto}</a>
          </li>
        ))}
      </ul>
    </nav>

    <a class="btn btn--negro cabecera__cta" href={enlaceWhatsapp("Hola, quiero información sobre los programas de la Cámara de Comercio Exterior.")} target="_blank" rel="noopener">
      Hablar con un asesor
      <span class="btn__flecha" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 14 14"><path d="M2 7h9M7.5 3 11.5 7l-4 4" fill="none" stroke="currentColor" stroke-width="2"/></svg></span>
    </a>

    <button class="menu-movil__abrir" type="button" aria-expanded="false" aria-controls="menu-movil" data-menu-movil>
      <span class="sr-only">Abrir menú</span>
      <span class="hamburguesa" aria-hidden="true"><span></span><span></span></span>
    </button>
  </div>

  <div class="menu-movil" id="menu-movil" hidden>
    <nav class="contenedor" aria-label="Principal (móvil)">
      <ul role="list" class="menu-movil__lista">
        {navegacion.map((n) => (
          <li><a href={n.href} aria-current={activo(n.href) ? "page" : undefined}>{n.texto}</a></li>
        ))}
      </ul>
      <p class="menu-movil__titulo">Programas con temario completo</p>
      <ul role="list" class="menu-movil__programas">
        {programas.map((p) => (<li><a href={`/programas/${p.slug}`}>{p.nombre}</a></li>))}
      </ul>
      <a class="btn btn--negro menu-movil__cta" href={enlaceWhatsapp("Hola, quiero información sobre los programas de la Cámara de Comercio Exterior.")} target="_blank" rel="noopener">
        Hablar con un asesor por WhatsApp
        <span class="btn__flecha" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 14 14"><path d="M2 7h9M7.5 3 11.5 7l-4 4" fill="none" stroke="currentColor" stroke-width="2"/></svg></span>
      </a>
    </nav>
  </div>
</header>

<style>
  /* Cabecera clara: transparente arriba y con fondo blanco translúcido al desplazarse */
  .cabecera { position: sticky; top: 0; z-index: 50; }
  .cabecera.con-borde { background: rgba(255, 255, 255, 0.86); backdrop-filter: saturate(1.4) blur(14px); -webkit-backdrop-filter: saturate(1.4) blur(14px); box-shadow: 0 1px 0 rgba(0, 0, 0, 0.06); }
  .cabecera__fila { display: flex; align-items: center; gap: var(--s-6); min-height: var(--header-h); }
  /* Imagotipo ≥ 100×65 px (mínimo digital del manual) y con aire alrededor (área de protección) */
  .cabecera__logo { display: block; padding-block: 6px; margin-right: auto; }
  .cabecera__logo img { width: 104px; height: auto; }

  .nav__lista { display: flex; gap: var(--s-2); align-items: center; }
  .nav__item { position: relative; }
  .nav__enlace {
    position: relative; display: inline-flex; align-items: center; gap: 6px; min-height: 2.75rem; padding: 0 0.8rem; border: 0; border-radius: 999px;
    background: none; cursor: pointer; text-decoration: none;
    font-family: var(--font-marca); font-size: var(--t-sm); font-weight: 600; letter-spacing: -0.01em;
    transition: background-color var(--t-accion) var(--ease);
  }
  .nav__enlace:hover, .nav__boton[aria-expanded="true"] { background: var(--bruma); }
  /* Página actual: placa amarilla bajo el texto, como la señal del andén en el que estás */
  .nav__enlace[aria-current="page"]::after { content: ""; position: absolute; left: 0.8rem; right: 0.8rem; bottom: 0.45rem; height: 3px; border-radius: 2px; background: var(--amarillo); }
  .nav__boton svg { transition: transform var(--t-accion) var(--ease); }
  .nav__boton[aria-expanded="true"] svg { transform: rotate(180deg); }

  .desplegable {
    position: absolute; top: calc(100% + 10px); left: 0; width: 23rem;
    background: var(--blanco); border-radius: var(--radio-l);
    padding: var(--s-4); box-shadow: 0 30px 60px -24px rgba(0, 0, 0, 0.3), 0 0 0 1px rgba(0, 0, 0, 0.05);
  }
  .desplegable__titulo { font-size: var(--t-xs); color: var(--gris-oscuro); padding: var(--s-2) var(--s-3) var(--s-3); }
  .desplegable ul { display: grid; gap: 2px; margin-bottom: var(--s-3); }
  .desplegable ul a { display: block; padding: 0.65rem 0.75rem; border-radius: var(--radio); text-decoration: none; font-weight: 600; font-size: var(--t-sm); line-height: 1.3; transition: background-color var(--t-accion) var(--ease); }
  .desplegable ul a:hover { background: var(--amarillo); }
  .desplegable__todo { display: inline-block; margin: 0 var(--s-3) var(--s-2); font-size: var(--t-sm); }

  .cabecera__cta { --alto: 2.75rem; padding-left: 1.15rem; font-size: var(--t-xs); }

  .menu-movil__abrir { display: none; }
  .menu-movil { background: var(--blanco); max-height: calc(100dvh - var(--header-h)); overflow-y: auto; }
  .menu-movil nav { padding-block: var(--s-4) var(--s-7); }
  .menu-movil__lista a { display: block; padding: 0.6rem 0; font-family: var(--font-marca); font-size: 2rem; font-weight: 800; letter-spacing: -0.04em; text-decoration: none; }
  .menu-movil__lista a[aria-current="page"] { text-decoration: underline; text-decoration-color: var(--amarillo); text-decoration-thickness: 5px; text-underline-offset: 6px; }
  .menu-movil__titulo { margin-top: var(--s-6); font-size: var(--t-xs); color: var(--gris-oscuro); }
  .menu-movil__programas a { display: block; padding: 0.55rem 0; font-weight: 600; text-decoration: none; }
  .menu-movil__cta { margin-top: var(--s-5); width: 100%; }

  @media (max-width: 1000px) {
    .nav, .cabecera__cta { display: none; }
    .menu-movil__abrir {
      display: grid; place-items: center; width: 48px; height: 48px; margin-right: -4px;
      background: var(--bruma); border: 0; cursor: pointer; border-radius: 50%;
    }
    .hamburguesa { display: grid; gap: 6px; width: 20px; }
    .hamburguesa span { height: 2px; background: var(--negro); border-radius: 2px; transition: transform var(--t-accion) var(--ease); }
    [aria-expanded="true"] .hamburguesa span:first-child { transform: translateY(4px) rotate(45deg); }
    [aria-expanded="true"] .hamburguesa span:last-child { transform: translateY(-4px) rotate(-45deg); }
  }
  @media (min-width: 1001px) { .menu-movil { display: none !important; } }
</style>

<script>
  const cabecera = document.querySelector<HTMLElement>("[data-cabecera]");
  const botonDesplegable = document.querySelector<HTMLButtonElement>("[data-desplegable]");
  const desplegable = document.getElementById("menu-programas");
  const botonMovil = document.querySelector<HTMLButtonElement>("[data-menu-movil]");
  const menuMovil = document.getElementById("menu-movil");

  const alternar = (boton: HTMLButtonElement, panel: HTMLElement, abrir?: boolean) => {
    const abierto = abrir ?? boton.getAttribute("aria-expanded") !== "true";
    boton.setAttribute("aria-expanded", String(abierto));
    panel.hidden = !abierto;
    return abierto;
  };

  if (botonDesplegable && desplegable) {
    botonDesplegable.addEventListener("click", () => alternar(botonDesplegable, desplegable));
    document.addEventListener("click", (e) => {
      if (!desplegable.hidden && !botonDesplegable.parentElement?.contains(e.target as Node)) alternar(botonDesplegable, desplegable, false);
    });
    botonDesplegable.parentElement?.addEventListener("focusout", (e) => {
      if (!botonDesplegable.parentElement?.contains(e.relatedTarget as Node)) alternar(botonDesplegable, desplegable, false);
    });
  }

  if (botonMovil && menuMovil) {
    botonMovil.addEventListener("click", () => {
      const abierto = alternar(botonMovil, menuMovil);
      botonMovil.querySelector(".sr-only")!.textContent = abierto ? "Cerrar menú" : "Abrir menú";
      document.body.style.overflow = abierto ? "hidden" : "";
    });
  }

  document.addEventListener("keydown", (e) => {
    if (e.key !== "Escape") return;
    if (botonDesplegable && desplegable && !desplegable.hidden) { alternar(botonDesplegable, desplegable, false); botonDesplegable.focus(); }
    if (botonMovil && menuMovil && !menuMovil.hidden) { botonMovil.click(); botonMovil.focus(); }
  });

  const marcarBorde = () => cabecera?.classList.toggle("con-borde", window.scrollY > 8);
  marcarBorde();
  window.addEventListener("scroll", marcarBorde, { passive: true });
</script>
