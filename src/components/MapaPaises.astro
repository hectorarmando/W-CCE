---
// Mapa de América con los países donde atiende la CE. Se dibuja al compilar (SVG estático) con datos de Natural Earth
// (paquete world-atlas, dominio público) y proyección de d3-geo. Cada país atendido se puede elegir (clic, toque o
// teclado) y el botón «Usar mi ubicación» lo elige con la geolocalización del navegador (scripts/precios.ts):
// cambia los precios a la moneda local y el mensaje de WhatsApp.
import { geoMercator, geoPath } from "d3-geo";
import { feature } from "topojson-client";
import type { Topology, GeometryCollection } from "topojson-specification";
import mundo from "world-atlas/countries-110m.json";
import { paises } from "../data/paises";
import { ISO_PAISES as ISO } from "../data/contornos";

const atendidos = paises.filter((p) => ISO[p.codigo]);

const topo = mundo as unknown as Topology<{ countries: GeometryCollection<{ name: string }> }>;
const todos = feature(topo, topo.objects.countries).features;
const marcados = todos.filter((f) => Object.values(ISO).includes(String(f.id)));

// Encuadre: de México a la Patagonia
const ancho = 520, alto = 760;
const proyeccion = geoMercator().fitExtent([[10, 10], [ancho - 10, alto - 10]], { type: "FeatureCollection", features: marcados });
const trazo = geoPath(proyeccion).digits(1);
const visibles = todos.filter((f) => {
  const [[a, b], [c, d]] = trazo.bounds(f);
  return c > 0 && a < ancho && d > 0 && b < alto;
});
const paisPorIso = Object.fromEntries(atendidos.map((p) => [ISO[p.codigo], p]));
---
<figure class="mapa">
  <svg viewBox={`0 0 ${ancho} ${alto}`} aria-labelledby="mapa-titulo" role="group">
    <title id="mapa-titulo">Mapa de América con los países donde atiende la Cámara de Comercio Exterior: {atendidos.map((p) => p.nombre).join(", ")}</title>
    {visibles.filter((f) => !paisPorIso[String(f.id)]).map((f) => <path d={trazo(f) ?? ""} class="mapa__pais" />)}
    {visibles.filter((f) => paisPorIso[String(f.id)]).map((f) => {
      const p = paisPorIso[String(f.id)];
      return (
        <path d={trazo(f) ?? ""} class="mapa__pais mapa__pais--activo" data-elegir-pais={p.codigo} role="button" tabindex="0" aria-pressed="false" aria-label={`Elegir ${p.nombre} (${p.moneda})`}>
          <title>{p.nombre}</title>
        </path>
      );
    })}
  </svg>
  <figcaption class="mapa__leyenda">
    <ul role="list">
      {atendidos.map((p) => (
        <li><button type="button" data-elegir-pais={p.codigo} aria-pressed="false"><i aria-hidden="true"></i>{p.nombre} <span>{p.moneda}</span></button></li>
      ))}
    </ul>
  </figcaption>
</figure>

<style>
  .mapa { margin: 0; display: grid; gap: var(--s-4); }
  .mapa svg { width: 100%; height: auto; max-height: 36rem; }
  .mapa__pais { fill: #242424; stroke: var(--negro); stroke-width: 0.6; }
  .mapa__pais--activo { fill: color-mix(in srgb, var(--amarillo) 55%, #1a1a1a); stroke: var(--negro); stroke-width: 0.8; cursor: pointer; transition: fill var(--t-accion) var(--ease); }
  .mapa__pais--activo:hover, .mapa__pais--activo:focus-visible { fill: var(--amarillo); outline: none; }
  .mapa__pais--activo.elegido { fill: var(--amarillo-60); stroke: var(--blanco); stroke-width: 1.4; }
  .mapa__leyenda ul { display: flex; flex-wrap: wrap; gap: var(--s-2); }
  .mapa__leyenda button {
    display: inline-flex; align-items: center; gap: 0.45rem; min-height: 2.75rem; padding: 0 0.9rem; border: 1px solid var(--linea); border-radius: 999px; cursor: pointer;
    background: var(--tarjeta); color: var(--blanco); font-family: var(--font-marca); font-size: var(--t-sm); font-weight: 600;
    transition: border-color var(--t-accion) var(--ease), background-color var(--t-accion) var(--ease);
  }
  .mapa__leyenda button:hover { border-color: var(--amarillo); }
  .mapa__leyenda button.elegido { background: var(--amarillo); border-color: var(--amarillo); color: var(--negro); }
  .mapa__leyenda i { width: 0.65rem; height: 0.65rem; border-radius: 50%; background: var(--amarillo); }
  .mapa__leyenda button.elegido i { background: var(--negro); }
  .mapa__leyenda span { font-size: var(--t-xs); color: var(--gris-oscuro); font-weight: 500; }
  .mapa__leyenda button.elegido span { color: var(--negro); }
</style>
