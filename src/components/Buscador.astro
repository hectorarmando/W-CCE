---
// Buscador de programas y cursos (patrón combobox accesible). Los datos viajan una sola vez por página
// en <script id="indice-busqueda"> (Header.astro); cada buscador lo lee al escribir.
interface Props { id: string; variante?: "cabecera" | "portada"; }
const { id, variante = "cabecera" } = Astro.props;
---
<div class:list={["buscador", `buscador--${variante}`]} data-buscador>
  <label class="sr-only" for={id}>Buscar programas y cursos</label>
  <svg class="buscador__icono" width="18" height="18" viewBox="0 0 20 20" aria-hidden="true"><circle cx="8.5" cy="8.5" r="6" fill="none" stroke="currentColor" stroke-width="2" /><path d="m13 13 5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
  <input
    id={id}
    type="search"
    role="combobox"
    aria-expanded="false"
    aria-controls={`${id}-lista`}
    aria-autocomplete="list"
    autocomplete="off"
    spellcheck="false"
    placeholder="¿Qué quieres aprender?"
  />
  <ul class="buscador__lista" id={`${id}-lista`} role="listbox" aria-label="Resultados" hidden></ul>
</div>

<style>
  .buscador { position: relative; display: flex; align-items: center; width: 100%; }
  .buscador__icono { position: absolute; left: 1rem; color: var(--gris-claro); pointer-events: none; }
  .buscador input {
    width: 100%; min-height: 2.75rem; padding: 0 1rem 0 2.75rem; border-radius: 999px;
    border: 1.5px solid rgba(255, 255, 255, 0.16); background: rgba(255, 255, 255, 0.06); color: var(--blanco);
    font-size: var(--t-sm); transition: border-color var(--t-accion) var(--ease), background-color var(--t-accion) var(--ease);
  }
  .buscador input::placeholder { color: #a6a6a6; }
  .buscador input:hover { border-color: rgba(255, 255, 255, 0.32); }
  .buscador input:focus { outline: none; border-color: var(--amarillo); background: rgba(255, 255, 255, 0.1); }
  .buscador input::-webkit-search-cancel-button { filter: invert(1); }
  .buscador--portada input { min-height: 3.75rem; padding-left: 3.25rem; font-size: var(--t-lg); background: var(--blanco); color: var(--negro); border-color: transparent; }
  .buscador--portada input::placeholder { color: var(--gris-oscuro); }
  .buscador--portada input:focus { background: var(--blanco); box-shadow: 0 0 0 4px rgba(201, 162, 75, 0.45); }
  .buscador--portada .buscador__icono { left: 1.25rem; color: var(--negro); }
  .buscador--portada input::-webkit-search-cancel-button { filter: none; }

  .buscador__lista {
    position: absolute; top: calc(100% + 8px); left: 0; right: 0; z-index: 60; margin: 0; padding: 0.4rem; list-style: none;
    background: var(--blanco); color: var(--negro); border-radius: var(--radio-l);
    box-shadow: 0 30px 60px -24px rgba(0, 0, 0, 0.6), 0 0 0 1px rgba(0, 0, 0, 0.06);
    max-height: min(26rem, 70vh); overflow-y: auto;
  }
  .buscador__lista :global(li) { display: grid; gap: 2px; padding: 0.65rem 0.85rem; border-radius: var(--radio); cursor: pointer; }
  .buscador__lista :global(li[aria-selected="true"]), .buscador__lista :global(li:hover) { background: var(--amarillo); }
  .buscador__lista :global(.r-nombre) { font-weight: 700; font-size: var(--t-sm); line-height: 1.3; }
  .buscador__lista :global(.r-dato) { font-size: var(--t-xs); color: var(--gris-oscuro); }
  .buscador__lista :global(li[aria-selected="true"] .r-dato), .buscador__lista :global(li:hover .r-dato) { color: var(--negro); }
</style>

<script>
  type Item = { n: string; a: string; h: string; e: boolean; p: boolean };
  const normalizar = (t: string) => t.normalize("NFD").replace(/[̀-ͯ]/g, "").toLowerCase().trim();
  // Cada elemento se indexa como lista de palabras; «inteligencia artificial» también responde a «ia»
  let indice: (Item & { w: string[] })[] | null = null;
  const leerIndice = () => {
    if (indice) return indice;
    const datos = document.getElementById("indice-busqueda")?.textContent ?? "[]";
    indice = (JSON.parse(datos) as Item[]).map((i) => {
      const texto = normalizar(`${i.n} ${i.a}`);
      const w = texto.split(/[^a-z0-9]+/).filter(Boolean);
      if (texto.includes("inteligencia artificial")) w.push("ia");
      return { ...i, w };
    });
    return indice;
  };
  // Si no hay coincidencias, la única opción lleva a un asesor (el enlace viene del índice, con el número oficial)
  const SIN_RESULTADOS: Item = { n: "No lo encontramos: pregúntale a un asesor", a: "Te respondemos por WhatsApp", h: document.getElementById("indice-busqueda")?.dataset.whatsapp ?? "/contacto", e: true, p: false };

  document.querySelectorAll<HTMLElement>("[data-buscador]").forEach((caja) => {
    const input = caja.querySelector("input")!;
    const lista = caja.querySelector("ul")!;
    let resultados: Item[] = [];
    let activo = -1;

    const abrir = (si: boolean) => { lista.hidden = !si; input.setAttribute("aria-expanded", String(si)); if (!si) { activo = -1; input.removeAttribute("aria-activedescendant"); } };
    const marcar = (i: number) => {
      activo = i;
      lista.querySelectorAll("li").forEach((li, k) => li.setAttribute("aria-selected", String(k === i)));
      if (i >= 0) { input.setAttribute("aria-activedescendant", `${lista.id}-${i}`); lista.children[i]?.scrollIntoView({ block: "nearest" }); }
    };
    const ir = (r: Item) => {
      if (r.e) { const w = window.open(r.h, "_blank", "noopener"); if (w) w.opener = null; }
      else location.href = r.h;
      abrir(false);
    };
    const pintar = () => {
      const q = normalizar(input.value);
      if (!q) { abrir(false); return; }
      // Coincide si cada palabra buscada es el comienzo de alguna palabra del curso («exc» → Excel)
      const palabras = q.split(/[^a-z0-9]+/).filter(Boolean);
      resultados = leerIndice().filter((i) => palabras.every((p) => i.w.some((w) => w.startsWith(p))))
        .sort((x, y) => Number(y.p) - Number(x.p)).slice(0, 7);
      if (!resultados.length) resultados = [SIN_RESULTADOS];
      lista.replaceChildren(...resultados.map((r, k) => {
        const li = document.createElement("li");
        li.id = `${lista.id}-${k}`;
        li.setAttribute("role", "option");
        li.setAttribute("aria-selected", "false");
        const nombre = document.createElement("span"); nombre.className = "r-nombre"; nombre.textContent = r.n;
        const dato = document.createElement("span"); dato.className = "r-dato";
        dato.textContent = r === SIN_RESULTADOS ? r.a : `${r.a} · ${r.p ? "Programa con temario completo" : "Curso: consulta por WhatsApp"}`;
        li.append(nombre, dato);
        li.addEventListener("mousedown", (ev) => { ev.preventDefault(); ir(r); });
        return li;
      }));
      abrir(true);
      marcar(-1);
    };

    input.addEventListener("input", pintar);
    input.addEventListener("focus", () => { if (input.value) pintar(); });
    input.addEventListener("blur", () => setTimeout(() => abrir(false), 120));
    input.addEventListener("keydown", (ev) => {
      if (ev.key === "ArrowDown") { ev.preventDefault(); if (lista.hidden) pintar(); marcar(Math.min(activo + 1, resultados.length - 1)); }
      else if (ev.key === "ArrowUp") { ev.preventDefault(); marcar(Math.max(activo - 1, 0)); }
      else if (ev.key === "Enter") { if (!lista.hidden && resultados.length) { ev.preventDefault(); ir(resultados[Math.max(activo, 0)]); } }
      else if (ev.key === "Escape") { if (!lista.hidden) { ev.stopPropagation(); abrir(false); } }
    });
  });
</script>
