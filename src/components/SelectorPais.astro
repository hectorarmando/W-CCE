---
// Selector de país de ubicación: botón en la cabecera (bandera + moneda) y panel con las banderas.
// La detección y el cambio de precios los hace src/scripts/precios.ts.
import { paises } from "../data/paises";
import { precios } from "../data/precios";
const visibles = paises.filter((p) => p.codigo !== "OT");
---
<!-- Países y precios para el navegador (una vez por página) -->
<script type="application/json" id="datos-precios" set:html={JSON.stringify({ paises, precios })} />

<!-- Banderas simplificadas (sin escudos), recortadas en círculo; se reutilizan con <use> -->
<svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
  <defs>
    <clipPath id="bandera-circulo"><circle cx="20" cy="20" r="20" /></clipPath>
    <radialGradient id="bandera-brillo" cx="35%" cy="25%" r="70%"><stop offset="0" stop-color="#fff" stop-opacity=".55" /><stop offset=".45" stop-color="#fff" stop-opacity="0" /><stop offset="1" stop-color="#000" stop-opacity=".25" /></radialGradient>
    <symbol id="bandera-PE" viewBox="0 0 40 40"><g clip-path="url(#bandera-circulo)"><rect width="40" height="40" fill="#fff" /><rect width="13.4" height="40" fill="#d91023" /><rect x="26.6" width="13.4" height="40" fill="#d91023" /></g></symbol>
    <symbol id="bandera-EC" viewBox="0 0 40 40"><g clip-path="url(#bandera-circulo)"><rect width="40" height="20" fill="#ffd100" /><rect y="20" width="40" height="10" fill="#034ea2" /><rect y="30" width="40" height="10" fill="#ef3340" /><ellipse cx="20" cy="20" rx="4.5" ry="5.5" fill="#8b5a2b" stroke="#ffd100" stroke-width="1" /></g></symbol>
    <symbol id="bandera-CR" viewBox="0 0 40 40"><g clip-path="url(#bandera-circulo)"><rect width="40" height="40" fill="#002b7f" /><rect y="6.7" width="40" height="26.6" fill="#fff" /><rect y="13.3" width="40" height="13.4" fill="#ce1126" /></g></symbol>
    <symbol id="bandera-CO" viewBox="0 0 40 40"><g clip-path="url(#bandera-circulo)"><rect width="40" height="20" fill="#fcd116" /><rect y="20" width="40" height="10" fill="#003893" /><rect y="30" width="40" height="10" fill="#ce1126" /></g></symbol>
    <symbol id="bandera-MX" viewBox="0 0 40 40"><g clip-path="url(#bandera-circulo)"><rect width="40" height="40" fill="#fff" /><rect width="13.4" height="40" fill="#006847" /><rect x="26.6" width="13.4" height="40" fill="#ce1126" /><circle cx="20" cy="20" r="3.6" fill="#8b5a2b" /></g></symbol>
    <symbol id="bandera-PA" viewBox="0 0 40 40"><g clip-path="url(#bandera-circulo)"><rect width="40" height="40" fill="#fff" /><rect x="20" width="20" height="20" fill="#d21034" /><rect y="20" width="20" height="20" fill="#005293" /><path d="m10 5.5 1.3 4h4.2l-3.4 2.5 1.3 4-3.4-2.5-3.4 2.5 1.3-4-3.4-2.5h4.2z" fill="#005293" /><path d="m30 24.5 1.3 4h4.2l-3.4 2.5 1.3 4-3.4-2.5-3.4 2.5 1.3-4-3.4-2.5h4.2z" fill="#d21034" /></g></symbol>
    <symbol id="bandera-AR" viewBox="0 0 40 40"><g clip-path="url(#bandera-circulo)"><rect width="40" height="40" fill="#74acdf" /><rect y="13.3" width="40" height="13.4" fill="#fff" /><circle cx="20" cy="20" r="3.4" fill="#f6b40e" stroke="#85340a" stroke-width=".6" /></g></symbol>
    <symbol id="bandera-OT" viewBox="0 0 40 40"><g clip-path="url(#bandera-circulo)"><rect width="40" height="40" fill="#1f3a5f" /><circle cx="20" cy="20" r="11" fill="none" stroke="#fff" stroke-width="2" /><path d="M9 20h22M20 9c3.5 3 5 7 5 11s-1.5 8-5 11c-3.5-3-5-7-5-11s1.5-8 5-11Z" fill="none" stroke="#fff" stroke-width="2" /></g></symbol>
  </defs>
</svg>

<button class="pais-boton" type="button" data-pais-boton aria-haspopup="dialog" aria-label="USD, Otro país: cambiar país de tu ubicación">
  <svg class="pais-boton__bandera" width="22" height="22" aria-hidden="true"><use href="#bandera-OT" width="22" height="22" data-pais-bandera /><circle cx="11" cy="11" r="11" fill="url(#bandera-brillo)" /></svg>
  <span class="pais-boton__moneda" data-pais-moneda>USD</span>
</button>

<dialog class="pais-panel sobre-oscuro" data-pais-panel aria-labelledby="pais-panel-titulo">
  <form method="dialog" class="pais-panel__cerrar-form">
    <button class="pais-panel__cerrar" value="cerrar" aria-label="Cerrar"><svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 3l10 10M13 3 3 13" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg></button>
  </form>
  <p class="pais-panel__titulo" id="pais-panel-titulo">Selecciona el país de tu ubicación:</p>
  <ul role="list" class="pais-panel__lista">
    {visibles.map((p) => (
      <li>
        <button type="button" class="pais-opcion" data-pais={p.codigo} aria-pressed="false">
          <svg class="pais-opcion__bandera" viewBox="0 0 40 40" aria-hidden="true"><use href={`#bandera-${p.codigo}`} /><circle cx="20" cy="20" r="20" fill="url(#bandera-brillo)" /></svg>
          <span>{p.nombre}</span>
        </button>
      </li>
    ))}
  </ul>
  <button type="button" class="pais-panel__otro" data-pais="OT" aria-pressed="false">Estoy en otro país (precios en US$)</button>
  <p class="pais-panel__nota">Mostramos los precios en la moneda de tu país. Puedes cambiarlo cuando quieras.</p>
</dialog>

<style>
  .pais-boton {
    display: inline-flex; align-items: center; gap: 0.45rem; flex: none; min-height: 2.75rem; padding: 0 0.75rem 0 0.55rem; border: 0; border-radius: 999px; cursor: pointer;
    background: rgba(255, 255, 255, 0.08); color: var(--blanco); font-family: var(--font-marca); font-size: var(--t-xs); font-weight: 700;
    transition: background-color var(--t-accion) var(--ease);
  }
  .pais-boton:hover { background: rgba(255, 255, 255, 0.16); }
  .pais-boton__bandera { border-radius: 50%; }

  .pais-panel {
    width: min(58rem, calc(100vw - 2rem)); max-height: calc(100dvh - 2rem); padding: var(--s-7) var(--s-6) var(--s-6); border: 0; border-radius: var(--radio-l);
    background: var(--negro); color: var(--blanco); box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.12), 0 40px 80px -20px rgba(0, 0, 0, 0.8); text-align: center;
  }
  .pais-panel::backdrop { background: rgba(0, 0, 0, 0.6); backdrop-filter: blur(4px); }
  .pais-panel__cerrar-form { position: absolute; top: var(--s-3); right: var(--s-3); margin: 0; }
  .pais-panel__cerrar { display: grid; place-items: center; width: 2.75rem; height: 2.75rem; border: 0; border-radius: 50%; background: rgba(255, 255, 255, 0.08); color: var(--blanco); cursor: pointer; }
  .pais-panel__titulo { font-family: var(--font-marca); font-weight: 700; font-size: var(--t-lg); color: #d9d9d9; }
  .pais-panel__lista { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--s-3); margin: var(--s-7) 0 var(--s-6); }
  .pais-opcion {
    display: grid; justify-items: center; gap: var(--s-3); min-width: 6rem; padding: var(--s-3); border: 0; border-radius: var(--radio-l); cursor: pointer;
    background: transparent; color: #d9d9d9; font-family: var(--font-marca); font-weight: 700; font-size: var(--t-sm);
    transition: background-color var(--t-accion) var(--ease), color var(--t-accion) var(--ease);
  }
  .pais-opcion__bandera { width: 3.25rem; height: 3.25rem; border-radius: 50%; box-shadow: 0 6px 14px -4px rgba(0, 0, 0, 0.6); transition: transform var(--t-accion) var(--ease); }
  .pais-opcion:hover { background: rgba(255, 255, 255, 0.06); color: var(--blanco); }
  .pais-opcion:hover .pais-opcion__bandera { transform: scale(1.08); }
  .pais-opcion[aria-pressed="true"] { background: rgba(201, 162, 75, 0.14); color: var(--amarillo); box-shadow: inset 0 0 0 2px var(--amarillo); }
  .pais-panel__otro { min-height: 2.75rem; padding: 0 1.1rem; border-radius: 999px; border: 1.5px solid rgba(255, 255, 255, 0.25); background: transparent; color: var(--blanco); font-weight: 600; font-size: var(--t-sm); cursor: pointer; }
  .pais-panel__otro[aria-pressed="true"] { border-color: var(--amarillo); color: var(--amarillo); }
  .pais-panel__nota { margin-top: var(--s-4); font-size: var(--t-xs); color: #a6a6a6; }
  @media (max-width: 560px) {
    .pais-panel { padding-inline: var(--s-4); }
    .pais-opcion { min-width: 5.5rem; }
  }
</style>
