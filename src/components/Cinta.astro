---
// Cinta amarilla en movimiento con frases oficiales de la CE (banners, cinta de inauguración y bolsas).
// Se pausa al pasar el mouse y queda quieta con prefers-reduced-motion.
const frases = [
  "Aprende, certifícate y avanza",
  "Conectamos talento, impulsamos desarrollo",
  "Educación continua",
  "El éxito lo logramos juntos",
];
---
<div class="cinta" role="region" aria-label="Lemas de la Cámara de Comercio Exterior">
  <div class="cinta__pista">
    {[0, 1].map((copia) => (
      <ul role="list" class="cinta__grupo" aria-hidden={copia === 1 ? "true" : undefined}>
        {frases.map((f) => (<li>{f}<span class="cinta__sep" aria-hidden="true"></span></li>))}
      </ul>
    ))}
  </div>
</div>

<style>
  .cinta { overflow: hidden; background: var(--amarillo); color: var(--negro); border-block: 2px solid var(--negro); }
  .cinta__pista { display: flex; width: max-content; }
  .cinta__grupo { display: flex; flex: none; }
  .cinta li {
    display: flex; align-items: center; gap: clamp(1.25rem, 1rem + 1.5vw, 2.5rem);
    padding: clamp(0.9rem, 0.7rem + 0.6vw, 1.25rem) 0 clamp(0.9rem, 0.7rem + 0.6vw, 1.25rem) clamp(1.25rem, 1rem + 1.5vw, 2.5rem);
    font-size: clamp(1.15rem, 0.9rem + 1.2vw, 2rem); font-weight: 900; letter-spacing: -0.02em; white-space: nowrap;
  }
  /* Separador: pequeño arco negro, eco de la "C" del isologo */
  .cinta__sep { width: 0.9em; height: 0.9em; border-radius: 50%; border: 0.18em solid var(--negro); border-right-color: transparent; transform: rotate(0deg); }
  @media (prefers-reduced-motion: no-preference) {
    .cinta__pista { animation: desplazar 38s linear infinite; }
    .cinta:hover .cinta__pista { animation-play-state: paused; }
    @keyframes desplazar { to { transform: translateX(-50%); } }
  }
</style>
