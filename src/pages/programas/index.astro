---
// Catálogo con la estructura del prototipo HTML del usuario: encabezado con buscador y filtro por área,
// y tarjetas con área, nombre, datos y acción. Los datos salen de src/data/oferta.ts (material oficial).
import Base from "../../layouts/Base.astro";
import { areas, areaPorId } from "../../data/programas";
import { oferta } from "../../data/oferta";
import { enlaceWhatsapp } from "../../data/sitio";
import { Picture } from "astro:assets";
import Precio from "../../components/Precio.astro";

const normalizar = (t: string) => t.normalize("NFD").replace(/[̀-ͯ]/g, "").toLowerCase();
---
<Base titulo="Programas y cursos" descripcion="Catálogo de programas y cursos de la Cámara de Comercio Exterior: comercio exterior, Excel, Power BI, inteligencia artificial, marketing, diseño, ingeniería e idiomas.">
  <div class="phead">
    <div class="contenedor">
      <nav class="migas-d" aria-label="Ruta de navegación"><a href="/">Inicio</a> / Programas</nav>
      <span class="eyebrow">Programas</span>
      <h1>Encuentra el programa que <span class="dorado">impulsa tu carrera</span></h1>
      <p>Busca por tema o área. Los programas con temario completo tienen su ficha; para el resto, un asesor te comparte el temario, los horarios y la inversión vigente.</p>
      <form class="buscar" role="search" data-buscar onsubmit="return false">
        <label class="sr-only" for="q">Buscar un programa</label>
        <input id="q" type="search" placeholder="Busca un programa (ej. datos, Excel, inglés)" autocomplete="off" />
        <label class="sr-only" for="sa">Área</label>
        <select id="sa">
          <option value="">Todas las áreas</option>
          {areas.map((a) => <option value={a.id}>{a.nombre}</option>)}
        </select>
      </form>
    </div>
  </div>

  <section class="seccion-d" aria-label="Catálogo">
    <div class="contenedor">
      <p class="resultados" aria-live="polite" data-estado>{oferta.length} programas y cursos</p>
      <ul role="list" class="catalogo" data-lista>
        {oferta.map((it, n) => (
          <li data-area={it.area} data-texto={normalizar(`${it.nombre} ${areaPorId[it.area].nombre} ${it.resumen}`)}>
            <a class="cur" href={it.href} {...(it.externo ? { target: "_blank", rel: "noopener" } : {})}>
              {it.imagen && (
                <span class="cur__portada"><Picture src={it.imagen} formats={["avif", "webp"]} widths={[400, 640]} sizes="(max-width: 640px) 100vw, 360px" loading={n < 3 ? "eager" : "lazy"} alt="" /></span>
              )}
              <span class="cur__tg">{areaPorId[it.area].nombre}</span>
              <span class="cur__nombre">{it.nombre}</span>
              <span class="cur__fx"><span>{it.meta}</span>{it.programa && <span>Certificado</span>}</span>
              <Precio id={it.id} class="cur__precio" respaldo="Inversión: consulta con un asesor" />
              <span class="cur__go">{it.programa ? "Ver programa y temario" : "Consultar por WhatsApp"}{it.externo && <span class="sr-only"> (se abre en una pestaña nueva)</span>}</span>
            </a>
          </li>
        ))}
      </ul>
      <p class="vacio" hidden data-vacio>No encontramos programas con esa búsqueda. Prueba con otro término o <a class="enlace" href={enlaceWhatsapp("Hola, busco un curso que no encuentro en el catálogo.")} target="_blank" rel="noopener">habla con un asesor</a>.</p>
    </div>
  </section>
</Base>

<style>
  .buscar { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 2rem; }
  .buscar input, .buscar select { flex: 1; min-width: 200px; min-height: 48px; padding: 14px 16px; border: 1px solid var(--line); border-radius: 0; background: var(--bg2); color: var(--ink); font: 300 0.95rem var(--sans); }
  .buscar input::placeholder { color: var(--mut); }
  .buscar input:focus, .buscar select:focus { outline: 1px solid var(--gold); }
  .resultados { margin-bottom: 1rem; font-size: 0.78rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--mut); }
  .catalogo { display: grid; grid-template-columns: repeat(auto-fill, minmax(290px, 1fr)); gap: 20px; }
  .catalogo li[hidden] { display: none; }
  .cur { display: flex; flex-direction: column; gap: 10px; height: 100%; padding: 26px 24px; background: var(--card); border: 1px solid var(--line); text-decoration: none; transition: border-color 0.3s, transform 0.3s; }
  .cur:hover { border-color: var(--gold); transform: translateY(-3px); }
  .cur__portada { display: block; margin: -26px -24px 8px; aspect-ratio: 16 / 9; border-bottom: 1px solid var(--line); overflow: hidden; }
  .cur__portada :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .cur__tg { font: 500 0.68rem var(--sans); letter-spacing: 0.22em; text-transform: uppercase; color: var(--gold); }
  .cur__nombre { font: 600 1.45rem/1.15 var(--serif); }
  .cur__fx { display: flex; gap: 14px; flex-wrap: wrap; font-size: 0.8rem; color: var(--mut); }
  .cur :global(.cur__precio) { font-size: 0.85rem; color: var(--mut); }
  .cur :global(.cur__precio.precio--con) { font: 600 1.4rem var(--serif); color: var(--gold2); }
  .cur__go { margin-top: auto; padding-top: 6px; font: 500 0.74rem var(--sans); letter-spacing: 0.16em; text-transform: uppercase; color: var(--gold); }
  .vacio { margin-top: 2rem; color: var(--mut); }
</style>

<script>
  const q = document.querySelector<HTMLInputElement>("#q");
  const sa = document.querySelector<HTMLSelectElement>("#sa");
  const filas = document.querySelectorAll<HTMLElement>("[data-lista] > li");
  const vacio = document.querySelector<HTMLElement>("[data-vacio]");
  const estado = document.querySelector<HTMLElement>("[data-estado]");
  const normalizar = (t: string) => t.normalize("NFD").replace(/[̀-ͯ]/g, "").toLowerCase().trim();

  function filtrar(actualizarUrl = true) {
    const texto = normalizar(q?.value ?? "");
    const area = sa?.value ?? "";
    let visibles = 0;
    filas.forEach((f) => {
      const mostrar = (!area || f.dataset.area === area) && (!texto || (f.dataset.texto ?? "").includes(texto));
      f.hidden = !mostrar;
      if (mostrar) visibles++;
    });
    if (vacio) vacio.hidden = visibles > 0;
    if (estado) estado.textContent = `${visibles} ${visibles === 1 ? "resultado" : "resultados"}`;
    if (actualizarUrl) {
      const url = new URL(location.href);
      if (area) url.searchParams.set("area", area); else url.searchParams.delete("area");
      try { history.replaceState(null, "", url); } catch { /* documentos sin URL propia */ }
    }
  }

  const inicial = new URLSearchParams(location.search).get("area");
  if (sa && inicial && [...sa.options].some((o) => o.value === inicial)) sa.value = inicial;
  q?.addEventListener("input", () => filtrar());
  sa?.addEventListener("change", () => filtrar());
  filtrar(false);
</script>
