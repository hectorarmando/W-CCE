---
import Base from "../../layouts/Base.astro";
import { areas, areaPorId } from "../../data/programas";
import { oferta } from "../../data/oferta";
import { enlaceWhatsapp } from "../../data/sitio";
import { Picture } from "astro:assets";
import Precio from "../../components/Precio.astro";

const items = oferta;
---
<Base titulo="Programas y cursos" descripcion="Catálogo de programas y cursos de la Cámara de Comercio Exterior: comercio exterior, Excel, Power BI, inteligencia artificial, marketing, diseño, ingeniería e idiomas.">
  <section class="encabezado-pagina">
    <div class="contenedor">
      <h1 class="titulo-pagina">Programas y cursos</h1>
      <p class="intro">Los programas con temario completo tienen su propia página. Para el resto del catálogo, un asesor te comparte el temario, los horarios y la inversión vigente.</p>
    </div>
  </section>

  <section class="seccion catalogo" aria-label="Catálogo">
    <div class="contenedor">
      <div class="filtros" role="group" aria-label="Filtrar por área" data-filtros>
        <button type="button" aria-pressed="true" data-area="todas">Todas <span>{items.length}</span></button>
        {areas.map((a) => (
          <button type="button" aria-pressed="false" data-area={a.id} style={`--c:${a.color}`}>
            <i aria-hidden="true"></i>{a.nombre} <span>{items.filter((i) => i.area === a.id).length}</span>
          </button>
        ))}
      </div>
      <p class="sr-only" aria-live="polite" data-estado></p>

      <ul role="list" class="lista" data-lista>
        {items.map((it, n) => (
          <li data-area={it.area} style={`--c:${it.color}`}>
            <a class="tarjeta" href={it.href} {...(it.externo ? { target: "_blank", rel: "noopener" } : {})}>
              <span class="tarjeta__portada">
                {it.imagen
                  ? <Picture src={it.imagen} formats={["avif", "webp"]} widths={[400, 640, 960]} sizes="(max-width: 640px) 100vw, (max-width: 1100px) 50vw, 420px" loading={n < 3 ? "eager" : "lazy"} alt="" />
                  : <span class="tarjeta__sin" aria-hidden="true">{it.nombre}</span>}
              </span>
              <span class="tarjeta__cuerpo">
                <span class="tarjeta__area"><i aria-hidden="true"></i>{areaPorId[it.area].nombre}</span>
                <span class="tarjeta__nombre">{it.nombre}</span>
                <span class="tarjeta__resumen">{it.resumen}</span>
                <span class="tarjeta__meta">{it.programa ? it.meta : "Consulta temario y horarios"}</span>
                <Precio id={it.id} class="tarjeta__precio" respaldo="Inversión: consulta con un asesor" />
                <span class="tarjeta__accion">{it.accion}{it.externo && <span class="sr-only"> por WhatsApp (se abre en una pestaña nueva)</span>}<span class="tarjeta__flecha" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 14 14"><path d="M2 7h9M7.5 3 11.5 7l-4 4" fill="none" stroke="currentColor" stroke-width="2" /></svg></span></span>
              </span>
            </a>
          </li>
        ))}
      </ul>
      <p class="vacio" hidden data-vacio>No hay programas en esta área por ahora. <a class="enlace" href={enlaceWhatsapp("Hola, busco un curso que no encuentro en el catálogo.")} target="_blank" rel="noopener">Cuéntanos qué buscas</a>.</p>
    </div>
  </section>
</Base>

<style>
  .filtros { display: flex; flex-wrap: wrap; gap: var(--s-2); margin-bottom: var(--s-7); }
  .filtros button {
    display: inline-flex; align-items: center; gap: 0.5rem; min-height: 2.75rem; padding: 0 1rem;
    border: 1.5px solid var(--gris-claro); border-radius: 999px; background: var(--tarjeta);
    font-size: var(--t-sm); font-weight: 600; cursor: pointer; transition: all 150ms var(--ease);
  }
  .filtros button:hover { border-color: var(--amarillo); }
  .filtros button[aria-pressed="true"] { background: var(--amarillo); border-color: var(--amarillo); color: var(--negro); }
  .filtros i { width: 0.6rem; height: 0.6rem; border-radius: 50%; background: var(--c); }
  .filtros span { font-size: var(--t-xs); color: var(--gris-oscuro); font-weight: 700; }
  .filtros button[aria-pressed="true"] span { color: var(--negro); }

  /* Catálogo en tarjetas: la portada oficial arriba y los datos abajo; toda la tarjeta es un enlace */
  .lista { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s-6) var(--s-5); }
  .lista li[hidden] { display: none; }
  .tarjeta { display: flex; flex-direction: column; height: 100%; text-decoration: none; }
  .tarjeta__portada { position: relative; display: block; aspect-ratio: 16 / 9; border-radius: var(--radio-l); overflow: hidden; background: var(--negro); }
  .tarjeta__portada :global(img) { width: 100%; height: 100%; object-fit: cover; transition: scale 900ms var(--ease); }
  .tarjeta:hover .tarjeta__portada :global(img) { scale: 1.04; }
  /* Sin portada todavía: bloque negro con el color del área y el nombre, en el lenguaje de las portadas */
  .tarjeta__sin {
    display: flex; align-items: flex-end; height: 100%; padding: var(--s-5);
    background: radial-gradient(90% 120% at 100% 0%, color-mix(in srgb, var(--c) 70%, transparent), transparent 60%), var(--negro);
    color: var(--blanco); font-family: var(--font-marca); font-size: clamp(1.4rem, 1rem + 1.2vw, 2rem); font-weight: 800; letter-spacing: -0.04em; line-height: 1;
  }
  .tarjeta__cuerpo { display: flex; flex-direction: column; gap: var(--s-2); flex: 1; padding: var(--s-4) var(--s-2) 0; }
  .tarjeta__area { display: inline-flex; align-items: center; gap: 0.45rem; font-size: var(--t-xs); color: var(--gris-oscuro); }
  .tarjeta__area i { width: 0.55rem; height: 0.55rem; border-radius: 50%; background: var(--c); box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.15); }
  .tarjeta__nombre { font-family: var(--font-marca); font-size: var(--t-lg); font-weight: 700; letter-spacing: -0.025em; line-height: 1.2; }
  .tarjeta__resumen { font-size: var(--t-sm); color: var(--gris-oscuro); }
  .tarjeta__meta { font-size: var(--t-xs); font-weight: 600; }
  .tarjeta :global(.tarjeta__precio) { font-size: var(--t-sm); color: var(--gris-oscuro); }
  .tarjeta :global(.tarjeta__precio.precio--con) { color: var(--amarillo-60); font-size: var(--t-lg); }
  .tarjeta :global(.tarjeta__precio s) { font-size: var(--t-sm); color: var(--gris-oscuro); font-weight: 400; }
  .tarjeta__accion {
    display: inline-flex; align-items: center; gap: var(--s-3); align-self: flex-start; margin-top: auto; padding-top: var(--s-3);
    font-family: var(--font-marca); font-size: var(--t-sm); font-weight: 700;
  }
  .tarjeta__flecha { display: grid; place-items: center; width: 2.25rem; height: 2.25rem; border-radius: 50%; background: var(--tarjeta); box-shadow: inset 0 0 0 1px var(--amarillo); color: var(--amarillo); transition: background-color var(--t-accion) var(--ease), color var(--t-accion) var(--ease), transform var(--t-accion) var(--ease); }
  .tarjeta:hover .tarjeta__flecha, .tarjeta:focus-visible .tarjeta__flecha { background: var(--amarillo); color: var(--negro); transform: translateX(4px); }
  .tarjeta:focus-visible { outline-offset: 6px; border-radius: var(--radio-l); }
  .vacio { padding: var(--s-7) 0; font-size: var(--t-lg); }

  @media (max-width: 1100px) { .lista { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 640px) { .lista { grid-template-columns: 1fr; gap: var(--s-7); } }
</style>

<script>
  const grupo = document.querySelector<HTMLElement>("[data-filtros]");
  const filas = document.querySelectorAll<HTMLElement>("[data-lista] > li");
  const vacio = document.querySelector<HTMLElement>("[data-vacio]");
  const estado = document.querySelector<HTMLElement>("[data-estado]");
  const botones = grupo ? [...grupo.querySelectorAll<HTMLButtonElement>("button")] : [];
  const validas = new Set(botones.map((b) => b.dataset.area));

  function filtrar(area: string, actualizarUrl = true) {
    if (!validas.has(area)) area = "todas";
    botones.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.area === area)));
    let visibles = 0;
    filas.forEach((f) => {
      const mostrar = area === "todas" || f.dataset.area === area;
      f.hidden = !mostrar;
      if (mostrar) visibles++;
    });
    if (vacio) vacio.hidden = visibles > 0;
    if (estado) estado.textContent = `${visibles} resultados`;
    if (actualizarUrl) {
      const url = new URL(location.href);
      if (area === "todas") url.searchParams.delete("area"); else url.searchParams.set("area", area);
      try { history.replaceState(null, "", url); } catch { /* p. ej. documentos sin URL propia */ }
    }
  }

  botones.forEach((b) => b.addEventListener("click", () => filtrar(b.dataset.area ?? "todas")));
  filtrar(new URLSearchParams(location.search).get("area") ?? "todas", false);
</script>
