---
// Ficha de programa con la estructura del prototipo HTML del usuario: encabezado con migas, contenido en bloques
// y columna lateral fija con la ficha, la inversión y las acciones. Datos: src/data/programas.ts (material oficial).
import Base from "../../layouts/Base.astro";
import { programas, areaPorId, type Programa } from "../../data/programas";
import { sitio, enlaceWhatsapp } from "../../data/sitio";
import { preguntas } from "../../data/preguntas";
import { Picture, getImage } from "astro:assets";
import Precio from "../../components/Precio.astro";

export function getStaticPaths() {
  return programas.map((p) => ({ params: { slug: p.slug }, props: { programa: p } }));
}

const { programa } = Astro.props as { programa: Programa };
const area = areaPorId[programa.area];
const otros = programas.filter((p) => p.slug !== programa.slug).slice(0, 3);
const mensaje = `Hola, quiero información del ${programa.nombre}: horarios, inversión y próxima fecha de inicio.`;
const mensajeSilabo = `Hola, quiero recibir el sílabo del ${programa.nombre}.`;

// La portada oficial también sirve de imagen para redes (1200×630)
const og = programa.imagen ? (await getImage({ src: programa.imagen, width: 1200, height: 630, fit: "cover", format: "jpg" })).src : undefined;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Course",
  name: programa.nombre,
  description: programa.resumen,
  inLanguage: "es",
  provider: { "@type": "EducationalOrganization", name: sitio.nombre, sameAs: `https://${sitio.dominio}` },
  hasCourseInstance: { "@type": "CourseInstance", courseMode: "online" },
};
---
<Base titulo={programa.nombre} descripcion={programa.resumen} jsonLd={jsonLd} imagenOg={og}>
  <div class="phead">
    <div class="contenedor">
      <nav class="migas-d" aria-label="Ruta de navegación"><a href="/">Inicio</a> / <a href="/programas">Programas</a> / <a href={`/programas?area=${area.id}`}>{area.nombre}</a></nav>
      <span class="eyebrow">{area.nombre} · Programa</span>
      <h1>{programa.nombre}</h1>
      <p>{programa.resumen}</p>
    </div>
  </div>

  <section class="seccion-d">
    <div class="contenedor ficha">
      <div>
        {programa.imagen && (
          <figure class="ficha__portada">
            <Picture src={programa.imagen} formats={["avif", "webp"]} widths={[640, 960, 1400]} sizes="(max-width: 900px) 100vw, 44rem" loading="eager" fetchpriority="high" alt={`Portada del curso ${programa.nombre} de la Cámara de Comercio Exterior`} />
          </figure>
        )}

        <div class="bloque">
          <h2>¿Qué incluye?</h2>
          <ul role="list" class="lista-d">{programa.incluye.map((x) => <li>{x}</li>)}</ul>
        </div>

        {programa.publico && (
          <div class="bloque">
            <h2>¿A quién va dirigido?</h2>
            <p class="mut">{programa.publico}</p>
          </div>
        )}

        <div class="bloque faq-d">
          <h2>{programa.temarioTitulo}</h2>
          {programa.temario.map((t, i) => (
            <details open={i === 0}>
              <summary>{String(i + 1).padStart(2, "0")} · {t.titulo}</summary>
              <p>{t.detalle ?? "El asesor te comparte el detalle de este módulo con el sílabo."}</p>
            </details>
          ))}
        </div>

        <div class="bloque">
          <h2>Docente</h2>
          <div class="docente">
            <div class="avatar" aria-hidden="true">N</div>
            <div><b>Nombre por confirmar</b><p class="mut">Perfil, trayectoria y experiencia del docente. <span class="pendiente">Pendiente</span></p></div>
          </div>
        </div>

        <div class="bloque">
          <h2>Certificación</h2>
          <p class="mut">{programa.certificacion}</p>
        </div>

        <div class="bloque">
          <h2>Inversión y facilidades</h2>
          <p class="mut">La inversión y las opciones de pago dependen del grupo y de las promociones vigentes. Un asesor te ayuda a elegir la que mejor se adapte a ti.</p>
        </div>

        <div class="bloque faq-d">
          <h2>Preguntas frecuentes</h2>
          {preguntas.map((q) => (
            <details>
              <summary>{q.p}</summary>
              <p>{q.r}</p>
            </details>
          ))}
        </div>
      </div>

      <aside class="lateral" aria-label="Ficha del programa">
        <span class="eyebrow">Ficha del programa</span>
        <dl>
          {programa.datos.map((d) => (<><dt>{d.etiqueta}</dt><dd>{d.valor}</dd></>))}
          <dt>Certificado</dt><dd>Verificable con QR</dd>
        </dl>
        <div class="inversion">
          <small>Inversión referencial</small>
          <Precio id={programa.slug} class="inversion__precio" respaldo="Consulta con un asesor" />
        </div>
        <a class="boton boton--lleno" href={enlaceWhatsapp(mensajeSilabo)} target="_blank" rel="noopener">Solicitar sílabo<span class="sr-only"> por WhatsApp (se abre en una pestaña nueva)</span></a>
        <a class="boton" href={enlaceWhatsapp(mensaje)} target="_blank" rel="noopener">Hablar con un asesor<span class="sr-only"> por WhatsApp (se abre en una pestaña nueva)</span></a>
        <a class="lateral__datos" href={`/contacto?programa=${programa.slug}`}>Prefiero dejar mis datos</a>
      </aside>
    </div>
  </section>

  <section class="seccion-d seccion-d--alt" aria-labelledby="otros">
    <div class="contenedor">
      <span class="eyebrow">Sigue explorando</span>
      <h2 id="otros" class="h2-d">Otros programas</h2>
      <div class="regla"></div>
      <ul role="list" class="rejilla-d">
        {otros.map((p) => (
          <li><a class="tarjeta-d" href={`/programas/${p.slug}`}><span class="eyebrow">{areaPorId[p.area].nombre}</span><h3>{p.nombre}</h3><p>{p.resumen}</p></a></li>
        ))}
      </ul>
    </div>
  </section>
</Base>

<style>
  .ficha { display: grid; grid-template-columns: minmax(0, 1fr) 350px; gap: 50px; align-items: start; }
  .ficha__portada { margin: 0 0 46px; border: 1px solid var(--line); aspect-ratio: 16 / 9; overflow: hidden; }
  .ficha__portada :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .bloque { margin-bottom: 46px; }
  .bloque h2 { font-size: 1.8rem; margin-bottom: 0.6rem; }
  .lista-d { display: grid; gap: 10px; margin-top: 1rem; }
  .lista-d li { position: relative; padding-left: 22px; color: var(--mut); }
  .lista-d li::before { content: ""; position: absolute; left: 0; top: 0.8em; width: 10px; height: 1px; background: var(--gold); }
  .docente { display: grid; grid-template-columns: 140px 1fr; gap: 22px; align-items: center; }
  .docente b { font: 600 1.3rem var(--serif); }
  .docente p { margin-top: 0.3rem; font-size: 0.9rem; }
  .avatar { display: grid; place-items: center; aspect-ratio: 1; border: 1px solid var(--line); background: linear-gradient(160deg, #1a1710, #0d0d0d); font: 600 2rem var(--serif); color: var(--gold); }

  .lateral { position: sticky; top: calc(var(--header-h) + 8px); display: grid; gap: 10px; padding: 26px; background: var(--card); border: 1px solid var(--gold); }
  .lateral dl { display: grid; grid-template-columns: auto 1fr; gap: 9px 16px; margin: 14px 0 8px; font-size: 0.88rem; }
  .lateral dt { color: var(--mut); }
  .lateral dd { margin: 0; text-align: right; }
  .inversion { padding-top: 16px; border-top: 1px solid var(--line); margin-bottom: 6px; }
  .inversion small { display: block; font-size: 0.74rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--mut); }
  .inversion :global(.inversion__precio) { font: 600 1.2rem var(--serif); color: var(--gold2); }
  .inversion :global(.inversion__precio.precio--con) { font-size: 1.9rem; }
  .lateral .boton { width: 100%; }
  .lateral__datos { display: inline-flex; justify-content: center; align-items: center; min-height: 44px; font-size: 0.8rem; color: var(--mut); text-underline-offset: 4px; }
  .lateral__datos:hover { color: var(--gold2); }

  @media (max-width: 900px) {
    .ficha { grid-template-columns: 1fr; }
    .lateral { position: static; order: -1; }
    .docente { grid-template-columns: 96px 1fr; }
  }
</style>
