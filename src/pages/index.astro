---
// Inicio con la estructura del prototipo HTML del usuario (oct-2026): portada con cifras, áreas numeradas,
// «Nosotros» con video, notas del blog y llamada final. Las cifras sin fuente oficial se muestran como pendientes.
import Base from "../layouts/Base.astro";
import { sitio, enlaceWhatsapp } from "../data/sitio";
import { areas } from "../data/programas";
import { oferta } from "../data/oferta";
import { paises } from "../data/paises";
import { notas } from "../data/blog";
import { Picture } from "astro:assets";
import fotoAuditorio from "../assets/fotos/evento-auditorio.jpg";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "EducationalOrganization",
  name: sitio.nombre,
  alternateName: sitio.sigla,
  url: `https://${sitio.dominio}`,
  logo: `https://${sitio.dominio}/brand/isologo-color.svg`,
  contactPoint: { "@type": "ContactPoint", telephone: "+51902148893", contactType: "customer service", availableLanguage: "es" },
};

const atendidos = paises.filter((p) => p.codigo !== "OT").length;
// Cifras: solo se muestran como dato las que tienen fuente oficial
const cifras = [
  { valor: null, etiqueta: "Estudiantes" },
  { valor: String(atendidos), etiqueta: "Países atendidos" },
  { valor: String(areas.length), etiqueta: "Áreas de formación" },
  { valor: "QR", etiqueta: "Certificado verificable" },
];
const recientes = notas.slice(0, 3);
---
<Base titulo={sitio.nombre} descripcion={sitio.descripcion} jsonLd={jsonLd}>
  <div class="hero">
    <div class="contenedor">
      <span class="eyebrow">Educación continua · Certificado verificable</span>
      <h1>El conocimiento que <span class="dorado">impulsa</span> tu próxima etapa</h1>
      <p>Programas en vivo de comercio exterior, datos e inteligencia artificial para profesionales y empresas de Latinoamérica que quieren liderar el cambio.</p>
      <div class="cta">
        <a class="boton boton--lleno" href="/programas">Explorar programas</a>
        <a class="boton" href="/nosotros">Conocer {sitio.sigla}</a>
      </div>
      <dl class="cifras">
        {cifras.map((c) => (
          <div>
            <dt>{c.etiqueta}</dt>
            <dd>{c.valor ?? <span class="pendiente">Dato por confirmar</span>}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>

  <section class="seccion-d" id="areas" aria-labelledby="areas-titulo">
    <div class="contenedor">
      <span class="eyebrow">Educación continua</span>
      <h2 id="areas-titulo" class="h2-d">{areas.length} áreas, una sola excelencia</h2>
      <div class="regla"></div>
      <ul role="list" class="rejilla-d">
        {areas.map((a, i) => (
          <li>
            <a class="tarjeta-d area" href={`/programas?area=${a.id}`}>
              <i>{String(i + 1).padStart(2, "0")}</i>
              <h3>{a.nombre}</h3>
              <p>{a.descripcion}</p>
              <span class="area__cuenta">{oferta.filter((o) => o.area === a.id).length} programas y cursos</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="seccion-d seccion-d--alt" aria-labelledby="nosotros-titulo">
    <div class="contenedor dos-d">
      <div>
        <span class="eyebrow">Nosotros</span>
        <h2 id="nosotros-titulo" class="h2-d">Formamos profesionales con <span class="dorado">visión global</span></h2>
        <div class="regla"></div>
        <p class="mut">Unimos clases en vivo, docentes con experiencia y proyectos aplicados para que cada programa se traduzca en oportunidades reales.</p>
        <a class="mas-d" href="/nosotros"><span>Conoce nuestra historia y liderazgo</span></a>
      </div>
      <figure class="marco-d">
        <Picture src={fotoAuditorio} formats={["avif", "webp"]} widths={[480, 800]} sizes="(max-width: 820px) 100vw, 30rem" alt="Participantes y equipo de la Cámara de Comercio Exterior en un auditorio" />
        <figcaption class="marco-d__nota"><b>Video institucional</b>Espacio para un video de 60–90 s con líderes y estudiantes reales <span class="pendiente">Pendiente</span></figcaption>
      </figure>
    </div>
  </section>

  <section class="seccion-d" aria-labelledby="blog-titulo">
    <div class="contenedor">
      <span class="eyebrow">Blog {sitio.sigla}</span>
      <h2 id="blog-titulo" class="h2-d">Ideas para crecer profesionalmente</h2>
      <div class="regla"></div>
      <ul role="list" class="notas">
        {recientes.map((n) => (
          <li>
            <a class="nota" href="/blog">
              <span class="nota__th" aria-hidden="true">{sitio.sigla}</span>
              <span class="nota__bd">
                <span class="nota__tg">{n.categoria}</span>
                <span class="nota__titulo">{n.titulo}</span>
                <span class="nota__texto">{n.resumen ?? <span class="pendiente">En preparación</span>}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
      <a class="mas-d" href="/blog"><span>Ir al blog</span></a>
    </div>
  </section>

  <section class="final" id="contacto" aria-labelledby="final-titulo">
    <div class="contenedor">
      <span class="eyebrow">Da el siguiente paso</span>
      <h2 id="final-titulo" class="h2-d">Tu futuro profesional <span class="dorado">empieza hoy</span></h2>
      <p>Habla con un asesor y encuentra el programa ideal para tus objetivos.</p>
      <a class="boton boton--lleno" href={enlaceWhatsapp("Hola, quiero que un asesor me ayude a elegir un programa.")} target="_blank" rel="noopener">Hablar con un asesor<span class="sr-only"> por WhatsApp (se abre en una pestaña nueva)</span></a>
    </div>
  </section>
</Base>

<style>
  .hero { position: relative; overflow: hidden; padding: clamp(4.5rem, 3rem + 6vw, 6.9rem) 0 clamp(4rem, 3rem + 5vw, 6.25rem); background: radial-gradient(70% 90% at 80% 10%, rgba(201, 162, 75, 0.22), transparent 60%), radial-gradient(50% 60% at 0% 100%, rgba(201, 162, 75, 0.08), transparent 70%); }
  .hero::after { content: ""; position: absolute; right: -120px; top: 50%; width: 520px; height: 520px; border: 1px solid rgba(201, 162, 75, 0.25); border-radius: 50%; transform: translateY(-50%); box-shadow: 0 0 0 60px rgba(201, 162, 75, 0.04), 0 0 0 120px rgba(201, 162, 75, 0.025); pointer-events: none; }
  .hero .contenedor { position: relative; z-index: 1; }
  .hero h1 { font-size: clamp(2.6rem, 1.4rem + 5vw, 5.2rem); margin: 1.1rem 0 1.3rem; max-width: 12em; }
  .hero p { max-width: 34em; color: var(--mut); font-size: 1.08rem; }
  .cta { display: flex; gap: 14px; flex-wrap: wrap; margin-top: 2rem; }
  .cifras { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 1px; margin: 70px 0 0; background: var(--line); border: 1px solid var(--line); }
  .cifras > div { display: flex; flex-direction: column-reverse; justify-content: flex-end; padding: 24px 20px; background: var(--bg2); }
  .cifras dd { margin: 0; min-height: 2.8rem; display: flex; align-items: center; font: 600 2.3rem/1.2 var(--serif); color: var(--gold2); }
  .cifras dt { font-size: 0.78rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--mut); }

  .area { height: 100%; }
  .area i { font: 600 0.8rem var(--serif); font-style: normal; color: var(--gold); letter-spacing: 0.2em; }
  .area__cuenta { display: block; margin-top: 1rem; font-size: 0.74rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--gold); }
  .rejilla-d > li { display: grid; }

  .marco-d__nota { position: relative; z-index: 1; padding: 1.25rem; background: rgba(10, 10, 10, 0.78); }
  .marco-d__nota .pendiente { margin-top: 0.6rem; }

  .notas { display: grid; grid-template-columns: repeat(auto-fill, minmax(290px, 1fr)); gap: 22px; margin-top: 2.4rem; }
  .nota { display: flex; flex-direction: column; height: 100%; background: var(--card); border: 1px solid var(--line); text-decoration: none; transition: border-color 0.3s, transform 0.3s; }
  .nota:hover { border-color: var(--gold); transform: translateY(-3px); }
  .nota__th { display: grid; place-items: center; aspect-ratio: 16 / 9; background: linear-gradient(135deg, #1c170c, #0c0c0c 60%, #2a2110); border-bottom: 1px solid var(--line); font: 600 1.6rem var(--serif); color: rgba(201, 162, 75, 0.55); letter-spacing: 0.2em; }
  .nota__bd { display: grid; gap: 0.6rem; padding: 22px; }
  .nota__tg { font: 500 0.68rem var(--sans); letter-spacing: 0.22em; text-transform: uppercase; color: var(--gold); }
  .nota__titulo { font: 600 1.35rem/1.15 var(--serif); }
  .nota__texto { color: var(--mut); font-size: 0.9rem; }

  .final { padding: clamp(4.5rem, 3rem + 5vw, 6.25rem) 0; text-align: center; background: radial-gradient(60% 100% at 50% 0%, rgba(201, 162, 75, 0.18), transparent 70%); }
  .final p { max-width: 34em; margin: 0 auto 2rem; color: var(--mut); }
</style>
