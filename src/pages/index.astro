---
import Base from "../layouts/Base.astro";
import Flecha from "../components/Flecha.astro";
import Buscador from "../components/Buscador.astro";
import Precio from "../components/Precio.astro";
import { sitio, enlaceWhatsapp } from "../data/sitio";
import { areas, programas, areaPorId } from "../data/programas";
import { oferta } from "../data/oferta";
import { Picture } from "astro:assets";
import fotoAuditorio from "../assets/fotos/evento-auditorio.jpg";
import fotoCharla from "../assets/fotos/evento-charla-ia-generativa.jpg";
import fotoTren from "../assets/fotos/equipo-tren-ce.jpg";
import fotoCinta from "../assets/fotos/evento-corte-de-cinta.jpg";
import fotoRegistro from "../assets/fotos/evento-registro.jpg";
import fotoKits from "../assets/fotos/evento-entrega-kits.jpg";
import fotoBatucada from "../assets/fotos/evento-batucada-banner.jpg";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "EducationalOrganization",
  name: sitio.nombre,
  alternateName: sitio.sigla,
  url: `https://${sitio.dominio}`,
  logo: `https://${sitio.dominio}/brand/isologo-color.svg`,
  contactPoint: { "@type": "ContactPoint", telephone: "+51902148893", contactType: "customer service", availableLanguage: "es" },
};

const dato = (p: (typeof programas)[number], etiqueta: string) => p.datos.find((d) => d.etiqueta === etiqueta)?.valor;
const cuenta = (id: string) => oferta.filter((o) => o.area === id).length;
const cursosOferta = oferta.filter((o) => !o.programa);
const porNombre = (n: string) => oferta.find((o) => o.nombre === n)!;
// Portadas flotando en las esquinas de la portada (dos a cada lado)
const flotantes = ["Programa Completo de Excel", "Academia de Importadores", "Programa Profesional de Inteligencia Artificial Aplicada", "Power BI 8 en 1"].map(porNombre);
// Visual de «aprende haciendo»: la portada del programa de IA dentro de una ventana de clase
const pantalla = porNombre("Programa Profesional de Inteligencia Artificial Aplicada");

// Momentos reales de la comunidad (fotos propias de la CE). No son testimonios: esos se publicarán con autorización.
const historias = [
  { tipo: "Workshop", titulo: "Charla de IA generativa", texto: "Talleres presenciales para usar la inteligencia artificial con criterio.", foto: fotoCharla, alt: "Ponente explicando qué son las IA generativas frente a una proyección" },
  { tipo: "Comunidad", titulo: "Auditorio lleno al cierre", texto: "Participantes y equipo de la CE al cerrar un evento presencial.", foto: fotoAuditorio, alt: "Participantes y equipo de la Cámara de Comercio Exterior en un auditorio lleno" },
  { tipo: "Campaña", titulo: "Lanzamiento de «Educación continua»", texto: "Corte de cinta con el lema «Aprende, certifícate y avanza».", foto: fotoCinta, alt: "Corte de cinta con el lema «Aprende, certifícate y avanza»" },
  { tipo: "Evento", titulo: "Registro de participantes", texto: "Inscripción en uno de nuestros eventos presenciales.", foto: fotoRegistro, alt: "Fila de estudiantes registrándose junto al banner de la Cámara de Comercio Exterior" },
  { tipo: "Equipo", titulo: "La CE en movimiento", texto: "Nuestro equipo durante la campaña «Educación continua».", foto: fotoTren, alt: "Equipo de la Cámara de Comercio Exterior en un andén, junto a un tren con el logo de la CE" },
];

// Ilustraciones geométricas de las áreas: arcos de la «C» de la marca combinados con formas simples
const figuras = [
  '<circle cx="100" cy="92" r="52" fill="none" stroke="#000" stroke-width="26" stroke-dasharray="250 77" transform="rotate(40 100 92)"/><rect x="138" y="20" width="36" height="36" rx="8" fill="#fff"/><circle cx="40" cy="132" r="14" fill="#fff"/>',
  '<rect x="34" y="40" width="70" height="70" rx="14" fill="#fff"/><circle cx="130" cy="94" r="44" fill="none" stroke="#000" stroke-width="22"/><path d="M150 20l18 18-18 18-18-18z" fill="#ffc300"/>',
  '<circle cx="100" cy="86" r="56" fill="#ffc300"/><circle cx="100" cy="86" r="30" fill="none" stroke="#fff" stroke-width="16" stroke-dasharray="140 49"/><circle cx="160" cy="34" r="10" fill="#fff"/>',
  '<path d="M30 130 100 30l70 100z" fill="#ffc300"/><circle cx="100" cy="98" r="24" fill="#fff"/><rect x="150" y="16" width="26" height="26" rx="6" fill="#fff"/>',
  '<rect x="40" y="36" width="54" height="94" rx="8" fill="#ffc300"/><rect x="104" y="64" width="54" height="66" rx="8" fill="#fff"/><circle cx="160" cy="34" r="14" fill="none" stroke="#ffc300" stroke-width="8"/>',
  '<circle cx="78" cy="84" r="44" fill="none" stroke="#ffc300" stroke-width="22" stroke-dasharray="210 67" transform="rotate(40 78 84)"/><circle cx="140" cy="84" r="30" fill="#fff"/><rect x="146" y="20" width="22" height="22" rx="11" fill="#ffc300"/>',
];

// «Por eso te guardamos un lugar»
const lugares = [
  { titulo: "Clases en vivo", texto: "Con el docente y en grupo", foto: fotoCharla, alt: "Ponente en una charla de inteligencia artificial" },
  { titulo: "Eventos presenciales", texto: "Talleres, charlas y workshops", foto: fotoKits, alt: "Entrega de bolsas con el logo de la Cámara de Comercio Exterior a una participante" },
  { titulo: "Educación continua", texto: "Una comunidad que sigue aprendiendo", foto: fotoBatucada, alt: "Batucada junto al banner «Educación continua» de la Cámara de Comercio Exterior" },
];
const metas = ["Importar desde China", "Dominar Excel", "Analizar datos con Power BI", "Usar IA en tu trabajo", "Crecer en tu empresa", "Cambiar de carrera", "Diseñar y vender en digital"];

const preguntas = [
  { p: "¿Las clases son en vivo?", r: "Sí. Los programas incluyen sesiones en vivo con el docente, y varios suman clases de refuerzo en vivo y material grabado para repasar cuando lo necesites." },
  { p: "¿Recibo un certificado al terminar?", r: "Sí. Al cumplir los requisitos de tu programa recibes un certificado digital de la Cámara de Comercio Exterior con código QR, para que cualquiera pueda verificar su autenticidad." },
  { p: "¿Cómo me inscribo?", r: "Escríbenos por WhatsApp o deja tus datos en el formulario de contacto. Un asesor te confirma horarios, inversión vigente y medios de pago, y te acompaña en la matrícula." },
  { p: "¿Dónde veo precios y fechas de inicio?", r: "La inversión y las fechas cambian según el grupo y las promociones vigentes. Por eso un asesor te comparte las condiciones actualizadas del programa que te interesa." },
  { p: "¿Puedo estudiar desde fuera del Perú?", r: "Sí. Los programas se dictan en línea, así que puedes seguirlos desde cualquier país. Confirma con tu asesor el horario de tu grupo según tu zona horaria." },
  { p: "¿Tienen capacitación para empresas?", r: "Sí. Coordinamos programas del catálogo para grupos de colaboradores, con condiciones corporativas. Cuéntanos cuántas personas son y qué necesitan aprender." },
];
---
<Base titulo={sitio.nombre} descripcion={sitio.descripcion} jsonLd={jsonLd}>
  <div class="inicio sobre-oscuro">
    <!-- 1. PORTADA centrada, con portadas de cursos flotando en las esquinas -->
    <section class="hero" aria-labelledby="hero-titulo">
      <div class="hero__flotantes" aria-hidden="true">
        {flotantes.map((f, i) => (
          <div class={`flotante flotante--${i + 1}`}>
            <Picture src={f.imagen!} formats={["avif", "webp"]} widths={[320, 520]} sizes="22rem" loading="eager" alt="" />
          </div>
        ))}
      </div>
      <!-- «El abrazo»: el arco amarillo de la C rodea el titular; se dibuja al cargar, se orienta hacia el cursor
           y gira como un dial al bajar (scripts/efectos.ts escribe --px, --py y --giro) -->
      <div class="abrazo" data-abrazo aria-hidden="true">
        <div class="abrazo__luz"></div>
        <div class="abrazo__giro">
          <svg class="abrazo__arco" viewBox="0 0 400 400"><path d="M 327.3 72.7 A 180 180 0 1 0 327.3 327.3" fill="none" stroke="var(--amarillo)" stroke-width="16" pathLength="100" /></svg>
        </div>
      </div>
      <div class="contenedor hero__centro">
        <!-- Lema oficial de la campaña «Educación continua» -->
        <h1 id="hero-titulo" class="hero__titulo">Aprende, certifícate y <span class="acento">avanza.</span></h1>
        <p class="hero__sub">Programas y cursos en vivo de comercio exterior, datos, inteligencia artificial, marketing, diseño e ingeniería, con certificado digital de la Cámara de Comercio Exterior.</p>
        <div class="acciones acciones--centro">
          <a class="btn btn--amarillo" href="/programas">Explorar programas <Flecha /></a>
          <a class="btn btn--contorno" href="/empresas">Capacitación para empresas</a>
        </div>
        <!-- En pantallas angostas la cabecera no muestra el buscador: aparece aquí -->
        <div class="hero__buscar"><Buscador id="buscar-portada" variante="portada" /></div>
        <p class="hero__nota">Asesoría por WhatsApp <a href={enlaceWhatsapp("Hola, quiero que un asesor me ayude a elegir un programa.")} target="_blank" rel="noopener">{sitio.whatsapp.visible}</a></p>
      </div>
    </section>

    <!-- 2. HISTORIAS: momentos reales de la comunidad (los testimonios llegarán cuando estén autorizados) -->
    <section class="seccion seccion--corta" aria-labelledby="historias-titulo">
      <div class="contenedor">
        <div class="cabeza">
          <h2 id="historias-titulo" class="titulo-bloque">Creamos momentos que impulsan carreras</h2>
          <div class="carrusel__flechas" data-flechas="historias">
            <button type="button" data-dir="-1" aria-label="Momentos anteriores"><svg width="16" height="16" viewBox="0 0 14 14" aria-hidden="true"><path d="M12 7H3M6.5 3 2.5 7l4 4" fill="none" stroke="currentColor" stroke-width="2" /></svg></button>
            <button type="button" data-dir="1" aria-label="Momentos siguientes"><svg width="16" height="16" viewBox="0 0 14 14" aria-hidden="true"><path d="M2 7h9M7.5 3 11.5 7l-4 4" fill="none" stroke="currentColor" stroke-width="2" /></svg></button>
          </div>
        </div>
        <ul role="list" class="carrusel" data-carrusel="historias">
          {historias.map((h) => (
            <li class="historia-celda">
              <article class="historia">
                <div class="historia__texto">
                  <span class="historia__tipo">{h.tipo}</span>
                  <h3 class="historia__titulo">{h.titulo}</h3>
                  <p>{h.texto}</p>
                </div>
                <figure class="historia__foto" data-revelar="foto"><Picture src={h.foto} formats={["avif", "webp"]} widths={[320, 520]} sizes="12rem" alt={h.alt} /></figure>
              </article>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 3. APRENDE HACIENDO: placas de color, visual central y texto -->
    <section class="seccion" aria-labelledby="haciendo-titulo">
      <div class="contenedor haciendo">
        <ul role="list" class="placas">
          <li class="placa-color placa-color--a"><span>En vivo</span><strong>Clases con el docente en tiempo real</strong></li>
          <li class="placa-color placa-color--b"><span>Práctico</span><strong>Un proyecto aplicado al cierre</strong></li>
          <li class="placa-color placa-color--c"><span>Verificable</span><strong>Certificado digital con código QR</strong></li>
        </ul>
        <div class="pantalla" aria-hidden="true">
          <div class="pantalla__barra"><i></i><i></i><i></i><span>Clase en vivo</span></div>
          <div class="pantalla__video">
            <Picture src={pantalla.imagen!} formats={["avif", "webp"]} widths={[640, 960]} sizes="(max-width: 900px) 100vw, 40vw" alt="" />
            <span class="pantalla__vivo">● En vivo</span>
          </div>
        </div>
        <div class="haciendo__texto">
          <h2 id="haciendo-titulo" class="titulo-bloque">Aprende haciendo, en cada clase</h2>
          <p class="intro">Todos los programas son virtuales y combinan sesiones con el docente, material para repasar y un proyecto que demuestra lo que aprendiste.</p>
        </div>
      </div>
    </section>

    <!-- 4. ELIGE QUÉ APRENDER HOY: áreas con ilustración geométrica de color -->
    <section class="seccion seccion--corta" aria-labelledby="areas-titulo">
      <div class="contenedor">
        <div class="cabeza">
          <h2 id="areas-titulo" class="titulo-bloque">Elige qué aprender hoy</h2>
          <div class="carrusel__flechas" data-flechas="areas">
            <button type="button" data-dir="-1" aria-label="Áreas anteriores"><svg width="16" height="16" viewBox="0 0 14 14" aria-hidden="true"><path d="M12 7H3M6.5 3 2.5 7l4 4" fill="none" stroke="currentColor" stroke-width="2" /></svg></button>
            <button type="button" data-dir="1" aria-label="Áreas siguientes"><svg width="16" height="16" viewBox="0 0 14 14" aria-hidden="true"><path d="M2 7h9M7.5 3 11.5 7l-4 4" fill="none" stroke="currentColor" stroke-width="2" /></svg></button>
          </div>
        </div>
        <ul role="list" class="carrusel" data-carrusel="areas">
          {areas.map((a, i) => (
            <li class="area-celda" data-revelar>
              <a class="area" href={`/programas?area=${a.id}`} style={`--c:${a.color}; --t:${a.id === "comercio" ? "#000" : "#fff"}`}>
                <span class="area__lienzo">
                  <span class="area__rotulo">{a.nombre}</span>
                  <svg class="area__figura" viewBox="0 0 200 160" aria-hidden="true" set:html={figuras[i % figuras.length]} />
                </span>
                <span class="area__pie">{a.nombre} <span aria-hidden="true">→</span></span>
                <span class="area__cuenta">{cuenta(a.id)} {cuenta(a.id) === 1 ? "programa" : "programas y cursos"}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 5. PROGRAMAS CON TEMARIO COMPLETO -->
    <section class="seccion seccion--corta" aria-labelledby="rutas-titulo">
      <div class="contenedor">
        <div class="cabeza">
          <h2 id="rutas-titulo" class="titulo-bloque">Programas con temario completo</h2>
          <div class="carrusel__flechas" data-flechas="rutas">
            <button type="button" data-dir="-1" aria-label="Programas anteriores"><svg width="16" height="16" viewBox="0 0 14 14" aria-hidden="true"><path d="M12 7H3M6.5 3 2.5 7l4 4" fill="none" stroke="currentColor" stroke-width="2" /></svg></button>
            <button type="button" data-dir="1" aria-label="Programas siguientes"><svg width="16" height="16" viewBox="0 0 14 14" aria-hidden="true"><path d="M2 7h9M7.5 3 11.5 7l-4 4" fill="none" stroke="currentColor" stroke-width="2" /></svg></button>
          </div>
        </div>
        <ul role="list" class="carrusel" data-carrusel="rutas">
          {programas.map((p) => (
            <li class="ruta-celda" data-revelar>
              <a class="ruta" href={`/programas/${p.slug}`} style={`--c:${p.color ?? areaPorId[p.area].color}`}>
                <span class="portada">
                  {p.imagen
                    ? <Picture src={p.imagen} formats={["avif", "webp"]} widths={[480, 720, 960]} sizes="(max-width: 640px) 85vw, 26rem" alt="" />
                    : <span class="portada__sin" aria-hidden="true">{p.nombre}</span>}
                </span>
                <span class="ruta__area"><i aria-hidden="true"></i>{areaPorId[p.area].nombre}</span>
                <span class="ruta__nombre">{p.nombre}</span>
                <span class="ruta__datos">
                  {dato(p, "Duración") && <span>{dato(p, "Duración")}</span>}
                  {dato(p, "Modalidad") && <span>{dato(p, "Modalidad")}</span>}
                </span>
                <Precio id={p.slug} class="ruta__precio" respaldo="" />
                <span class="ruta__ir">Ver temario <span class="circulo" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 14 14"><path d="M2 7h9M7.5 3 11.5 7l-4 4" fill="none" stroke="currentColor" stroke-width="2" /></svg></span></span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 6. CURSOS con pestañas por área -->
    <section class="seccion seccion--corta" aria-labelledby="cursos-titulo">
      <div class="contenedor">
        <div class="cabeza">
          <h2 id="cursos-titulo" class="titulo-bloque">Cursos para dar el siguiente paso</h2>
          <div class="carrusel__flechas" data-flechas="cursos">
            <button type="button" data-dir="-1" aria-label="Cursos anteriores"><svg width="16" height="16" viewBox="0 0 14 14" aria-hidden="true"><path d="M12 7H3M6.5 3 2.5 7l4 4" fill="none" stroke="currentColor" stroke-width="2" /></svg></button>
            <button type="button" data-dir="1" aria-label="Cursos siguientes"><svg width="16" height="16" viewBox="0 0 14 14" aria-hidden="true"><path d="M2 7h9M7.5 3 11.5 7l-4 4" fill="none" stroke="currentColor" stroke-width="2" /></svg></button>
          </div>
        </div>
        <div class="pestanas" role="group" aria-label="Filtrar cursos por área" data-pestanas>
          <button type="button" aria-pressed="true" data-area="todas">Todos</button>
          {areas.filter((a) => cursosOferta.some((c) => c.area === a.id)).map((a) => (
            <button type="button" aria-pressed="false" data-area={a.id}>{a.nombre}</button>
          ))}
        </div>
        <ul role="list" class="carrusel" data-carrusel="cursos">
          {cursosOferta.map((c) => (
            <li class="curso-celda" data-revelar data-area={c.area}>
              <a class="curso" href={c.href} target="_blank" rel="noopener" style={`--c:${c.color}`}>
                <span class="portada">
                  {c.imagen
                    ? <Picture src={c.imagen} formats={["avif", "webp"]} widths={[400, 640]} sizes="(max-width: 640px) 70vw, 19rem" alt="" />
                    : <span class="portada__sin" aria-hidden="true">{c.nombre}</span>}
                </span>
                <span class="curso__area">{areaPorId[c.area].nombre}</span>
                <span class="curso__nombre">{c.nombre}</span>
                <Precio id={c.id} class="curso__precio" respaldo="" />
                <span class="curso__ir">Consultar por WhatsApp<span class="sr-only"> (se abre en una pestaña nueva)</span></span>
              </a>
            </li>
          ))}
        </ul>
        <p class="ver-todo"><a class="enlace-mas" href="/programas">Ver los {oferta.length} programas y cursos</a></p>
      </div>
    </section>

    <!-- 7. POR ESO TE GUARDAMOS UN LUGAR: tarjetas inclinadas y metas flotantes -->
    <section class="seccion lugar" aria-labelledby="lugar-titulo">
      <div class="contenedor">
        <h2 id="lugar-titulo" class="titulo-bloque lugar__titulo">Por eso te guardamos un lugar</h2>
        <ul role="list" class="lugar__tarjetas">
          {lugares.map((l, i) => (
            <li class={`lugar__tarjeta lugar__tarjeta--${i + 1}`}>
              <figure><Picture src={l.foto} formats={["avif", "webp"]} widths={[400, 640]} sizes="(max-width: 700px) 80vw, 18rem" alt={l.alt} /></figure>
              <strong>{l.titulo}</strong>
              <span>{l.texto}</span>
            </li>
          ))}
        </ul>
        <div class="metas">
          <ul role="list" class="metas__lista" aria-label="Metas que puedes alcanzar">
            {metas.map((m, i) => <li class={`meta meta--${i + 1}`}>{m}</li>)}
          </ul>
          <p class="metas__titulo">Convierte tus metas en tu siguiente logro profesional.</p>
          <p class="metas__sub">Empieza hoy a hacerlo realidad.</p>
        </div>
      </div>
    </section>

    <!-- 8. ELIGE CÓMO EMPEZAR (en lugar de planes: la inversión la confirma un asesor) -->
    <section class="seccion" aria-labelledby="empezar-titulo">
      <div class="contenedor">
        <h2 id="empezar-titulo" class="titulo-bloque centrado">Elige cómo empezar</h2>
        <div class="opciones">
          <article class="opcion">
            <span class="opcion__para">Para ti</span>
            <h3>Estudia un programa o curso</h3>
            <ul role="list">
              <li>Clases en vivo y material para repasar</li>
              <li>Proyecto aplicado al cierre</li>
              <li>Certificado digital con código QR</li>
              <li>Horarios e inversión vigentes confirmados por un asesor</li>
            </ul>
            <a class="btn btn--amarillo" href={enlaceWhatsapp("Hola, quiero que un asesor me ayude a elegir un programa.")} target="_blank" rel="noopener">Hablar con un asesor <Flecha /></a>
          </article>
          <article class="opcion opcion--destacada">
            <span class="opcion__para">Para tu empresa</span>
            <h3>Capacita a tu equipo</h3>
            <ul role="list">
              <li>Programas del catálogo para grupos de colaboradores</li>
              <li>Condiciones corporativas</li>
              <li>Propuesta según el área y el número de personas</li>
              <li>Coordinación de accesos e inicio de clases</li>
            </ul>
            <a class="btn btn--negro" href="/empresas">Solicitar propuesta <Flecha /></a>
          </article>
        </div>
      </div>
    </section>

    <!-- 9. PREGUNTAS FRECUENTES -->
    <section class="seccion seccion--panel faq" aria-labelledby="faq-titulo">
      <div class="contenedor faq__rejilla">
        <div>
          <h2 id="faq-titulo" class="titulo-bloque">Preguntas frecuentes</h2>
          <p class="intro">¿Tu duda no está aquí? <a class="enlace" href="/contacto">Escríbenos</a> y te respondemos.</p>
        </div>
        <div class="faq__lista">
          {preguntas.map((q) => (
            <details class="faq__item" name="faq">
              <summary><span class="faq__pregunta">{q.p}</span><span class="faq__mas" aria-hidden="true"></span></summary>
              <p class="faq__respuesta">{q.r}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  </div>
</Base>

<style>
  /* Inicio oscuro con la estructura de una plataforma de cursos; colores de la marca (negro y amarillo) */
  :global(body:has(.inicio)) { background: var(--negro); }
  .inicio { background: var(--negro); color: var(--blanco); overflow-x: clip; }
  .inicio :global(.intro) { color: #bfbfbf; }
  .seccion--corta { padding-block: clamp(2.5rem, 1.5rem + 3vw, 4.5rem); }
  .seccion--panel { background: #0d0d0d; border-block: 1px solid rgba(255, 255, 255, 0.06); }
  .titulo-bloque { font-size: clamp(1.6rem, 1.1rem + 1.8vw, 2.6rem); letter-spacing: -0.035em; line-height: 1.1; }
  .centrado { text-align: center; }
  .acciones { display: flex; flex-wrap: wrap; gap: var(--s-3); margin-top: var(--s-6); }
