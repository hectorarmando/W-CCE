<script>
  // Carruseles: las flechas desplazan una «página» y se desactivan en los extremos
  document.querySelectorAll<HTMLElement>("[data-flechas]").forEach((grupo) => {
    const pista = document.querySelector<HTMLElement>(`[data-carrusel="${grupo.dataset.flechas}"]`);
    if (!pista) return;
    const [ant, sig] = grupo.querySelectorAll<HTMLButtonElement>("button");
    const actualizar = () => {
      ant.disabled = pista.scrollLeft <= 4;
      sig.disabled = pista.scrollLeft + pista.clientWidth >= pista.scrollWidth - 4;
    };
    grupo.querySelectorAll<HTMLButtonElement>("button").forEach((b) => b.addEventListener("click", () => {
      pista.scrollBy({ left: Number(b.dataset.dir) * pista.clientWidth * 0.85, behavior: "smooth" });
    }));
    pista.addEventListener("scroll", actualizar, { passive: true });
    new ResizeObserver(actualizar).observe(pista);
    actualizar();
  });

  // Pestañas de cursos por área
  const pestanas = document.querySelector<HTMLElement>("[data-pestanas]");
  const celdas = document.querySelectorAll<HTMLElement>('[data-carrusel="cursos"] > li');
  pestanas?.querySelectorAll<HTMLButtonElement>("button").forEach((b) => b.addEventListener("click", () => {
    pestanas.querySelectorAll("button").forEach((x) => x.setAttribute("aria-pressed", String(x === b)));
    celdas.forEach((c) => { c.hidden = b.dataset.area !== "todas" && c.dataset.area !== b.dataset.area; });
    const pista = document.querySelector<HTMLElement>('[data-carrusel="cursos"]');
    pista?.scrollTo({ left: 0 });
    pista?.dispatchEvent(new Event("scroll"));
  }));
</script>
