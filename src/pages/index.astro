---
// Inicio — estructura aprobada (oct-2026): portada con un botón, servicios, por qué elegirnos, testimonios,
// preguntas frecuentes y contacto con mapa. Estilo claro y minimalista (sugerencia de ui-ux-pro-max) con los
// colores y tipografías del manual de la CE; animaciones con Motion (scripts/aparecer.ts). Celular primero.
import Base from "../layouts/Base.astro";
import Precio from "../components/Precio.astro";
import FormularioContacto from "../components/FormularioContacto.astro";
import MapaPaises from "../components/MapaPaises.astro";
import { sitio, enlaceWhatsapp } from "../data/sitio";
import { programas, cursos } from "../data/programas";
import { oferta } from "../data/oferta";
import { testimonios } from "../data/testimonios";
import { paisPorCodigo } from "../data/paises";
import { Picture } from "astro:assets";
import fotoAuditorio from "../assets/fotos/evento-auditorio.jpg";
import fotoCharla from "../assets/fotos/evento-charla-ia-generativa.jpg";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "EducationalOrganization",
  name: sitio.nombre,
  alternateName: sitio.sigla,
  url: `https://${sitio.dominio}`,
  logo: `https://${sitio.dominio}/brand/isologo-color.svg`,
  contactPoint: { "@type": "ContactPoint", telephone: "+51902148893", contactType: "customer service", availableLanguage: "es" },
};

const mensajeAsesor = "Hola, quiero que un asesor me ayude a elegir un programa.";
const porNombre = (n: string) => oferta.find((o) => o.nombre === n)!;
// Portadas oficiales flotando en las esquinas de la portada (solo escritorio)
const flotantes = ["Programa Completo de Excel", "Academia de Importadores", "Programa Profesional de Inteligencia Artificial Aplicada", "Power BI 8 en 1"].map(porNombre);
const dato = (p: (typeof programas)[number], etiqueta: string) => p.datos.find((d) => d.etiqueta === etiqueta)?.valor;

// Servicios: lo que ofrece la CE según el material oficial
const servicios = [
  { titulo: "Programas con temario completo", texto: `${programas.length} rutas de varias semanas con clases en vivo y un proyecto final.`, cta: "Ver programas", href: "/programas", imagen: porNombre("Academia de Importadores").imagen!, alt: "" },
  { titulo: "Cursos por área", texto: `${cursos.length} cursos de datos, IA, marketing, diseño, ingeniería, gestión e idiomas.`, cta: "Ver cursos", href: "/programas", imagen: porNombre("Python").imagen!, alt: "" },
  { titulo: "Capacitación para empresas", texto: "Programas del catálogo para grupos de colaboradores, con precio corporativo.", cta: "Pedir presupuesto", href: "/empresas", imagen: fotoAuditorio, alt: "Auditorio lleno en un evento de la Cámara de Comercio Exterior" },
  { titulo: "Workshops presenciales", texto: "Charlas y talleres presenciales, como los de IA generativa y de importación.", cta: "Consultar fechas", href: enlaceWhatsapp("Hola, quiero información sobre los próximos workshops presenciales."), externo: true, imagen: fotoCharla, alt: "Ponente en un workshop de IA generativa" },
];

// Por qué elegirnos: solo hechos del material oficial (brochures y sílabos 2026)
const razones = [
  { icono: "vivo", titulo: "Clases en vivo", texto: "Aprendes con el docente en tiempo real y resuelves tus dudas en clase." },
  { icono: "proyecto", titulo: "Proyecto aplicado", texto: "Cierras cada programa con un proyecto real que demuestra lo que aprendiste." },
  { icono: "certificado", titulo: "Certificado con código QR", texto: "Certificado digital de la Cámara de Comercio Exterior que cualquier empresa puede verificar." },
  { icono: "mundo", titulo: "100 % en línea", texto: "Estudia desde Perú o desde cualquier país, con grabaciones para repasar." },
  { icono: "paises", titulo: "Atención en 7 países", texto: "Perú, Ecuador, Costa Rica, Colombia, México, Panamá y Argentina." },
  { icono: "asesor", titulo: "Asesoría por WhatsApp", texto: "Un asesor te ayuda a elegir y te confirma horarios e inversión vigente." },
];
const iconos: Record<string, string> = {
  vivo: '<circle cx="20" cy="20" r="4"/><path d="M12.5 12.5a10.6 10.6 0 0 0 0 15M27.5 12.5a10.6 10.6 0 0 1 0 15M7.5 7.5a17.7 17.7 0 0 0 0 25M32.5 7.5a17.7 17.7 0 0 1 0 25"/>',
  proyecto: '<circle cx="20" cy="20" r="14"/><circle cx="20" cy="20" r="8"/><circle cx="20" cy="20" r="2"/><path d="M20 2v6M20 32v6M2 20h6M32 20h6"/>',
  certificado: '<rect x="6" y="5" width="22" height="28" rx="2"/><path d="M11 12h12M11 17h8"/><circle cx="29" cy="27" r="6"/><path d="m26 32-1 6 4-2 4 2-1-6"/>',
  mundo: '<rect x="5" y="8" width="30" height="20" rx="2"/><path d="M14 33h12M20 28v5"/>',
  paises: '<circle cx="20" cy="20" r="15"/><path d="M5 20h30M20 5c4.5 4.2 6.5 9.2 6.5 15S24.5 30.8 20 35c-4.5-4.2-6.5-9.2-6.5-15S15.5 9.2 20 5Z"/>',
  asesor: '<path d="M8 30l2.2-6.4A12 12 0 1 1 15 28.7Z"/><path d="M15 17h10M15 22h6"/>',
};

const preguntas = [
  { p: "¿Las clases son en vivo?", r: "Sí. Los programas incluyen sesiones en vivo con el docente, y varios suman clases de refuerzo en vivo y material grabado para repasar cuando lo necesites." },
  { p: "¿Recibo un certificado al terminar?", r: "Sí. Al cumplir los requisitos de tu programa recibes un certificado digital de la Cámara de Comercio Exterior con código QR, para que cualquiera pueda verificar su autenticidad." },
  { p: "¿Cómo me inscribo?", r: "Escríbenos por WhatsApp o deja tus datos en el formulario de contacto. Un asesor te confirma horarios, inversión vigente y medios de pago, y te acompaña en la matrícula." },
  { p: "¿Dónde veo precios y fechas de inicio?", r: "La inversión y las fechas cambian según el grupo y las promociones vigentes. Por eso un asesor te comparte las condiciones actualizadas del programa que te interesa." },
  { p: "¿Puedo estudiar desde fuera del Perú?", r: "Sí. Los programas se dictan en línea, así que puedes seguirlos desde cualquier país. Confirma con tu asesor el horario de tu grupo según tu zona horaria." },
  { p: "¿Tienen capacitación para empresas?", r: "Sí. Coordinamos programas del catálogo para grupos de colaboradores, con condiciones corporativas. Cuéntanos cuántas personas son y qué necesitan aprender." },
];
---
<Base titulo={sitio.nombre} descripcion={sitio.descripcion} jsonLd={jsonLd}>
  <!-- 1. PORTADA: frase fuerte y un solo botón (WhatsApp) -->
  <section class="hero sobre-oscuro" aria-labelledby="hero-titulo">
    <div class="hero__flotantes" aria-hidden="true">
      {flotantes.map((f, i) => (
        <div class={`flotante flotante--${i + 1}`}>
          <Picture src={f.imagen!} formats={["avif", "webp"]} widths={[320, 520]} sizes="20rem" loading="lazy" alt="" />
        </div>
      ))}
    </div>
    <!-- «El abrazo»: el arco de la C se dibuja, se orienta hacia el cursor y gira al bajar (scripts/efectos.ts) -->
    <div class="abrazo" data-abrazo aria-hidden="true">
      <div class="abrazo__luz"></div>
      <div class="abrazo__giro">
        <svg class="abrazo__arco" viewBox="0 0 400 400"><path d="M 327.3 72.7 A 180 180 0 1 0 327.3 327.3" fill="none" stroke="var(--amarillo)" stroke-width="16" pathLength="100" /></svg>
      </div>
    </div>
    <div class="contenedor hero__centro">
      <p class="hero__marca">Educación continua</p>
      <!-- Lema oficial de la campaña «Educación continua» -->
      <h1 id="hero-titulo" class="hero__titulo">Aprende, certifícate y <span class="acento">avanza.</span></h1>
      <p class="hero__sub">Programas en vivo de comercio exterior, datos e inteligencia artificial, con proyecto aplicado y certificado digital verificable. Te ayudamos a elegir por WhatsApp.</p>
      <a class="btn btn--amarillo hero__cta" href={enlaceWhatsapp(mensajeAsesor)} target="_blank" rel="noopener">
        <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2c-1.5 0-3-.4-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.4.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2l-.5-.3Z"/></svg>
        Escríbenos por WhatsApp
        <span class="sr-only"> (se abre en una pestaña nueva)</span>
      </a>
      <a class="hero__secundario" href="/programas">o explora los programas</a>
    </div>
  </section>

  <!-- 2. SERVICIOS -->
  <section class="seccion" aria-labelledby="servicios-titulo">
    <div class="contenedor">
      <div class="encabezado" data-aparecer>
        <h2 id="servicios-titulo" class="titulo-bloque">Lo que ofrecemos</h2>
        <p class="intro">Formación práctica para profesionales, estudiantes y empresas.</p>
      </div>
      <ul role="list" class="servicios" data-aparecer-grupo>
        {servicios.map((s) => (
          <li>
            <a class="servicio" data-elevar href={s.href} {...(s.externo ? { target: "_blank", rel: "noopener" } : {})}>
              <span class="servicio__imagen"><Picture src={s.imagen} formats={["avif", "webp"]} widths={[400, 640]} sizes="(max-width: 640px) 100vw, (max-width: 1100px) 50vw, 25vw" alt={s.alt} /></span>
              <span class="servicio__cuerpo">
                <span class="servicio__titulo">{s.titulo}</span>
                <span class="servicio__texto">{s.texto}</span>
                <span class="servicio__cta">{s.cta}{s.externo && <span class="sr-only"> por WhatsApp (se abre en una pestaña nueva)</span>}<span class="circulo" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 14 14"><path d="M2 7h9M7.5 3 11.5 7l-4 4" fill="none" stroke="currentColor" stroke-width="2" /></svg></span></span>
              </span>
            </a>
          </li>
        ))}
      </ul>

      <h3 class="subtitulo" data-aparecer>Programas destacados</h3>
      <ul role="list" class="destacados" data-aparecer-grupo>
        {programas.map((p) => (
          <li>
            <a class="destacado" data-elevar href={`/programas/${p.slug}`}>
              <span class="destacado__portada">{p.imagen ? <Picture src={p.imagen} formats={["avif", "webp"]} widths={[320, 520]} sizes="(max-width: 640px) 75vw, 17rem" alt="" /> : <span class="destacado__sin" aria-hidden="true">{p.nombre}</span>}</span>
              <span class="destacado__nombre">{p.nombre}</span>
              <span class="destacado__dato">{dato(p, "Duración") ?? dato(p, "Modalidad")}</span>
              <Precio id={p.slug} class="destacado__precio" respaldo="" />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 3. POR QUÉ ELEGIRNOS -->
  <section class="seccion seccion--tarjeta" aria-labelledby="razones-titulo">
    <div class="contenedor">
      <div class="encabezado" data-aparecer>
        <h2 id="razones-titulo" class="titulo-bloque">Por qué elegirnos</h2>
        <p class="intro">Estudias en línea, pero no estudias solo.</p>
      </div>
      <ul role="list" class="razones" data-aparecer-grupo>
        {razones.map((r) => (
          <li class="razon">
            <span class="razon__icono" aria-hidden="true"><svg viewBox="0 0 40 40" set:html={iconos[r.icono]} /></span>
            <h3>{r.titulo}</h3>
            <p>{r.texto}</p>
          </li>
        ))}
      </ul>
      <div class="cta-medio" data-aparecer>
        <a class="btn btn--negro" href={enlaceWhatsapp(mensajeAsesor)} target="_blank" rel="noopener">Hablar con un asesor <span class="sr-only">(WhatsApp, se abre en una pestaña nueva)</span><span class="btn__flecha" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 14 14"><path d="M2 7h9M7.5 3 11.5 7l-4 4" fill="none" stroke="currentColor" stroke-width="2" /></svg></span></a>
      </div>
    </div>
  </section>

  <!-- 4. TESTIMONIOS: solo se muestra cuando hay testimonios reales autorizados (src/data/testimonios.ts) -->
  {testimonios.length > 0 && (
    <section class="seccion" aria-labelledby="testimonios-titulo">
      <div class="contenedor">
        <div class="encabezado" data-aparecer>
          <h2 id="testimonios-titulo" class="titulo-bloque">Lo que dicen nuestros estudiantes</h2>
        </div>
        <ul role="list" class="testimonios" data-aparecer-grupo>
          {testimonios.map((t) => (
            <li>
              <figure class="testimonio">
                <blockquote>«{t.texto}»</blockquote>
                <figcaption>
                  {t.foto && <Picture src={t.foto} formats={["avif", "webp"]} widths={[96, 192]} sizes="3rem" alt="" class="testimonio__foto" />}
                  <span><strong>{t.nombre}</strong>{t.programa}{t.pais && ` · ${paisPorCodigo[t.pais].nombre}`}{t.detalle && <small>{t.detalle}</small>}</span>
                </figcaption>
              </figure>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- 5. PREGUNTAS FRECUENTES -->
  <section class="seccion faq" aria-labelledby="faq-titulo">
    <div class="contenedor faq__rejilla">
      <div class="encabezado" data-aparecer>
        <h2 id="faq-titulo" class="titulo-bloque">Preguntas frecuentes</h2>
        <p class="intro">¿Tu duda no está aquí? Escríbenos y te respondemos.</p>
      </div>
      <div class="faq__lista" data-aparecer>
        {preguntas.map((q) => (
          <details class="faq__item" name="faq">
            <summary><span class="faq__pregunta">{q.p}</span><span class="faq__mas" aria-hidden="true"></span></summary>
            <p class="faq__respuesta">{q.r}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- 6. CONTACTO CON MAPA -->
  <section class="seccion seccion--tarjeta" id="contacto" aria-labelledby="contacto-titulo">
    <div class="contenedor contacto">
      <div class="contacto__texto" data-aparecer>
        <h2 id="contacto-titulo" class="titulo-bloque">Hablemos de lo que quieres aprender</h2>
        <p class="intro">Escríbenos por WhatsApp o déjanos tus datos y un asesor te contacta.</p>
        <a class="btn btn--amarillo contacto__wa" href={enlaceWhatsapp(mensajeAsesor)} target="_blank" rel="noopener">WhatsApp {sitio.whatsapp.visible}<span class="sr-only"> (se abre en una pestaña nueva)</span><span class="btn__flecha" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 14 14"><path d="M2 7h9M7.5 3 11.5 7l-4 4" fill="none" stroke="currentColor" stroke-width="2" /></svg></span></a>
        <div class="contacto__form">
          <h3 class="sr-only">Formulario de contacto</h3>
          <FormularioContacto modo="persona" />
        </div>
      </div>
      <div class="contacto__mapa" data-aparecer>
        <h3 class="contacto__mapa-titulo">Atendemos en 7 países</h3>
        <MapaPaises />
      </div>
    </div>
  </section>
</Base>

<style>
  /* Estilo claro y minimalista (ui-ux-pro-max: «Minimalism & Swiss») con la marca CE. Celular primero:
     la base es el teléfono y las consultas min-width amplían hacia tableta y escritorio. */
  .seccion--tarjeta { background: #fafafa; border-block: 1px solid var(--linea); }
  .titulo-bloque { font-size: clamp(1.75rem, 1.2rem + 2.2vw, 2.9rem); letter-spacing: -0.04em; line-height: 1.05; }
  .encabezado { display: grid; gap: var(--s-3); margin-bottom: var(--s-6); max-width: 40rem; }
  .encabezado .intro { margin: 0; }
  .circulo { display: grid; place-items: center; width: 2.25rem; height: 2.25rem; border-radius: 50%; background: var(--negro); color: var(--amarillo); flex: none; }

  /* 1. PORTADA */
  .hero { position: relative; overflow: hidden; background: radial-gradient(40rem 22rem at 50% 0%, rgba(255, 195, 0, 0.16), transparent 70%), var(--negro); color: var(--blanco); padding-block: clamp(3.5rem, 2rem + 6vw, 7.5rem); }
  .hero__centro { position: relative; z-index: 1; display: grid; justify-items: center; text-align: center; }
  .hero__marca { padding: 0.3rem 0.8rem; border-radius: 999px; background: rgba(255, 255, 255, 0.1); font-size: var(--t-xs); font-weight: 700; color: var(--amarillo); }
  .hero__titulo { margin-top: var(--s-5); font-size: clamp(2.6rem, 1.2rem + 6vw, 6.2rem); letter-spacing: -0.05em; line-height: 0.95; max-width: 11ch; }
  .acento { color: var(--amarillo); }
  .hero__sub { margin-top: var(--s-5); font-size: var(--t-lg); line-height: 1.5; color: #d9d9d9; max-width: 48ch; }
  .hero__cta { --alto: 3.5rem; width: 100%; max-width: 22rem; justify-content: center; gap: var(--s-3); margin-top: var(--s-6); font-size: var(--t-base); }
  .hero__secundario { display: inline-flex; align-items: center; min-height: 44px; margin-top: var(--s-2); color: #d9d9d9; font-size: var(--t-sm); text-underline-offset: 4px; text-decoration-color: var(--amarillo); }
  .hero__secundario:hover { color: var(--blanco); }
  .hero__flotantes { display: none; }
  .abrazo { --px: 0; --py: 0; --giro: 0deg; position: absolute; left: 50%; top: 50%; width: min(56rem, 120vw); aspect-ratio: 1; translate: -50% -50%; pointer-events: none; }
  .abrazo__luz { position: absolute; inset: 12%; border-radius: 50%; background: radial-gradient(circle, rgba(255, 195, 0, 0.2), transparent 62%); filter: blur(30px); transform: translate(calc(var(--px) * 12%), calc(var(--py) * 12%)); transition: transform 600ms var(--ease); }
  .abrazo__giro { position: absolute; inset: 0; transform: translate(calc(var(--px) * 18px), calc(var(--py) * 18px)) rotate(var(--giro)); transition: transform 1s var(--ease); }
  .abrazo__arco { width: 100%; height: 100%; overflow: visible; opacity: 0.45; }
  @media (prefers-reduced-motion: no-preference) {
    .abrazo__arco path { stroke-dasharray: 100; stroke-dashoffset: 100; animation: trazar var(--t-momento) var(--ease) 0.2s forwards; }
    @keyframes trazar { to { stroke-dashoffset: 0; } }
    @supports (animation-timeline: scroll()) {
      .abrazo__arco { animation: dial linear both; animation-timeline: scroll(root); animation-range: 0 100vh; }
      @keyframes dial { to { transform: rotate(-40deg); } }
    }
  }

  /* 2. SERVICIOS */
  .servicios { display: grid; gap: var(--s-4); }
  .servicio { display: grid; height: 100%; overflow: hidden; border-radius: var(--radio-l); background: var(--blanco); text-decoration: none; box-shadow: 0 0 0 1px var(--linea); transition: box-shadow var(--t-accion) var(--ease); }
  .servicio:hover { box-shadow: 0 0 0 1px var(--linea), 0 18px 36px -18px rgba(0, 0, 0, 0.25); }
  .servicio:focus-visible { outline-offset: 4px; }
  .servicio__imagen { display: block; aspect-ratio: 16 / 9; background: var(--bruma); }
  .servicio__imagen :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .servicio__cuerpo { display: grid; gap: var(--s-2); padding: var(--s-5); align-content: start; }
  .servicio__titulo { font-family: var(--font-marca); font-size: var(--t-lg); font-weight: 800; letter-spacing: -0.025em; }
  .servicio__texto { color: var(--gris-oscuro); font-size: var(--t-sm); }
  .servicio__cta { display: inline-flex; align-items: center; gap: var(--s-3); margin-top: var(--s-2); font-family: var(--font-marca); font-weight: 700; font-size: var(--t-sm); }

  .subtitulo { margin: var(--s-8) 0 var(--s-4); font-size: var(--t-xl); }
  .destacados { display: grid; grid-auto-flow: column; grid-auto-columns: min(17rem, 75vw); gap: var(--s-4); overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: var(--s-3); scrollbar-width: thin; position: relative; }
  .destacados > li { scroll-snap-align: start; }
  .destacado { display: grid; gap: var(--s-2); text-decoration: none; border-radius: var(--radio-l); }
  .destacado__portada { display: block; aspect-ratio: 16 / 9; border-radius: var(--radio-l); overflow: hidden; background: var(--negro); }
  .destacado__portada :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .destacado__sin { display: flex; align-items: flex-end; height: 100%; padding: var(--s-4); color: var(--blanco); font-family: var(--font-marca); font-weight: 800; font-size: var(--t-lg); letter-spacing: -0.03em; line-height: 1.05; background: radial-gradient(90% 120% at 100% 0%, rgba(45, 175, 115, 0.7), transparent 60%), var(--negro); }
  .destacado__nombre { font-family: var(--font-marca); font-weight: 700; letter-spacing: -0.02em; line-height: 1.25; }
  .destacado__dato { font-size: var(--t-xs); color: var(--gris-oscuro); }
  .destacado :global(.precio:empty) { display: none; }
  .destacado :global(.precio--con) { font-family: var(--font-marca); }

  /* 3. POR QUÉ ELEGIRNOS */
  .razones { display: grid; gap: var(--s-4); }
  .razon { display: grid; gap: var(--s-2); padding: var(--s-5); border-radius: var(--radio-l); background: var(--blanco); box-shadow: 0 0 0 1px var(--linea); }
  .razon__icono { display: grid; place-items: center; width: 3rem; height: 3rem; margin-bottom: var(--s-2); border-radius: 50%; background: var(--amarillo); }
  .razon__icono svg { width: 1.6rem; height: 1.6rem; fill: none; stroke: var(--negro); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .razon h3 { font-size: var(--t-lg); }
  .razon p { color: var(--gris-oscuro); font-size: var(--t-sm); }
  .cta-medio { display: flex; justify-content: center; margin-top: var(--s-7); }

  /* 4. TESTIMONIOS */
