---
import Base from "../layouts/Base.astro";
import Flecha from "../components/Flecha.astro";
import { sitio, enlaceWhatsapp } from "../data/sitio";
import { areas, programas, cursos, areaPorId } from "../data/programas";
import { Picture } from "astro:assets";
import fotoAuditorio from "../assets/fotos/evento-auditorio.jpg";
import fotoCharla from "../assets/fotos/evento-charla-ia-generativa.jpg";
import fotoRegistro from "../assets/fotos/evento-registro.jpg";
import fotoKits from "../assets/fotos/evento-entrega-kits.jpg";
import fotoTren from "../assets/fotos/equipo-tren-ce.jpg";
import fotoCinta from "../assets/fotos/evento-corte-de-cinta.jpg";
import fotoBatucada from "../assets/fotos/evento-batucada-banner.jpg";

const cuenta = (id: string) => programas.filter((p) => p.area === id).length + cursos.filter((c) => c.area === id).length;
const dato = (p: (typeof programas)[number], etiqueta: string) => p.datos.find((d) => d.etiqueta === etiqueta)?.valor;
const totalOferta = programas.length + cursos.length;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "EducationalOrganization",
  name: sitio.nombre,
  alternateName: sitio.sigla,
  url: `https://${sitio.dominio}`,
  logo: `https://${sitio.dominio}/brand/isologo-color.svg`,
  contactPoint: { "@type": "ContactPoint", telephone: "+51902148893", contactType: "customer service", availableLanguage: "es" },
};

// Beneficios que aparecen en los brochures y sílabos 2026 (F6, F10, F11, F12)
const senales = ["Clases en vivo con el docente", "Certificado digital con código QR", "Proyecto aplicado al cierre", "100 % en línea, desde cualquier país"];

// Preguntas frecuentes: cada respuesta se apoya en material oficial (docs/contenido-oficial.md)
const preguntas = [
  { p: "¿Las clases son en vivo?", r: "Sí. Los programas incluyen sesiones en vivo con el docente, y varios suman clases de refuerzo en vivo y material grabado para repasar cuando lo necesites." },
  { p: "¿Recibo un certificado al terminar?", r: "Sí. Al cumplir los requisitos de tu programa recibes un certificado digital de la Cámara de Comercio Exterior con código QR, para que cualquiera pueda verificar su autenticidad." },
  { p: "¿Cómo me inscribo?", r: "Escríbenos por WhatsApp o deja tus datos en el formulario de contacto. Un asesor te confirma horarios, inversión vigente y medios de pago, y te acompaña en la matrícula." },
  { p: "¿Dónde veo precios y fechas de inicio?", r: "La inversión y las fechas cambian según el grupo y las promociones vigentes. Por eso un asesor te comparte las condiciones actualizadas del programa que te interesa." },
  { p: "¿Puedo estudiar desde fuera del Perú?", r: "Sí. Los programas se dictan en línea, así que puedes seguirlos desde cualquier país. Confirma con tu asesor el horario de tu grupo según tu zona horaria." },
  { p: "¿Tienen capacitación para empresas?", r: "Sí. Coordinamos programas del catálogo para grupos de colaboradores, con condiciones corporativas. Cuéntanos cuántas personas son y qué necesitan aprender." },
];

---
<Base titulo={sitio.nombre} descripcion={sitio.descripcion} jsonLd={jsonLd}>
  <!-- PORTADA — «El abrazo»: el arco amarillo de la C envuelve a la comunidad CE -->
  <section class="hero" aria-labelledby="hero-titulo">
    <div class="contenedor hero__rejilla">
      <div class="hero__texto">
        <!-- Lema oficial de la campaña «Educación continua» -->
        <h1 id="hero-titulo" class="hero__titulo">Aprende, certifícate y avanza.</h1>
        <p class="hero__sub">Programas en vivo de comercio exterior, datos e inteligencia artificial, con un proyecto aplicado y certificado verificable de la Cámara de Comercio Exterior.</p>
        <div class="acciones">
          <a class="btn btn--negro" href="#programas">Ver programas <Flecha /></a>
          <a class="btn btn--contorno" href={enlaceWhatsapp("Hola, quiero que un asesor me ayude a elegir un programa.")} target="_blank" rel="noopener">Hablar con un asesor</a>
        </div>
      </div>

      <!-- Capas de profundidad: luz, foto y arco. Con el cursor, la C se orienta hacia la persona (scripts/efectos.ts) -->
      <div class="abrazo" data-abrazo>
        <div class="abrazo__luz" aria-hidden="true"></div>
        <figure class="abrazo__foto">
          <Picture src={fotoAuditorio} formats={["avif", "webp"]} widths={[480, 720, 960, 1280]} sizes="(max-width: 900px) 80vw, 40vw" loading="eager" fetchpriority="high" alt="Participantes y equipo de la Cámara de Comercio Exterior en un auditorio lleno al cierre de un evento" />
        </figure>
        <div class="abrazo__giro" aria-hidden="true">
          <svg class="abrazo__arco" viewBox="0 0 400 400">
            <path d="M 327.3 72.7 A 180 180 0 1 0 327.3 327.3" fill="none" stroke="var(--amarillo)" stroke-width="30" pathLength="100" />
          </svg>
        </div>
      </div>
    </div>

    <div class="contenedor">
      <ul role="list" class="senales">
        {senales.map((t, n) => <li style={`--n:${n}`}>{t}</li>)}
      </ul>
    </div>
  </section>

  <!-- PROGRAMAS — el tablero: un panel de salidas con los programas de temario completo -->
  <section class="seccion tablero-seccion sobre-oscuro" id="programas" aria-labelledby="programas-titulo">
    <div class="contenedor">
      <div class="cabeza">
        <h2 id="programas-titulo" class="titulo-seccion">Elige tu próximo destino profesional.</h2>
        <p class="intro">Cinco programas con temario completo, clases en vivo y un proyecto que demuestra lo que aprendiste.</p>
      </div>

      <div class="tablero">
        <div class="tablero__cabeza" aria-hidden="true">
          <span></span><span>Programa</span><span>Área</span><span>Duración</span><span>Modalidad</span><span></span>
        </div>
        <ol role="list" class="tablero__filas">
          {programas.map((p) => (
            <li data-revelar>
              <a class="tablero__fila" href={`/programas/${p.slug}`} style={`--c:${p.color ?? areaPorId[p.area].color}`}>
                <span class="tablero__portada">
                  {p.imagen && <Picture src={p.imagen} formats={["avif", "webp"]} widths={[240, 480]} sizes="(max-width: 1000px) 40vw, 9rem" alt="" />}
                </span>
                <span class="tablero__nombre">{p.nombre}</span>
                <span class="tablero__dato tablero__dato--area"><span class="tablero__rotulo">Área</span><i aria-hidden="true"></i>{areaPorId[p.area].nombre}</span>
                <span class="tablero__dato tablero__dato--duracion"><span class="tablero__rotulo">Duración</span>{dato(p, "Duración") ?? "Consulta con un asesor"}</span>
                <span class="tablero__dato tablero__dato--modalidad"><span class="tablero__rotulo">Modalidad</span>{dato(p, "Modalidad")}</span>
                <span class="tablero__ir"><span class="sr-only">Ver temario</span><svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M2 7h9M7.5 3 11.5 7l-4 4" fill="none" stroke="currentColor" stroke-width="2" /></svg></span>
              </a>
            </li>
          ))}
        </ol>
      </div>

      <div class="tablero__pie">
        <p>¿Buscas Python, SQL, marketing, AutoCAD o idiomas? Hay {totalOferta} programas y cursos en el catálogo.</p>
        <a class="btn btn--amarillo" href="/programas">Ver el catálogo completo <Flecha /></a>
      </div>
    </div>
  </section>

  <!-- COMUNIDAD: fotos de eventos presenciales de la CE -->
  <section class="seccion comunidad" aria-labelledby="comunidad-titulo">
    <div class="contenedor comunidad__rejilla">
      <div class="comunidad__texto">
        <!-- Frase del banner institucional de la CE -->
        <h2 id="comunidad-titulo" class="titulo-seccion">Conectamos talento, impulsamos desarrollo.</h2>
        <p class="intro">Además de los programas virtuales, llevamos la formación a espacios presenciales con talleres y charlas, como los workshops de inteligencia artificial y de importación.</p>
        <a class="btn btn--contorno comunidad__ver" href="/comunidad">Recorrer la galería <Flecha /></a>
      </div>
      <figure class="comunidad__foto comunidad__foto--principal" data-revelar="foto">
        <Picture src={fotoTren} formats={["avif", "webp"]} widths={[640, 1000, 1500, 2000]} sizes="(max-width: 860px) 100vw, 58vw" alt="Equipo de la Cámara de Comercio Exterior en un andén, junto a un tren con el logo de la CE" />
      </figure>
      <figure class="comunidad__foto comunidad__foto--charla" data-revelar="foto">
        <Picture src={fotoCharla} formats={["avif", "webp"]} widths={[480, 800, 1200]} sizes="(max-width: 860px) 100vw, 33vw" alt="Ponente explicando qué son las IA generativas frente a una proyección" />
      </figure>
      <figure class="comunidad__foto comunidad__foto--registro" data-revelar="foto">
        <Picture src={fotoRegistro} formats={["avif", "webp"]} widths={[480, 800, 1200]} sizes="(max-width: 860px) 50vw, 33vw" alt="Fila de estudiantes registrándose junto al banner de la Cámara de Comercio Exterior" />
      </figure>
      <figure class="comunidad__foto comunidad__foto--kits" data-revelar="foto">
        <Picture src={fotoKits} formats={["avif", "webp"]} widths={[480, 800, 1200]} sizes="(max-width: 860px) 50vw, 33vw" alt="Entrega de bolsas con el logo de la Cámara de Comercio Exterior a una participante" />
      </figure>
      <figure class="comunidad__foto comunidad__foto--cinta" data-revelar="foto">
        <Picture src={fotoCinta} formats={["avif", "webp"]} widths={[640, 1000, 1400]} sizes="(max-width: 860px) 100vw, 66vw" alt="Corte de cinta con el lema «Aprende, certifícate y avanza» y el logo de la Cámara de Comercio Exterior" />
      </figure>
      <figure class="comunidad__foto comunidad__foto--batucada" data-revelar="foto">
        <Picture src={fotoBatucada} formats={["avif", "webp"]} widths={[480, 800, 1200]} sizes="(max-width: 860px) 100vw, 33vw" alt="Batucada con sombreros amarillos junto al banner «Educación continua» de la Cámara de Comercio Exterior" />
      </figure>
    </div>
  </section>

  <!-- ÁREAS — directorio, como el letrero de un terminal -->
  <section class="seccion seccion--suave" aria-labelledby="areas-titulo">
    <div class="contenedor areas-rejilla">
      <div>
        <h2 id="areas-titulo" class="titulo-seccion">Seis áreas, un mismo enfoque práctico.</h2>
        <p class="intro">Elige un área y mira todos sus programas y cursos.</p>
      </div>
      <ul role="list" class="directorio">
        {areas.map((a) => (
          <li>
            <a class="directorio__fila" href={`/programas?area=${a.id}`} style={`--c:${a.color}`}>
              <i aria-hidden="true"></i>
              <span class="directorio__nombre">{a.nombre}</span>
              <span class="directorio__cuenta">{cuenta(a.id)} {cuenta(a.id) === 1 ? "programa" : "programas y cursos"}</span>
              <span class="directorio__ir" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 14 14"><path d="M2 7h9M7.5 3 11.5 7l-4 4" fill="none" stroke="currentColor" stroke-width="2" /></svg></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- PASOS (secuencia real: por eso van numerados) -->
  <section class="seccion" aria-labelledby="pasos-titulo">
    <div class="contenedor">
      <h2 id="pasos-titulo" class="titulo-seccion">Inscribirte toma tres pasos.</h2>
      <ol role="list" class="pasos">
        <li><span class="pasos__n" aria-hidden="true">1</span><h3>Elige tu programa</h3><p>Revisa el temario, la duración y la modalidad en la página de cada programa.</p></li>
        <li><span class="pasos__n" aria-hidden="true">2</span><h3>Habla con un asesor</h3><p>Por WhatsApp o el formulario: te confirma horarios, inversión vigente y medios de pago.</p></li>
        <li><span class="pasos__n" aria-hidden="true">3</span><h3>Matricúlate y empieza</h3><p>Recibes tus accesos y te unes a las clases en vivo de tu grupo.</p></li>
      </ol>
    </div>
  </section>

  <!-- EMPRESAS — banda amarilla -->
  <section class="empresas-banda" aria-labelledby="empresas-titulo">
    <div class="contenedor empresas">
      <h2 id="empresas-titulo" class="titulo-seccion">¿Necesitas capacitar a tu equipo?</h2>
      <div>
        <p class="empresas__texto">Coordinamos programas del catálogo para grupos de colaboradores, con condiciones corporativas. Cuéntanos cuántas personas son y qué necesitan aprender.</p>
        <div class="acciones">
          <a class="btn btn--negro" href="/empresas">Capacitación para empresas <Flecha /></a>
          <a class="btn btn--contorno" href={enlaceWhatsapp("Hola, quiero información sobre cursos para empresas y precio corporativo.")} target="_blank" rel="noopener">Escribir por WhatsApp</a>
        </div>
      </div>
    </div>
  </section>

  <!-- PREGUNTAS FRECUENTES -->
  <section class="seccion faq" aria-labelledby="faq-titulo">
    <div class="contenedor faq__rejilla">
      <div>
        <h2 id="faq-titulo" class="titulo-seccion">Lo que suelen preguntarnos.</h2>
        <p class="intro">¿Tu duda no está aquí? <a class="enlace" href="/contacto">Escríbenos</a> y te respondemos.</p>
      </div>
      <div class="faq__lista">
        {preguntas.map((q) => (
          <details class="faq__item" name="faq">
            <summary>
              <span class="faq__pregunta">{q.p}</span>
              <span class="faq__mas" aria-hidden="true"></span>
            </summary>
            <p class="faq__respuesta">{q.r}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .acciones { display: flex; flex-wrap: wrap; gap: var(--s-3); margin-top: var(--s-6); }
  .cabeza { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: var(--s-5) var(--s-7); align-items: end; margin-bottom: var(--s-8); }

  /* PORTADA */
  .hero { position: relative; overflow-x: clip; padding-block: clamp(1.5rem, 0.5rem + 3vw, 3.5rem) var(--s-8); }
  .hero__rejilla { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: var(--s-7); align-items: center; }
  .hero__titulo { font-size: var(--t-display); letter-spacing: -0.055em; line-height: 0.92; max-width: 9ch; }
  .hero__sub { margin-top: var(--s-6); font-size: var(--t-lg); line-height: 1.5; color: var(--gris-oscuro); max-width: 44ch; }

  /* El abrazo: tres capas de profundidad (luz, foto, arco) que se mueven a distinta velocidad */
  .abrazo { --px: 0; --py: 0; --giro: 0deg; position: relative; width: min(100%, 36rem); aspect-ratio: 1; justify-self: end; }
  /* Luz: un halo amarillo detrás de la foto que sigue al cursor */
  .abrazo__luz {
    position: absolute; inset: 4%; border-radius: 50%; pointer-events: none;
    background: radial-gradient(circle at calc(50% + var(--px) * 22%) calc(50% + var(--py) * 22%), rgba(255, 195, 0, 0.42), rgba(255, 195, 0, 0) 62%);
    filter: blur(28px); transition: background-position 600ms var(--ease);
  }
  .abrazo__foto {
    position: absolute; inset: 13%; margin: 0; border-radius: 50%; overflow: hidden; background: var(--bruma);
    box-shadow: 0 40px 70px -34px rgba(0, 0, 0, 0.45), 0 0 0 1px rgba(0, 0, 0, 0.04);
    transform: translate(calc(var(--px) * -10px), calc(var(--py) * -10px)); transition: transform 900ms var(--ease);
  }
  .abrazo__foto :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: 50% 60%; transition: transform 1.2s var(--ease); }
  /* Brillo sobre la foto, del lado de donde viene la luz */
  .abrazo__foto::after { content: ""; position: absolute; inset: 0; border-radius: inherit; pointer-events: none; background: radial-gradient(circle at calc(35% + var(--px) * 25%) calc(25% + var(--py) * 25%), rgba(255, 255, 255, 0.28), transparent 55%); mix-blend-mode: soft-light; }
  .abrazo:hover .abrazo__foto :global(img) { transform: scale(1.05); }
  .abrazo__giro { position: absolute; inset: 0; transform: translate(calc(var(--px) * 16px), calc(var(--py) * 16px)) rotate(var(--giro)); transition: transform 1s var(--ease); }
  .abrazo__arco { width: 100%; height: 100%; overflow: visible; filter: drop-shadow(0 18px 24px rgba(172, 88, 28, 0.25)); }

  @media (prefers-reduced-motion: no-preference) {
    /* Entrada orquestada: foto → arco que se dibuja → título (efectos.ts) → texto, botones y placas */
    .abrazo__arco path { stroke-dasharray: 100; stroke-dashoffset: 100; animation: trazar var(--t-momento) var(--ease) 0.25s forwards; }
    .abrazo__foto { animation: aparecer 1.1s var(--ease) both; }
    .abrazo__luz { animation: encender 1.8s var(--ease) 0.6s both; }
    .hero__sub { animation: subir var(--t-entrada) var(--ease) 0.55s both; }
    .hero .acciones { animation: subir var(--t-entrada) var(--ease) 0.7s both; }
    .senales li { animation: subir var(--t-entrada) var(--ease) calc(0.9s + var(--n) * 80ms) both; }
    @keyframes trazar { to { stroke-dashoffset: 0; } }
    @keyframes aparecer { from { opacity: 0; transform: scale(0.92); } }
    @keyframes encender { from { opacity: 0; } }
    @keyframes subir { from { opacity: 0; transform: translateY(14px); } }
    /* Primer desplazamiento: el arco gira como un dial y el abrazo se hunde mientras el tablero sube encima */
    @supports (animation-timeline: scroll()) {
      .abrazo__arco { animation: dial linear both; animation-timeline: scroll(root); animation-range: 0 100vh; }
      .abrazo { animation: hundirse linear both; animation-timeline: scroll(root); animation-range: 0 90vh; }
      @keyframes dial { to { transform: rotate(-32deg); } }
      @keyframes hundirse { to { transform: translateY(12%) scale(0.92); } }
    }
  }

  /* Señales: beneficios como placas de un letrero */
  .senales { display: flex; flex-wrap: wrap; gap: var(--s-2); margin-top: var(--s-8); }
  .senales li { padding: 0.55rem 0.9rem; border-radius: var(--radio); background: var(--bruma); font-family: var(--font-marca); font-size: var(--t-sm); font-weight: 600; letter-spacing: -0.01em; }
  .senales li::before { content: ""; display: inline-block; width: 0.55rem; height: 0.55rem; margin-right: 0.55rem; border-radius: 50%; background: var(--amarillo); box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.15); }

  /* TABLERO */
  /* Capítulos (tablero y empresas): bloques de color con esquinas suaves, separados del borde de la ventana */
  .tablero-seccion, .empresas-banda { margin-inline: clamp(0.5rem, 0.2rem + 0.8vw, 1rem); border-radius: var(--radio-l); }
  .tablero-seccion { background: var(--negro); color: var(--blanco); }
  .tablero__cabeza, .tablero__fila { display: grid; grid-template-columns: 9rem minmax(0, 2.4fr) minmax(0, 1.3fr) minmax(0, 1.1fr) minmax(0, 1.7fr) 3rem; gap: var(--s-5); align-items: center; }
  /* Miniatura de la portada oficial; si un programa aún no tiene portada, queda un bloque con el color de su área */
  .tablero__portada { display: block; aspect-ratio: 16 / 9; border-radius: var(--radio); overflow: hidden; background: linear-gradient(135deg, var(--c), #000 85%); }
  .tablero__portada :global(img) { width: 100%; height: 100%; object-fit: cover; transition: scale 600ms var(--ease); }
  .tablero__fila:hover .tablero__portada :global(img) { scale: 1.06; }
  .tablero__cabeza { padding: 0 var(--s-5) var(--s-3); font-size: var(--t-xs); color: #a6a6a6; border-bottom: 1px solid rgba(255, 255, 255, 0.2); }
  .tablero__filas { perspective: 900px; }
  .tablero__filas li { border-bottom: 1px solid rgba(255, 255, 255, 0.14); }
  .tablero__fila {
    min-height: 6rem; padding: var(--s-4) var(--s-5); border-radius: var(--radio); text-decoration: none; color: var(--blanco);
    transition: background-color var(--t-accion) var(--ease), color var(--t-accion) var(--ease);
  }
  .tablero__nombre { font-family: var(--font-marca); font-size: clamp(1.15rem, 0.9rem + 0.8vw, 1.6rem); font-weight: 700; letter-spacing: -0.03em; line-height: 1.15; }
  .tablero__dato { font-size: var(--t-sm); color: #d9d9d9; line-height: 1.35; transition: color var(--t-accion) var(--ease); }
  .tablero__dato i { display: inline-block; width: 0.55rem; height: 0.55rem; margin-right: 0.5rem; border-radius: 50%; background: var(--c); box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.35); }
  .tablero__rotulo { display: none; }
  .tablero__ir { display: grid; place-items: center; width: 2.75rem; height: 2.75rem; border-radius: 50%; background: var(--amarillo); color: var(--negro); transition: background-color var(--t-accion) var(--ease), color var(--t-accion) var(--ease), transform var(--t-accion) var(--ease); }
  /* Fila elegida: se enciende en amarillo, como el vuelo que buscas en el panel */
  .tablero__fila:hover, .tablero__fila:focus-visible { background: var(--amarillo); color: var(--negro); }
  .tablero__fila:hover .tablero__dato, .tablero__fila:focus-visible .tablero__dato { color: var(--negro); }
  .tablero__fila:hover .tablero__ir, .tablero__fila:focus-visible .tablero__ir { background: var(--negro); color: var(--amarillo); transform: translateX(4px); }
  .tablero__fila:focus-visible { outline-offset: 2px; }
  /* Entrada: cada fila gira como una paleta del panel */
  :global(.efectos) .tablero__filas li[data-revelar] { opacity: 0; transform: rotateX(-80deg); transform-origin: 50% 0; transition: transform 900ms var(--ease), opacity 500ms var(--ease); transition-delay: var(--retraso, 0ms); }
  :global(.efectos) .tablero__filas li[data-revelar]:global(.visible) { opacity: 1; transform: none; }
  .tablero__pie { display: flex; justify-content: space-between; align-items: center; gap: var(--s-5); flex-wrap: wrap; margin-top: var(--s-7); }
  .tablero__pie p { color: #d9d9d9; max-width: 48ch; }

  /* COMUNIDAD: mosaico de fotos reales */
  .comunidad__rejilla {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--s-4);
