---
// Inicio — estructura aprobada (oct-2026): portada con un botón, servicios, por qué elegirnos, testimonios,
// preguntas frecuentes y contacto con mapa. Diagramación con la dirección «Apple» de DESIGN.md (bloques que
// alternan claro y oscuro) con los colores y tipografías del manual de la CE; animaciones con Motion. Celular primero.
import Base from "../layouts/Base.astro";
import Precio from "../components/Precio.astro";
import FormularioContacto from "../components/FormularioContacto.astro";
import MapaPaises from "../components/MapaPaises.astro";
import { sitio, enlaceWhatsapp } from "../data/sitio";
import { programas, cursos } from "../data/programas";
import { oferta } from "../data/oferta";
import { testimonios } from "../data/testimonios";
import { paisPorCodigo } from "../data/paises";
import { Picture } from "astro:assets";
import fotoAuditorio from "../assets/fotos/evento-auditorio.jpg";
import fotoCharla from "../assets/fotos/evento-charla-ia-generativa.jpg";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "EducationalOrganization",
  name: sitio.nombre,
  alternateName: sitio.sigla,
  url: `https://${sitio.dominio}`,
  logo: `https://${sitio.dominio}/brand/isologo-color.svg`,
  contactPoint: { "@type": "ContactPoint", telephone: "+51902148893", contactType: "customer service", availableLanguage: "es" },
};

const mensajeAsesor = "Hola, quiero que un asesor me ayude a elegir un programa.";
const porNombre = (n: string) => oferta.find((o) => o.nombre === n)!;
// Escaparate de la portada: la del centro se ve siempre; las laterales, desde tableta
const escaparate = ["Programa Completo de Excel", "Programa Profesional de Inteligencia Artificial Aplicada", "Academia de Importadores"].map(porNombre);
const dato = (p: (typeof programas)[number], etiqueta: string) => p.datos.find((d) => d.etiqueta === etiqueta)?.valor;
const prog = (slug: string) => programas.find((p) => p.slug === slug)!;
// Lema corto: la primera idea del resumen oficial (hasta los dos puntos)
const lema = (r: string) => r.split(":")[0].replace(/\.$/, "") + ".";
const consulta = (nombre: string) => enlaceWhatsapp(`Hola, quiero información sobre ${nombre}.`);

// Bloques de producto a todo el ancho, como los de apple.com: nombre, lema, dos acciones y la portada grande
const productos = [
  { p: prog("inteligencia-artificial-aplicada"), titulo: "Inteligencia Artificial Aplicada", tono: "bruma", lema: "Convierte ideas y tareas en soluciones con ChatGPT, Gemini y Claude." },
  { p: prog("academia-de-importadores"), titulo: "Academia de Importadores", tono: "oscuro" },
].map((b) => ({ ...b, lema: b.lema ?? lema(b.p.resumen), dato: dato(b.p, "Duración") }));

// Servicios en mosaicos de dos columnas (rejilla de apple.com), alternando claro y oscuro
const pbi = prog("power-bi"), excel = prog("excel-completo"), analista = prog("analista-excel-ia");
const mosaicos = [
  { tono: "oscuro", eyebrow: `Programa · ${dato(pbi, "Duración")}`, titulo: pbi.nombre, lema: lema(pbi.resumen), imagen: pbi.imagen, tipo: "portada", principal: { texto: "Más información", href: `/programas/${pbi.slug}` }, secundaria: { texto: "Consultar", href: consulta(pbi.nombre), externo: true } },
  { tono: "bruma", eyebrow: "Programa", titulo: "Excel completo", lema: lema(excel.resumen), imagen: excel.imagen, tipo: "portada", principal: { texto: "Más información", href: `/programas/${excel.slug}` }, secundaria: { texto: "Consultar", href: consulta(excel.nombre), externo: true } },
  { tono: "bruma", eyebrow: `${cursos.length} cursos`, titulo: "Cursos por área", lema: "Datos, IA, marketing, diseño, ingeniería, gestión e idiomas.", imagen: porNombre("Python").imagen, tipo: "portada", principal: { texto: "Ver cursos", href: "/programas" }, secundaria: { texto: "Consultar", href: consulta("los cursos por área"), externo: true } },
  { tono: "oscuro", eyebrow: `Programa · ${dato(analista, "Duración")}`, titulo: "Analista de Excel Intelligence + IA", lema: "Excel desde cero hasta el análisis con Copilot.", imagen: analista.imagen, tipo: "portada", principal: { texto: "Más información", href: `/programas/${analista.slug}` }, secundaria: { texto: "Consultar", href: consulta(analista.nombre), externo: true } },
  { tono: "bruma", eyebrow: "Empresas", titulo: "Capacitación para tu equipo", lema: "Programas del catálogo para grupos de colaboradores, con precio corporativo.", imagen: fotoAuditorio, alt: "Auditorio lleno en un evento de la Cámara de Comercio Exterior", tipo: "foto", principal: { texto: "Pedir presupuesto", href: "/empresas" }, secundaria: { texto: "Escríbenos", href: enlaceWhatsapp("Hola, quiero capacitación para mi equipo."), externo: true } },
  { tono: "oscuro", eyebrow: "Presencial", titulo: "Workshops", lema: "Charlas y talleres presenciales, como los de IA generativa y de importación.", imagen: fotoCharla, alt: "Ponente en un workshop de IA generativa", tipo: "foto", principal: { texto: "Consultar fechas", href: enlaceWhatsapp("Hola, quiero información sobre los próximos workshops presenciales."), externo: true } },
] as const;

// Por qué elegirnos: solo hechos del material oficial (brochures y sílabos 2026)
const razones = [
  { icono: "vivo", titulo: "Clases en vivo", texto: "Aprendes con el docente en tiempo real y resuelves tus dudas en clase." },
  { icono: "proyecto", titulo: "Proyecto aplicado", texto: "Cierras cada programa con un proyecto real que demuestra lo que aprendiste." },
  { icono: "certificado", titulo: "Certificado con código QR", texto: "Certificado digital de la Cámara de Comercio Exterior que cualquier empresa puede verificar." },
  { icono: "mundo", titulo: "100 % en línea", texto: "Estudia desde Perú o desde cualquier país, con grabaciones para repasar." },
  { icono: "paises", titulo: "Atención en 7 países", texto: "Perú, Ecuador, Costa Rica, Colombia, México, Panamá y Argentina." },
  { icono: "asesor", titulo: "Asesoría por WhatsApp", texto: "Un asesor te ayuda a elegir y te confirma horarios e inversión vigente." },
];
const iconos: Record<string, string> = {
  vivo: '<circle cx="20" cy="20" r="4"/><path d="M12.5 12.5a10.6 10.6 0 0 0 0 15M27.5 12.5a10.6 10.6 0 0 1 0 15M7.5 7.5a17.7 17.7 0 0 0 0 25M32.5 7.5a17.7 17.7 0 0 1 0 25"/>',
  proyecto: '<circle cx="20" cy="20" r="14"/><circle cx="20" cy="20" r="8"/><circle cx="20" cy="20" r="2"/><path d="M20 2v6M20 32v6M2 20h6M32 20h6"/>',
  certificado: '<rect x="6" y="5" width="22" height="28" rx="2"/><path d="M11 12h12M11 17h8"/><circle cx="29" cy="27" r="6"/><path d="m26 32-1 6 4-2 4 2-1-6"/>',
  mundo: '<rect x="5" y="8" width="30" height="20" rx="2"/><path d="M14 33h12M20 28v5"/>',
  paises: '<circle cx="20" cy="20" r="15"/><path d="M5 20h30M20 5c4.5 4.2 6.5 9.2 6.5 15S24.5 30.8 20 35c-4.5-4.2-6.5-9.2-6.5-15S15.5 9.2 20 5Z"/>',
  asesor: '<path d="M8 30l2.2-6.4A12 12 0 1 1 15 28.7Z"/><path d="M15 17h10M15 22h6"/>',
};

const preguntas = [
  { p: "¿Las clases son en vivo?", r: "Sí. Los programas incluyen sesiones en vivo con el docente, y varios suman clases de refuerzo en vivo y material grabado para repasar cuando lo necesites." },
  { p: "¿Recibo un certificado al terminar?", r: "Sí. Al cumplir los requisitos de tu programa recibes un certificado digital de la Cámara de Comercio Exterior con código QR, para que cualquiera pueda verificar su autenticidad." },
  { p: "¿Cómo me inscribo?", r: "Escríbenos por WhatsApp o deja tus datos en el formulario de contacto. Un asesor te confirma horarios, inversión vigente y medios de pago, y te acompaña en la matrícula." },
  { p: "¿Dónde veo precios y fechas de inicio?", r: "La inversión y las fechas cambian según el grupo y las promociones vigentes. Por eso un asesor te comparte las condiciones actualizadas del programa que te interesa." },
  { p: "¿Puedo estudiar desde fuera del Perú?", r: "Sí. Los programas se dictan en línea, así que puedes seguirlos desde cualquier país. Confirma con tu asesor el horario de tu grupo según tu zona horaria." },
  { p: "¿Tienen capacitación para empresas?", r: "Sí. Coordinamos programas del catálogo para grupos de colaboradores, con condiciones corporativas. Cuéntanos cuántas personas son y qué necesitan aprender." },
];
---
<Base titulo={sitio.nombre} descripcion={sitio.descripcion} jsonLd={jsonLd}>
  <!-- 1. PORTADA (bloque oscuro): frase fuerte, un solo botón y el escaparate de portadas -->
  <section class="bloque bloque--oscuro hero sobre-oscuro" aria-labelledby="hero-titulo">
    <!-- «El abrazo»: el arco de la C se dibuja, se orienta hacia el cursor y gira al bajar (scripts/efectos.ts) -->
    <div class="abrazo" data-abrazo aria-hidden="true">
      <div class="abrazo__luz"></div>
      <div class="abrazo__giro">
        <svg class="abrazo__arco" viewBox="0 0 400 400"><path d="M 327.3 72.7 A 180 180 0 1 0 327.3 327.3" fill="none" stroke="var(--amarillo)" stroke-width="16" pathLength="100" /></svg>
      </div>
    </div>
    <div class="contenedor hero__centro">
      <p class="hero__marca">Educación continua</p>
      <!-- Lema oficial de la campaña «Educación continua» -->
      <h1 id="hero-titulo" class="hero__titulo">Aprende, certifícate y <span class="acento">avanza.</span></h1>
      <p class="hero__sub">Programas en vivo de comercio exterior, datos e inteligencia artificial, con certificado digital verificable.</p>
      <div class="acciones">
        <a class="btn btn--amarillo hero__cta" href={enlaceWhatsapp(mensajeAsesor)} target="_blank" rel="noopener">
          <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2c-1.5 0-3-.4-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.4.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2l-.5-.3Z"/></svg>
          Escríbenos por WhatsApp
          <span class="sr-only"> (se abre en una pestaña nueva)</span>
        </a>
        <a class="pastilla pastilla--borde" href="/programas">Ver programas</a>
      </div>
    </div>
    <!-- Escaparate: las portadas oficiales son «el producto»; la única sombra del sistema va aquí -->
    <div class="escaparate" aria-hidden="true">
      {escaparate.map((f, i) => (
        <div class={`escaparate__pieza escaparate__pieza--${i + 1}`}>
          <Picture src={f.imagen!} formats={["avif", "webp"]} widths={[360, 640, 960]} sizes="(max-width: 640px) 86vw, 38rem" loading={i === 1 ? "eager" : "lazy"} alt="" />
        </div>
      ))}
    </div>
  </section>

  <!-- 2. SERVICIOS. Primero, bloques de producto a todo el ancho (como apple.com) -->
  <h2 class="sr-only" id="servicios-titulo">Lo que ofrecemos</h2>
  {productos.map((b) => (
    <section class={`producto producto--${b.tono} ${b.tono === "oscuro" ? "sobre-oscuro" : ""}`} aria-label={b.titulo}>
      <div class="producto__texto" data-aparecer>
        <p class="eyebrow">Programa{b.dato && ` · ${b.dato}`}</p>
        <h3 class="producto__nombre">{b.titulo}</h3>
        <p class="producto__lema">{b.lema}</p>
        <div class="acciones">
          <a class="pastilla pastilla--llena" href={`/programas/${b.p.slug}`}>Más información<span class="sr-only"> sobre {b.titulo}</span></a>
          <a class="pastilla pastilla--borde" href={consulta(b.p.nombre)} target="_blank" rel="noopener">Consultar<span class="sr-only"> por WhatsApp (se abre en una pestaña nueva)</span></a>
        </div>
        <Precio id={b.p.slug} class="producto__precio" respaldo="" />
      </div>
      {b.p.imagen && (
        <div class="producto__imagen" data-aparecer>
          <Picture src={b.p.imagen} formats={["avif", "webp"]} widths={[480, 800, 1200]} sizes="(max-width: 640px) 90vw, 56rem" alt="" />
        </div>
      )}
    </section>
  ))}

  <!-- Después, la rejilla de mosaicos de dos columnas -->
  <section class="rejilla" aria-label="Más programas y servicios">
    <ul role="list" class="mosaicos">
      {mosaicos.map((m) => (
        <li class={`mosaico mosaico--${m.tono} mosaico--${m.tipo} ${m.tono === "oscuro" ? "sobre-oscuro" : ""}`}>
          <div class="mosaico__texto">
            <p class="eyebrow">{m.eyebrow}</p>
            <h3 class="mosaico__nombre">{m.titulo}</h3>
            <p class="mosaico__lema">{m.lema}</p>
            <div class="acciones">
              <a class="pastilla pastilla--llena" href={m.principal.href} {...("externo" in m.principal ? { target: "_blank", rel: "noopener" } : {})}>{m.principal.texto}{m.principal.texto === "Más información" && <span class="sr-only"> sobre {m.titulo}</span>}{"externo" in m.principal && <span class="sr-only"> por WhatsApp (se abre en una pestaña nueva)</span>}</a>
              {"secundaria" in m && <a class="pastilla pastilla--borde" href={m.secundaria.href} {...("externo" in m.secundaria ? { target: "_blank", rel: "noopener" } : {})}>{m.secundaria.texto}{"externo" in m.secundaria && <span class="sr-only"> por WhatsApp (se abre en una pestaña nueva)</span>}</a>}
            </div>
          </div>
          {m.imagen ? (
            <div class="mosaico__imagen">
              <Picture src={m.imagen} formats={["avif", "webp"]} widths={[480, 800]} sizes="(max-width: 760px) 92vw, 46vw" alt={"alt" in m ? m.alt : ""} />
            </div>
          ) : (
            <p class="mosaico__tipografia" aria-hidden="true">Excel<br />+ IA</p>
          )}
        </li>
      ))}
    </ul>
  </section>

  <!-- 3. POR QUÉ ELEGIRNOS (bloque oscuro) -->
  <section class="bloque bloque--oscuro sobre-oscuro" aria-labelledby="razones-titulo">
    <div class="contenedor">
      <div class="bloque__cabecera" data-aparecer>
        <h2 id="razones-titulo" class="bloque__titulo">Por qué elegirnos</h2>
        <p class="bloque__lema">Estudias en línea, pero no estudias solo.</p>
      </div>
      <ul role="list" class="razones" data-aparecer-grupo>
        {razones.map((r) => (
          <li class="razon">
            <span class="razon__icono" aria-hidden="true"><svg viewBox="0 0 40 40" set:html={iconos[r.icono]} /></span>
            <h3>{r.titulo}</h3>
            <p>{r.texto}</p>
          </li>
        ))}
      </ul>
      <div class="cta-medio" data-aparecer>
        <a class="btn btn--amarillo" href={enlaceWhatsapp(mensajeAsesor)} target="_blank" rel="noopener">Hablar con un asesor <span class="sr-only">(WhatsApp, se abre en una pestaña nueva)</span><span class="btn__flecha" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 14 14"><path d="M2 7h9M7.5 3 11.5 7l-4 4" fill="none" stroke="currentColor" stroke-width="2" /></svg></span></a>
      </div>
    </div>
  </section>

  <!-- 4. TESTIMONIOS: solo se muestra cuando hay testimonios reales autorizados (src/data/testimonios.ts) -->
  {testimonios.length > 0 && (
    <section class="bloque" aria-labelledby="testimonios-titulo">
      <div class="contenedor">
        <div class="bloque__cabecera" data-aparecer>
          <h2 id="testimonios-titulo" class="bloque__titulo">Lo que dicen nuestros estudiantes</h2>
        </div>
        <ul role="list" class="testimonios" data-aparecer-grupo>
          {testimonios.map((t) => (
            <li>
              <figure class="testimonio">
                <blockquote>«{t.texto}»</blockquote>
                <figcaption>
                  {t.foto && <Picture src={t.foto} formats={["avif", "webp"]} widths={[96, 192]} sizes="3rem" alt="" class="testimonio__foto" />}
                  <span><strong>{t.nombre}</strong>{t.programa}{t.pais && ` · ${paisPorCodigo[t.pais].nombre}`}{t.detalle && <small>{t.detalle}</small>}</span>
                </figcaption>
              </figure>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- 5. PREGUNTAS FRECUENTES (bloque claro, columna de lectura) -->
  <section class="bloque faq" aria-labelledby="faq-titulo">
    <div class="contenedor contenedor--lectura">
      <div class="bloque__cabecera" data-aparecer>
        <h2 id="faq-titulo" class="bloque__titulo">Preguntas frecuentes</h2>
        <p class="bloque__lema">¿Tu duda no está aquí? Escríbenos y te respondemos.</p>
      </div>
      <div class="faq__lista" data-aparecer>
        {preguntas.map((q) => (
          <details class="faq__item" name="faq">
            <summary><span class="faq__pregunta">{q.p}</span><span class="faq__mas" aria-hidden="true"></span></summary>
            <p class="faq__respuesta">{q.r}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- 6. CONTACTO CON MAPA (bloque bruma) -->
  <section class="bloque bloque--bruma" id="contacto" aria-labelledby="contacto-titulo">
    <div class="contenedor">
      <div class="bloque__cabecera" data-aparecer>
        <h2 id="contacto-titulo" class="bloque__titulo">Hablemos de lo que quieres aprender</h2>
        <p class="bloque__lema">Escríbenos por WhatsApp o déjanos tus datos y un asesor te contacta.</p>
        <a class="btn btn--negro contacto__wa" href={enlaceWhatsapp(mensajeAsesor)} target="_blank" rel="noopener">WhatsApp {sitio.whatsapp.visible}<span class="sr-only"> (se abre en una pestaña nueva)</span><span class="btn__flecha" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 14 14"><path d="M2 7h9M7.5 3 11.5 7l-4 4" fill="none" stroke="currentColor" stroke-width="2" /></svg></span></a>
      </div>
      <div class="contacto">
        <div class="tarjeta contacto__form" data-aparecer>
          <h3 class="contacto__subtitulo">Déjanos tus datos</h3>
          <FormularioContacto modo="persona" />
        </div>
        <div class="tarjeta contacto__mapa" data-aparecer>
          <h3 class="contacto__subtitulo">Atendemos en 7 países</h3>
          <MapaPaises />
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Dirección «Apple» (DESIGN.md), con la marca de la CE. Como apple.com: cabecera delgada, bloques de producto a todo
     el ancho que alternan claro y oscuro, una rejilla de mosaicos de dos columnas y, en cada bloque, nombre, lema y dos
     pastillas. Un solo color de acción (amarillo) y una sola sombra (la de las portadas). */
  .bloque { padding-block: clamp(4rem, 2.6rem + 5vw, 7rem); background: var(--blanco); }
  .bloque--bruma { background: var(--bruma); }
  .bloque--oscuro { background: var(--negro); color: var(--blanco); }
  .contenedor--lectura { max-width: 61.25rem; }
  .bloque__cabecera { display: grid; justify-items: center; gap: var(--s-3); max-width: 46rem; margin: 0 auto var(--s-7); text-align: center; }
  .bloque__titulo { font-size: clamp(2rem, 1.3rem + 3vw, 3.5rem); letter-spacing: -0.045em; line-height: 1.02; }
  .bloque__lema { font-size: var(--t-lg); line-height: 1.45; color: var(--gris-oscuro); max-width: 40ch; }
  .bloque--oscuro .bloque__lema { color: #d9d9d9; }

  /* Pastillas de apple.com: chicas, una llena (acción) y otra con borde */
  .acciones { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--s-3); }
  .pastilla {
    display: inline-flex; align-items: center; justify-content: center; min-height: 44px; padding: 0 1.35rem; border: 1.5px solid transparent; border-radius: 999px;
    font-family: var(--font-marca); font-size: var(--t-sm); font-weight: 700; letter-spacing: -0.01em; text-decoration: none; white-space: nowrap;
    transition: background-color var(--t-accion) var(--ease), color var(--t-accion) var(--ease), border-color var(--t-accion) var(--ease);
  }
  .pastilla:active { transform: scale(0.97); }
  .pastilla--llena { background: var(--amarillo); color: var(--negro); }
  .pastilla--llena:hover { background: #ffd240; }
  .pastilla--borde { border-color: var(--negro); color: var(--negro); }
  .pastilla--borde:hover { background: var(--negro); color: var(--blanco); }
  .sobre-oscuro .pastilla--borde { border-color: var(--blanco); color: var(--blanco); }
  .sobre-oscuro .pastilla--borde:hover { background: var(--blanco); color: var(--negro); }
  .eyebrow { font-family: var(--font-marca); font-size: var(--t-sm); font-weight: 700; color: var(--gris-oscuro); }
  .sobre-oscuro .eyebrow { color: var(--amarillo); }

  /* 1. PORTADA */
  .hero { position: relative; overflow: hidden; padding-bottom: 0; padding-top: clamp(3rem, 2rem + 4vw, 5.5rem); }
  .hero__centro { position: relative; z-index: 1; display: grid; justify-items: center; text-align: center; }
  .hero__marca { padding: 0.3rem 0.8rem; border-radius: 999px; background: rgba(255, 255, 255, 0.1); font-size: var(--t-xs); font-weight: 700; color: var(--amarillo); }
  .hero__titulo { margin-top: var(--s-4); font-size: clamp(2.6rem, 1.4rem + 4.8vw, 5.25rem); letter-spacing: -0.05em; line-height: 0.98; max-width: 12ch; }
  .acento { color: var(--amarillo); }
  .hero__sub { margin-top: var(--s-4); font-size: clamp(1.15rem, 1rem + 0.6vw, 1.5rem); line-height: 1.35; color: #d9d9d9; max-width: 34ch; }
  .hero .acciones { margin-top: var(--s-5); }
  .hero__cta { --alto: 2.75rem; gap: var(--s-2); padding-inline: 1.35rem; }

