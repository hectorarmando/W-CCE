---
import Base from "../layouts/Base.astro";
import Flecha from "../components/Flecha.astro";
import { sitio, enlaceWhatsapp } from "../data/sitio";
import { areas, programas, cursos, areaPorId } from "../data/programas";
import { Picture } from "astro:assets";
import fotoAuditorio from "../assets/fotos/evento-auditorio.jpg";
import fotoCharla from "../assets/fotos/evento-charla-ia-generativa.jpg";
import fotoRegistro from "../assets/fotos/evento-registro.jpg";
import fotoKits from "../assets/fotos/evento-entrega-kits.jpg";
import fotoTren from "../assets/fotos/equipo-tren-ce.jpg";
import fotoCinta from "../assets/fotos/evento-corte-de-cinta.jpg";
import fotoBatucada from "../assets/fotos/evento-batucada-banner.jpg";

const [destacado, ...resto] = programas;
const cuenta = (id: string) => programas.filter((p) => p.area === id).length + cursos.filter((c) => c.area === id).length;
const dos = (n: number) => String(n).padStart(2, "0");

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "EducationalOrganization",
  name: sitio.nombre,
  alternateName: sitio.sigla,
  url: `https://${sitio.dominio}`,
  logo: `https://${sitio.dominio}/brand/isologo-color.svg`,
  contactPoint: { "@type": "ContactPoint", telephone: "+51902148893", contactType: "customer service", availableLanguage: "es" },
};

// Beneficios que aparecen en los brochures y sílabos 2026 (F6, F10, F11, F12)
const formas = [
  { icono: "vivo", titulo: "Clases en vivo", texto: "Aprendes con el docente en tiempo real y resuelves tus dudas en clase. Varios programas suman clases de refuerzo en vivo." },
  { icono: "grabado", titulo: "Clases grabadas y recursos", texto: "Repasa cuando lo necesites: grabaciones, plantillas y materiales del programa." },
  { icono: "proyecto", titulo: "Proyectos aplicados", texto: "Cierras con un proyecto real: un capstone en Power BI, un sistema de IA o tu propio proyecto de importación." },
  { icono: "certificado", titulo: "Certificado verificable", texto: "Certificado digital de la Cámara de Comercio Exterior con código QR para validar su autenticidad." },
];

// Preguntas frecuentes: cada respuesta se apoya en material oficial (docs/contenido-oficial.md)
const preguntas = [
  { p: "¿Las clases son en vivo?", r: "Sí. Los programas incluyen sesiones en vivo con el docente, y varios suman clases de refuerzo en vivo y material grabado para repasar cuando lo necesites." },
  { p: "¿Recibo un certificado al terminar?", r: "Sí. Al cumplir los requisitos de tu programa recibes un certificado digital de la Cámara de Comercio Exterior con código QR, para que cualquiera pueda verificar su autenticidad." },
  { p: "¿Cómo me inscribo?", r: "Escríbenos por WhatsApp o deja tus datos en el formulario de contacto. Un asesor te confirma horarios, inversión vigente y medios de pago, y te acompaña en la matrícula." },
  { p: "¿Dónde veo precios y fechas de inicio?", r: "La inversión y las fechas cambian según el grupo y las promociones vigentes. Por eso un asesor te comparte las condiciones actualizadas del programa que te interesa." },
  { p: "¿Puedo estudiar desde fuera del Perú?", r: "Sí. Los programas se dictan en línea, así que puedes seguirlos desde cualquier país. Confirma con tu asesor el horario de tu grupo según tu zona horaria." },
  { p: "¿Tienen capacitación para empresas?", r: "Sí. Coordinamos programas del catálogo para grupos de colaboradores, con condiciones corporativas. Cuéntanos cuántas personas son y qué necesitan aprender." },
];

const iconos: Record<string, string> = {
  vivo: '<circle cx="20" cy="20" r="4"/><path d="M12.5 12.5a10.6 10.6 0 0 0 0 15M27.5 12.5a10.6 10.6 0 0 1 0 15M7.5 7.5a17.7 17.7 0 0 0 0 25M32.5 7.5a17.7 17.7 0 0 1 0 25"/>',
  grabado: '<rect x="5" y="9" width="30" height="20" rx="2"/><path d="M17 15v8l7-4z"/><path d="M12 33h16"/>',
  proyecto: '<circle cx="20" cy="20" r="14"/><circle cx="20" cy="20" r="8"/><circle cx="20" cy="20" r="2"/><path d="M20 2v6M20 32v6M2 20h6M32 20h6"/>',
  certificado: '<rect x="6" y="5" width="22" height="28" rx="2"/><path d="M11 12h12M11 17h8"/><circle cx="29" cy="27" r="6"/><path d="m26 32-1 6 4-2 4 2-1-6"/>',
};
---
<Base titulo={sitio.nombre} descripcion={sitio.descripcion} jsonLd={jsonLd}>
  <!-- HERO -->
  <section class="hero" aria-labelledby="hero-titulo">
    <div class="contenedor hero__rejilla">
      <div class="hero__texto">
        <p class="etiqueta">Educación continua</p>
        <h1 id="hero-titulo" class="hero__titulo">Formamos profesionales para competir en un mercado global: comercio exterior, datos e inteligencia artificial, con clases en vivo y certificación verificable.</h1>
        <div class="acciones">
          <a class="btn btn--negro" href="/programas">Ver programas <Flecha /></a>
          <a class="btn btn--contorno" href={enlaceWhatsapp("Hola, quiero que un asesor me ayude a elegir un programa.")} target="_blank" rel="noopener">Hablar con un asesor</a>
        </div>
      </div>

      <!-- Arco de la «C» envolvente del isologo, en el dorado del logo (manual 1.5) -->
      <div class="hero__arco" aria-hidden="true">
        <svg viewBox="0 0 400 400">
          <defs>
            <linearGradient id="oro" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0" stop-color="#fff3c4" />
              <stop offset=".22" stop-color="#d8c362" />
              <stop offset=".48" stop-color="#ac581c" />
              <stop offset=".7" stop-color="#e9cf74" />
              <stop offset="1" stop-color="#8a4a18" />
            </linearGradient>
            <linearGradient id="brillo" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#fff" stop-opacity=".75" />
              <stop offset=".5" stop-color="#fff" stop-opacity="0" />
            </linearGradient>
            <filter id="sombra" x="-20%" y="-20%" width="140%" height="140%"><feDropShadow dx="0" dy="18" stdDeviation="16" flood-color="#5a3510" flood-opacity=".28" /></filter>
          </defs>
          <g class="hero__arco-giro" filter="url(#sombra)">
            <path class="hero__arco-trazo" d="M 313.1 86.9 A 160 160 0 1 0 313.1 313.1" fill="none" stroke="url(#oro)" stroke-width="52" stroke-linecap="butt" pathLength="100" />
            <path d="M 313.1 86.9 A 160 160 0 1 0 313.1 313.1" fill="none" stroke="url(#brillo)" stroke-width="18" transform="translate(-6 -10)" opacity=".7" />
          </g>
        </svg>
      </div>

      <ul role="list" class="hero__ventajas">
        {formas.filter((f) => f.icono !== "grabado").map((f) => (
          <li>
            <svg class="icono" viewBox="0 0 40 40" aria-hidden="true" set:html={iconos[f.icono]} />
            <div><strong>{f.titulo}</strong><span>{f.texto}</span></div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- PROGRAMAS -->
  <section class="seccion" aria-labelledby="destacados-titulo">
    <div class="contenedor">
      <div class="cabeza">
        <div>
          <p class="etiqueta">Programas</p>
          <h2 id="destacados-titulo" class="titulo-seccion">Programas con temario completo</h2>
        </div>
        <a class="btn btn--contorno" href="/programas">Ver el catálogo <Flecha /></a>
      </div>

      <div class="destacados">
        <a class="tarjeta" href={`/programas/${destacado.slug}`}>
          <div class="tarjeta__visual">
            <span class="tarjeta__linea">{areaPorId[destacado.area].nombre}</span>
            <span class="tarjeta__nombre">{destacado.nombre}</span>
            <svg class="tarjeta__arco" viewBox="0 0 200 200" aria-hidden="true"><path d="M 156.6 43.4 A 80 80 0 1 0 156.6 156.6" fill="none" stroke="var(--amarillo)" stroke-width="22" /></svg>
          </div>
          <div class="tarjeta__meta">
            <span class="ficha-tag">{areaPorId[destacado.area].nombre}</span>
            <span class="ficha-tag">{destacado.datos[0].valor}</span>
          </div>
          <p class="tarjeta__resumen">{destacado.resumen}</p>
          <span class="tarjeta__ir" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 14 14"><path d="M2 7h9M7.5 3 11.5 7l-4 4" fill="none" stroke="currentColor" stroke-width="2" /></svg></span>
        </a>

        <ol role="list" class="filas">
          {resto.map((p, i) => (
            <li>
              <a class="fila" href={`/programas/${p.slug}`} style={`--c:${p.color ?? areaPorId[p.area].color}`}>
                <span class="numero"><i aria-hidden="true"></i>{dos(i + 2)}</span>
                <span class="fila__cuerpo">
                  <span class="fila__nombre">{p.nombre}</span>
                  <span class="fila__dato">{p.datos.map((d) => d.valor).slice(0, 2).join(" · ")}</span>
                </span>
                <span class="fila__ir" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 14 14"><path d="M2 7h9M7.5 3 11.5 7l-4 4" fill="none" stroke="currentColor" stroke-width="2" /></svg></span>
              </a>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- CAMPAÑA: «Educación continua · Aprende, certifícate y avanza» (banner oficial de la CE) -->
  <section class="campana" aria-labelledby="campana-titulo">
    <figure class="campana__foto">
      <Picture src={fotoTren} formats={["avif", "webp"]} widths={[640, 1000, 1500, 2000]} sizes="100vw" alt="Equipo de la Cámara de Comercio Exterior en un andén, junto a un tren con el logo de la CE" />
    </figure>
    <div class="contenedor">
      <div class="campana__panel sobre-oscuro">
        <p class="etiqueta">Educación continua</p>
        <h2 id="campana-titulo" class="campana__titulo">Aprende, certifícate y avanza.</h2>
        <p class="campana__texto">Programas en vivo, con proyectos aplicados y certificado digital verificable, para que des el siguiente paso en tu carrera.</p>
        <a class="btn btn--amarillo" href="/programas">Ver programas <Flecha /></a>
      </div>
    </div>
  </section>

  <!-- CÓMO ESTUDIAS -->
  <section class="seccion" aria-labelledby="formas-titulo">
    <div class="contenedor formas">
      <div>
        <p class="etiqueta">Cómo estudias</p>
        <h2 id="formas-titulo" class="titulo-seccion">Estudias en línea, pero no estudias solo.</h2>
        <p class="intro">Todos los programas son virtuales y combinan sesiones con el docente, material para repasar y un proyecto que demuestra lo que aprendiste.</p>
      </div>
      <ul role="list" class="formas__lista">
        {formas.map((f) => (
          <li>
            <svg class="icono" viewBox="0 0 40 40" aria-hidden="true" set:html={iconos[f.icono]} />
            <h3>{f.titulo}</h3>
            <p>{f.texto}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- COMUNIDAD: fotos de eventos presenciales de la CE -->
  <section class="seccion comunidad" aria-labelledby="comunidad-titulo">
    <div class="contenedor comunidad__rejilla">
      <div class="comunidad__texto">
        <p class="etiqueta">Comunidad</p>
        <!-- Frase del banner institucional de la CE -->
        <h2 id="comunidad-titulo" class="titulo-seccion">Conectamos talento, impulsamos desarrollo.</h2>
        <p class="intro">Además de los programas virtuales, llevamos la formación a espacios presenciales con talleres y charlas, como los workshops de inteligencia artificial y de importación.</p>
      </div>
      <figure class="comunidad__foto comunidad__foto--principal">
        <Picture src={fotoAuditorio} formats={["avif", "webp"]} widths={[640, 960, 1400, 2000]} sizes="(max-width: 860px) 100vw, 58vw" alt="Participantes y equipo de la Cámara de Comercio Exterior en un auditorio lleno al cierre de un evento" />
      </figure>
      <figure class="comunidad__foto comunidad__foto--charla">
        <Picture src={fotoCharla} formats={["avif", "webp"]} widths={[480, 800, 1200]} sizes="(max-width: 860px) 100vw, 33vw" alt="Ponente explicando qué son las IA generativas frente a una proyección" />
      </figure>
      <figure class="comunidad__foto comunidad__foto--registro">
        <Picture src={fotoRegistro} formats={["avif", "webp"]} widths={[480, 800, 1200]} sizes="(max-width: 860px) 50vw, 33vw" alt="Fila de estudiantes registrándose junto al banner de la Cámara de Comercio Exterior" />
      </figure>
      <figure class="comunidad__foto comunidad__foto--kits">
        <Picture src={fotoKits} formats={["avif", "webp"]} widths={[480, 800, 1200]} sizes="(max-width: 860px) 50vw, 33vw" alt="Entrega de bolsas con el logo de la Cámara de Comercio Exterior a una participante" />
      </figure>
      <figure class="comunidad__foto comunidad__foto--cinta">
        <Picture src={fotoCinta} formats={["avif", "webp"]} widths={[640, 1000, 1400]} sizes="(max-width: 860px) 100vw, 66vw" alt="Corte de cinta con el lema «Aprende, certifícate y avanza» y el logo de la Cámara de Comercio Exterior" />
      </figure>
      <figure class="comunidad__foto comunidad__foto--batucada">
        <Picture src={fotoBatucada} formats={["avif", "webp"]} widths={[480, 800, 1200]} sizes="(max-width: 860px) 100vw, 33vw" alt="Batucada con sombreros amarillos junto al banner «Educación continua» de la Cámara de Comercio Exterior" />
      </figure>
    </div>
  </section>

  <!-- ÁREAS -->
  <section class="seccion" aria-labelledby="areas-titulo">
    <div class="contenedor">
      <p class="etiqueta">Áreas de formación</p>
      <h2 id="areas-titulo" class="titulo-seccion">Seis áreas, un mismo enfoque práctico</h2>
      <ul role="list" class="areas">
        {areas.map((a, i) => (
          <li>
            <a class="area" href={`/programas?area=${a.id}`} style={`--c:${a.color}`}>
              <span class="numero"><i aria-hidden="true"></i>{dos(i + 1)}</span>
              <span class="area__nombre">{a.nombre}</span>
              <span class="area__desc">{a.descripcion}</span>
              <span class="area__cuenta">{cuenta(a.id)} {cuenta(a.id) === 1 ? "programa" : "programas y cursos"}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- EMPRESAS -->
  <section class="seccion seccion--oscura sobre-oscuro empresas-banda" aria-labelledby="empresas-titulo">
    <div class="contenedor empresas">
      <div>
        <p class="etiqueta">Empresas</p>
        <h2 id="empresas-titulo" class="titulo-seccion">¿Necesitas capacitar a tu equipo?</h2>
      </div>
      <div>
        <p class="intro">Coordinamos programas del catálogo para grupos de colaboradores, con condiciones corporativas. Cuéntanos cuántas personas son y qué necesitan aprender.</p>
        <div class="acciones">
          <a class="btn btn--amarillo" href="/empresas">Capacitación para empresas <Flecha /></a>
          <a class="btn btn--contorno" href={enlaceWhatsapp("Hola, quiero información sobre cursos para empresas y precio corporativo.")} target="_blank" rel="noopener">Escribir por WhatsApp</a>
        </div>
      </div>
    </div>
  </section>

  <!-- PASOS -->
  <section class="seccion" aria-labelledby="pasos-titulo">
    <div class="contenedor">
      <p class="etiqueta">Inscripción</p>
      <h2 id="pasos-titulo" class="titulo-seccion">Cómo inscribirte</h2>
      <ol role="list" class="pasos">
        <li style="--n:0"><span class="pasos__n" data-n="01" aria-hidden="true"></span><h3>Elige tu programa</h3><p>Revisa el temario, la duración y la modalidad en la página de cada programa.</p></li>
        <li style="--n:1"><span class="pasos__n" data-n="02" aria-hidden="true"></span><h3>Habla con un asesor</h3><p>Por WhatsApp o el formulario: te confirma horarios, inversión vigente y medios de pago.</p></li>
        <li style="--n:2"><span class="pasos__n" data-n="03" aria-hidden="true"></span><h3>Matricúlate y empieza</h3><p>Recibes tus accesos y te unes a las clases en vivo de tu grupo.</p></li>
      </ol>
    </div>
  </section>

  <!-- PREGUNTAS FRECUENTES -->
  <section class="seccion faq" aria-labelledby="faq-titulo">
    <div class="contenedor">
      <div class="cabeza">
        <div>
          <p class="etiqueta">Preguntas frecuentes</p>
          <h2 id="faq-titulo" class="titulo-seccion">Resolvemos tus dudas</h2>
        </div>
        <div class="faq__contacto">
          <span>¿Tienes más preguntas?</span>
          <a class="btn btn--contorno" href="/contacto">Escríbenos <Flecha /></a>
        </div>
      </div>
      <div class="faq__lista">
        {preguntas.map((q, i) => (
          <details class="faq__item" name="faq">
            <summary>
              <span class="numero"><i aria-hidden="true"></i>{dos(i + 1)}</span>
              <span class="faq__pregunta">{q.p}</span>
              <span class="faq__mas" aria-hidden="true"></span>
            </summary>
            <p class="faq__respuesta">{q.r}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .acciones { display: flex; flex-wrap: wrap; gap: var(--s-3); margin-top: var(--s-6); }
  .cabeza { display: flex; justify-content: space-between; align-items: end; gap: var(--s-5); flex-wrap: wrap; margin-bottom: var(--s-7); }
  .icono { width: 2.5rem; height: 2.5rem; flex: none; fill: none; stroke: currentColor; stroke-width: 1.4; stroke-linecap: round; stroke-linejoin: round; }

  /* Número en etiqueta (▪01): cuadradito de color + dígitos en Montserrat */
  .numero {
    display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.25rem 0.45rem; border-radius: 2px; background: var(--gris-boton);
    font-family: var(--font-marca); font-size: 0.68rem; font-weight: 700; letter-spacing: 0.06em; font-variant-numeric: tabular-nums; color: var(--gris-oscuro);
  }
  .numero i { width: 0.35rem; height: 0.35rem; background: var(--c, var(--negro)); }

  /* HERO */
  .hero { position: relative; overflow-x: clip; padding-block: clamp(2.5rem, 1rem + 5vw, 5.5rem) var(--s-4); }
  .hero__rejilla { display: grid; grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr); gap: var(--s-7) var(--s-8); align-items: center; }
  .hero__titulo { font-size: clamp(1.9rem, 1rem + 2.6vw, 3.35rem); font-weight: 400; letter-spacing: -0.03em; line-height: 1.12; max-width: 30ch; text-wrap: pretty; }
  .hero__arco { justify-self: end; width: min(100%, 30rem); aspect-ratio: 1; }
  .hero__arco svg { width: 100%; height: 100%; overflow: visible; }
  .hero__ventajas { grid-column: 1 / -1; display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--s-6); margin-top: var(--s-6); padding-top: var(--s-6); border-top: 1px dashed var(--gris-claro); }
  .hero__ventajas li { display: flex; gap: var(--s-4); align-items: start; }
  .hero__ventajas strong { display: block; font-weight: 600; margin-bottom: 4px; }
  .hero__ventajas span { display: block; font-size: var(--t-sm); color: var(--gris-oscuro); }
  @media (prefers-reduced-motion: no-preference) {
    .hero__arco-trazo { stroke-dasharray: 100; stroke-dashoffset: 100; animation: trazar 1.6s var(--ease) 0.2s forwards; }
    .hero__arco-giro { transform-origin: 200px 200px; animation: flotar 9s ease-in-out 1.8s infinite; }
    @keyframes trazar { to { stroke-dashoffset: 0; } }
    @keyframes flotar { 0%, 100% { transform: translateY(0) rotate(0deg); } 50% { transform: translateY(-14px) rotate(-6deg); } }
  }

  /* PROGRAMAS */
  .destacados { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.35fr); gap: var(--s-6); align-items: start; }
  .tarjeta { position: relative; display: block; text-decoration: none; }
  .tarjeta__visual {
    position: relative; display: flex; flex-direction: column; justify-content: space-between; aspect-ratio: 16 / 10; overflow: hidden;
    padding: var(--s-5); border-radius: 4px; color: var(--blanco);
    background: radial-gradient(120% 90% at 50% 120%, rgba(255, 195, 0, 0.55), transparent 60%), linear-gradient(#0a0a0a, #000);
  }
  .tarjeta__linea { font-family: var(--font-marca); font-size: 0.68rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--amarillo); }
  .tarjeta__nombre { position: relative; z-index: 1; font-size: clamp(2rem, 1.2rem + 2.4vw, 3.4rem); font-weight: 450; letter-spacing: -0.035em; line-height: 1; max-width: 10ch; }
  .tarjeta__arco { position: absolute; right: -10%; top: -22%; width: 50%; opacity: 0.95; transition: transform 600ms var(--ease); }
  .tarjeta:hover .tarjeta__arco { transform: rotate(-12deg); }
  .tarjeta__meta { display: flex; justify-content: space-between; gap: var(--s-3); margin-top: var(--s-4); }
  .ficha-tag { font-family: var(--font-marca); font-size: 0.65rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; padding: 0.3rem 0.5rem; border: 1px solid var(--gris-claro); border-radius: 2px; }
  .tarjeta__resumen { margin-top: var(--s-4); font-size: var(--t-lg); line-height: 1.35; letter-spacing: -0.01em; }
  .tarjeta__ir, .fila__ir {
    display: grid; place-items: center; width: 2.25rem; height: 2.25rem; margin-top: var(--s-4); border-radius: 2px;
    background: var(--negro); color: var(--amarillo); transition: transform 250ms var(--ease);
  }
  .tarjeta:hover .tarjeta__ir, .fila:hover .fila__ir { transform: translateX(4px); }

  .filas { display: grid; gap: 2px; }
  .fila {
    display: grid; grid-template-columns: auto 1fr auto; gap: var(--s-5); align-items: center;
    padding: var(--s-4) var(--s-4) var(--s-4) var(--s-4); background: rgba(255, 255, 255, 0.65); border-radius: 3px; text-decoration: none;
    backdrop-filter: blur(6px); transition: background-color 200ms var(--ease);
  }
  .fila:hover { background: rgba(255, 255, 255, 0.95); }
  .fila__nombre { display: block; font-weight: 500; font-size: var(--t-lg); letter-spacing: -0.015em; line-height: 1.25; }
