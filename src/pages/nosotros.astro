---
import Base from "../layouts/Base.astro";
import Arco from "../components/Arco.astro";
import { sitio } from "../data/sitio";
import { Picture } from "astro:assets";
import fotoAuditorio from "../assets/fotos/evento-auditorio.jpg";
import fotoMarca from "../assets/fotos/marca-el-exito-lo-logramos-juntos.jpg";
import fotoPresentacion from "../assets/fotos/evento-presentacion-educacion-continua.jpg";
---
<Base titulo="Nosotros" descripcion="Conoce a la Cámara de Comercio Exterior (CE): nuestra visión de ser un Centro de Capacitación Profesional Internacional y nuestros valores.">
  <section class="encabezado-pagina">
    <div class="contenedor">
      <h1 class="titulo-pagina">Un centro de capacitación con mirada internacional</h1>
    </div>
    <figure class="contenedor portada">
      <Picture src={fotoAuditorio} formats={["avif", "webp"]} widths={[640, 1000, 1400, 2000]} sizes="(max-width: 1280px) 100vw, 1200px" alt="Participantes y equipo de la Cámara de Comercio Exterior en un auditorio lleno al cierre de un evento" loading="eager" fetchpriority="high" />
    </figure>
  </section>

  <section class="seccion vision" aria-labelledby="vision">
    <div class="contenedor vision__rejilla">
      <div class="vision__simbolo">
        <Arco class="vision__arco" grosor={20} />
        <img src="/brand/isologo-color.svg" alt="Isologo de la Cámara de Comercio Exterior" width="160" height="160" loading="lazy" />
      </div>
      <div>
        <h2 id="vision" class="titulo-seccion">Nuestra visión</h2>
        <p class="cita">{sitio.vision}</p>
        <p class="texto">La «C» envolvente de nuestro isologo simboliza protección, conexión y unidad: acompañamos a cada estudiante y a cada empresa mientras aprenden lo que necesitan para competir.</p>
      </div>
    </div>
  </section>

  <section class="seccion seccion--suave" aria-labelledby="valores">
    <div class="contenedor">
      <h2 id="valores" class="titulo-seccion">Nuestros valores</h2>
      <ul role="list" class="valores">
        {sitio.valores.map((v) => <li>{v}</li>)}
      </ul>
    </div>
  </section>

  <section class="seccion" aria-labelledby="forma">
    <div class="contenedor dos">
      <div>
        <h2 id="forma" class="titulo-seccion">Cómo formamos</h2>
        <figure class="forma__foto">
          <Picture src={fotoPresentacion} formats={["avif", "webp"]} widths={[480, 800, 1200]} sizes="(max-width: 900px) 100vw, 40vw" alt="Presentación junto al banner «Educación continua: Aprende, certifícate y avanza» de la Cámara de Comercio Exterior" />
        </figure>
      </div>
      <div class="texto-largo">
        <p>Nuestros programas combinan clases en vivo con el docente, material para repasar a tu ritmo y un proyecto aplicado al final. Cubren comercio exterior, análisis de datos, inteligencia artificial, marketing, diseño, ingeniería e idiomas.</p>
        <p>Al terminar recibes un certificado digital de la Cámara de Comercio Exterior con código QR, para que cualquier persona pueda verificar su autenticidad.</p>
        <p><a class="enlace" href="/programas">Conoce los programas</a></p>
      </div>
    </div>
  </section>

  <section class="seccion sigla" aria-labelledby="sigla">
    <div class="contenedor dos">
      <figure class="sigla__foto">
        <Picture src={fotoMarca} formats={["avif", "webp"]} widths={[480, 800, 1200]} sizes="(max-width: 900px) 100vw, 40vw" alt="Bolsa negra con el imagotipo de la Cámara de Comercio Exterior y la frase «El éxito lo logramos juntos.»" />
      </figure>
      <div>
        <h2 id="sigla" class="titulo-seccion">Somos CE</h2>
        <div class="texto-largo">
          <p>La forma correcta y oficial de abreviar Cámara de Comercio Exterior es <strong>CE</strong>, por sus iniciales. Te pedimos usarla en comunicaciones, documentos y menciones a la institución.</p>
          <p class="lema">El éxito lo logramos juntos.</p>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .vision__rejilla { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: var(--s-8); align-items: center; }
  .vision__simbolo { position: relative; aspect-ratio: 1; display: grid; place-items: center; max-width: 26rem; }
  .vision__simbolo :global(.vision__arco) { position: absolute; inset: 0; width: 100%; height: 100%; }
  /* El isologo conserva su área de protección dentro del arco */
  .vision__simbolo img { position: relative; width: 38%; height: auto; }
  .cita { margin-top: var(--s-5); font-size: var(--t-xl); font-weight: 700; line-height: 1.3; letter-spacing: -0.015em; max-width: 30ch; }
  .texto { margin-top: var(--s-5); color: var(--gris-oscuro); max-width: 52ch; }
  .valores { display: grid; grid-template-columns: repeat(3, 1fr); margin-top: var(--s-7); border-top: 2px solid var(--negro); }
  .valores li { padding: var(--s-6) var(--s-4) var(--s-4) 0; font-size: clamp(1.75rem, 1.2rem + 2.2vw, 3rem); font-weight: 900; letter-spacing: -0.03em; border-right: 1px solid var(--linea); }
  .valores li + li { padding-left: var(--s-5); }
  .valores li:last-child { border-right: 0; }
  .dos { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr); gap: var(--s-8); align-items: start; }
  .texto-largo { display: grid; gap: var(--s-4); font-size: var(--t-lg); line-height: 1.55; color: var(--gris-oscuro); max-width: 58ch; }
  .texto-largo strong { color: var(--negro); }
  .forma__foto { margin: var(--s-6) 0 0; overflow: hidden; border-radius: var(--radio); aspect-ratio: 4 / 3; }
  .forma__foto :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; object-position: 50% 30%; }
  .sigla { padding-top: 0; }
  .sigla .dos { align-items: center; }
  .sigla__foto, .portada { margin: 0; }
  .sigla__foto { overflow: hidden; border-radius: var(--radio); aspect-ratio: 4 / 3; }
  .sigla__foto :global(img), .portada :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; }
  .sigla .titulo-seccion { margin-bottom: var(--s-5); }
  .lema { font-size: var(--t-xl); font-weight: 800; color: var(--negro); letter-spacing: -0.015em; }
  .portada { margin: var(--s-7) auto 0; }
  .portada :global(img) { aspect-ratio: 21 / 9; border-radius: var(--radio); }
  @media (max-width: 640px) { .portada :global(img) { aspect-ratio: 4 / 3; } }
  @media (max-width: 900px) {
    .vision__rejilla, .dos { grid-template-columns: 1fr; gap: var(--s-6); }
    .vision__simbolo { max-width: 18rem; }
  }
  @media (max-width: 640px) {
    .valores { grid-template-columns: 1fr; }
    .valores li { border-right: 0; border-bottom: 1px solid var(--linea); padding: var(--s-5) 0 !important; }
  }
</style>
