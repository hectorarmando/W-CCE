---
// Nosotros con la estructura del prototipo HTML del usuario. Visión y valores: Manual de Identidad 2026 (oficiales).
// La misión institucional, la historia, el liderazgo y los aliados aún no tienen fuente: se muestran como pendientes.
import Base from "../layouts/Base.astro";
import { sitio } from "../data/sitio";
import { paises } from "../data/paises";
import { Picture } from "astro:assets";
import fotoPresentacion from "../assets/fotos/evento-presentacion-educacion-continua.jpg";
import fotoMarca from "../assets/fotos/marca-el-exito-lo-logramos-juntos.jpg";

const hitos = [
  { anio: "Año", texto: "Fundación de la Cámara de Comercio Exterior." },
  { anio: "Año", texto: "Primeros países atendidos fuera del Perú." },
  { anio: "Año", texto: "Premio Varayoc: año y categoría por confirmar." },
  { anio: "Hoy", texto: `Programas en vivo para estudiantes de ${paises.filter((p) => p.codigo !== "OT").length} países.` },
];
const lideres = ["Dirección General", "Dirección Académica", "Dirección Comercial", "Innovación y Tecnología"];
const aliados = [
  { titulo: "Convenios de beneficios", texto: "Condiciones especiales para colaboradores de empresas aliadas." },
  { titulo: "Aliados académicos", texto: "Instituciones que respaldan nuestros programas." },
  { titulo: "Donde trabajan egresados", texto: "Empresas que incorporan talento formado en la CE." },
];
---
<Base titulo="Nosotros" descripcion="Conoce a la Cámara de Comercio Exterior (CE): nuestra visión de ser un Centro de Capacitación Profesional Internacional, nuestros valores y nuestra historia.">
  <div class="phead">
    <div class="contenedor">
      <nav class="migas-d" aria-label="Ruta de navegación"><a href="/">Inicio</a> / Nosotros</nav>
      <span class="eyebrow">Nosotros</span>
      <h1>Una institución con <span class="dorado">identidad</span> y propósito</h1>
      <p>Somos educación continua con certificado verificable. Esta es nuestra historia, nuestra gente y lo que nos mueve.</p>
    </div>
  </div>

  <section class="seccion-d" aria-labelledby="proposito">
    <div class="contenedor dos-d">
      <div>
        <span class="eyebrow">Propósito</span>
        <h2 id="proposito" class="h2-d">Misión y visión</h2>
        <div class="regla"></div>
        <div class="pilares">
          <div><strong>Misión</strong>La misión institucional está en revisión. <span class="pendiente">Pendiente</span></div>
          <div><strong>Visión</strong>{sitio.vision}</div>
        </div>
      </div>
      <figure class="marco-d">
        <Picture src={fotoPresentacion} formats={["avif", "webp"]} widths={[480, 800]} sizes="(max-width: 820px) 100vw, 30rem" alt="Presentación junto al banner «Educación continua: Aprende, certifícate y avanza» de la Cámara de Comercio Exterior" loading="eager" />
      </figure>
    </div>
  </section>

  <section class="seccion-d seccion-d--alt" aria-labelledby="historia">
    <div class="contenedor">
      <span class="eyebrow">Trayectoria</span>
      <h2 id="historia" class="h2-d">Nuestra historia</h2>
      <div class="regla"></div>
      <ol role="list" class="rejilla-d">
        {hitos.map((h) => (
          <li class="tarjeta-d hito">
            <b>{h.anio}</b>
            <p>{h.texto}</p>
            {h.anio === "Año" && <span class="pendiente">Dato por confirmar</span>}
          </li>
        ))}
      </ol>
      <h3 class="sedes__titulo">Países donde atendemos</h3>
      <ul role="list" class="sedes">
        {paises.filter((p) => p.codigo !== "OT").map((p) => <li>{p.nombre}</li>)}
      </ul>
    </div>
  </section>

  <section class="seccion-d" aria-labelledby="valores">
    <div class="contenedor">
      <span class="eyebrow">Valores</span>
      <h2 id="valores" class="h2-d">Lo que nos distingue</h2>
      <div class="regla"></div>
      <ul role="list" class="rejilla-d">
        {sitio.valores.map((v) => (<li class="tarjeta-d"><h3>{v}</h3></li>))}
      </ul>
    </div>
  </section>

  <section class="seccion-d seccion-d--alt" id="lideres" aria-labelledby="liderazgo">
    <div class="contenedor">
      <span class="eyebrow">Liderazgo</span>
      <h2 id="liderazgo" class="h2-d">Las personas detrás de la {sitio.sigla}</h2>
      <div class="regla"></div>
      <ul role="list" class="lideres">
        {lideres.map((cargo) => (
          <li>
            <figure>
              <div class="avatar" aria-hidden="true">N</div>
              <figcaption><b>Nombre por confirmar</b>{cargo}</figcaption>
            </figure>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="seccion-d" aria-labelledby="aliados">
    <div class="contenedor">
      <span class="eyebrow">Aliados estratégicos</span>
      <h2 id="aliados" class="h2-d">Respaldo que se explica</h2>
      <div class="regla"></div>
      <ul role="list" class="aliados">
        {aliados.map((a) => (
          <li class="tarjeta-d">
            <h3>{a.titulo}</h3>
            <p>{a.texto}</p>
            <div class="logos"><span>Logo pendiente</span><span>Logo pendiente</span><span>Logo pendiente</span></div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="seccion-d seccion-d--alt" aria-labelledby="sigla">
    <div class="contenedor dos-d">
      <figure class="marco-d marco-d--ancho">
        <Picture src={fotoMarca} formats={["avif", "webp"]} widths={[480, 800]} sizes="(max-width: 820px) 100vw, 30rem" alt="Bolsa negra con el imagotipo de la Cámara de Comercio Exterior y la frase «El éxito lo logramos juntos.»" />
      </figure>
      <div>
        <span class="eyebrow">Identidad</span>
        <h2 id="sigla" class="h2-d">Somos {sitio.sigla}</h2>
        <div class="regla"></div>
        <p class="mut">La forma correcta y oficial de abreviar Cámara de Comercio Exterior es <strong>CE</strong>, por sus iniciales. Te pedimos usarla en comunicaciones, documentos y menciones a la institución.</p>
        <p class="lema">El éxito lo logramos juntos.</p>
      </div>
    </div>
  </section>
</Base>

<style>
  .pilares { display: flex; flex-direction: column; gap: 14px; margin-top: 1.6rem; }
  .pilares > div { border-left: 1px solid var(--gold); padding-left: 14px; font-size: 0.92rem; color: var(--mut); }
  .pilares strong { display: block; color: var(--ink); font: 600 1.15rem var(--serif); letter-spacing: 0.04em; }
  .pilares .pendiente { margin-left: 0.4rem; }
  .hito b { display: block; font: 600 1.9rem var(--serif); color: var(--gold2); }
  .hito p { margin-top: 0.5rem; }
  .hito .pendiente { margin-top: 0.8rem; }
  .sedes__titulo { margin-top: 2.4rem; font-size: 1.3rem; }
  .sedes { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 1rem; }
  .sedes li { padding: 10px 18px; border: 1px solid var(--gold); font-size: 0.78rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--gold2); }
  .lideres { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 22px; margin-top: 2.4rem; }
  .lideres figure { margin: 0; text-align: center; }
  .avatar { display: grid; place-items: center; aspect-ratio: 1; border: 1px solid var(--line); background: linear-gradient(160deg, #1a1710, #0d0d0d); font: 600 2.4rem var(--serif); color: var(--gold); }
  .lideres figcaption { margin-top: 12px; font-size: 0.88rem; color: var(--mut); }
  .lideres figcaption b { display: block; color: var(--ink); font: 600 1.2rem var(--serif); }
  .aliados { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 18px; margin-top: 2.4rem; }
  .aliados .tarjeta-d:hover { transform: none; }
  .logos { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 14px; }
  .logos span { border: 1px dashed var(--line); padding: 8px 14px; font-size: 0.72rem; letter-spacing: 0.14em; color: var(--mut); text-transform: uppercase; }
  .marco-d--ancho { aspect-ratio: 4 / 3; }
  .lema { margin-top: 1.2rem; font: 600 1.6rem var(--serif); color: var(--gold2); }
</style>
