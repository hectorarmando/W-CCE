---
import Base from "../layouts/Base.astro";
import FormularioContacto from "../components/FormularioContacto.astro";
import { areas } from "../data/programas";
import { enlaceWhatsapp } from "../data/sitio";
import LluviaDatos from "../components/LluviaDatos";
---
<Base titulo="Capacitación para empresas" descripcion="Capacita a tu equipo con los programas de la Cámara de Comercio Exterior: comercio exterior, Excel, Power BI, inteligencia artificial y más, con condiciones corporativas.">
  <section class="encabezado-pagina sobre-oscuro empresas-hero">
    <!-- Fondo: flujo de datos que se aparta alrededor del cursor (decorativo, aria-hidden) -->
    <LluviaDatos client:only="react" count={2400} obstacleRadius={70} />
    <div class="contenedor">
      <h1 class="titulo-pagina">Capacitación para tu equipo</h1>
      <p class="intro">Lleva los programas de la Cámara de Comercio Exterior a tus colaboradores, con condiciones corporativas para grupos.</p>
      <div class="acciones">
        <a class="btn btn--amarillo" href="#cotizar">Solicitar información</a>
        <a class="btn btn--contorno" href={enlaceWhatsapp("Hola, quiero información sobre cursos para empresas y precio corporativo.")} target="_blank" rel="noopener">Escribir por WhatsApp</a>
      </div>
    </div>
  </section>

  <section class="seccion" aria-labelledby="que">
    <div class="contenedor dos">
      <h2 id="que" class="titulo-seccion">Formación que se nota en el trabajo diario</h2>
      <div>
        <p class="intro">Elegimos contigo los programas del catálogo que responden a lo que tu equipo necesita: desde operar una importación hasta automatizar reportes o usar inteligencia artificial con criterio.</p>
        <ul role="list" class="areas-lista">
          {areas.map((a) => (<li style={`--c:${a.color}`}><span aria-hidden="true"></span><div><strong>{a.nombre}</strong>{a.descripcion}</div></li>))}
        </ul>
      </div>
    </div>
  </section>

  <section class="seccion seccion--suave" aria-labelledby="como">
    <div class="contenedor">
      <h2 id="como" class="titulo-seccion">Cómo coordinamos</h2>
      <ol role="list" class="pasos">
        <li><span class="n" aria-hidden="true">1</span><h3>Nos cuentas la necesidad</h3><p>Área, número de personas y qué deben poder hacer al terminar.</p></li>
        <li><span class="n" aria-hidden="true">2</span><h3>Recibes la propuesta</h3><p>Un asesor te comparte programas, modalidad, horarios e inversión corporativa.</p></li>
        <li><span class="n" aria-hidden="true">3</span><h3>Tu equipo empieza</h3><p>Coordinamos los accesos y el inicio de clases con tu empresa.</p></li>
      </ol>
    </div>
  </section>

  <section class="seccion" id="cotizar" aria-labelledby="form-titulo">
    <div class="contenedor dos">
      <div>
        <h2 id="form-titulo" class="titulo-seccion">Solicita información para tu empresa</h2>
        <p class="intro">Completa el formulario y un asesor corporativo se comunicará contigo.</p>
      </div>
      <FormularioContacto modo="empresa" />
    </div>
  </section>
</Base>

<style>
  .empresas-hero { position: relative; overflow: hidden; isolation: isolate; background: var(--negro); color: var(--blanco); padding-bottom: clamp(3rem, 2rem + 4vw, 6rem); }
  /* El texto va por encima del lienzo de la lluvia de datos */
  .empresas-hero > .contenedor { position: relative; z-index: 2; }
  /* Velo hacia la izquierda: las líneas pasan detrás del texto sin restarle contraste */
  .empresas-hero::after { content: ""; position: absolute; inset: 0; z-index: 1; pointer-events: none; background: linear-gradient(90deg, rgba(0, 0, 0, 0.82) 0%, rgba(0, 0, 0, 0.55) 38%, transparent 70%); }
  /* Botón para pausar la lluvia de datos (movimiento continuo) */
  .empresas-hero :global(.lluvia-pausa) {
    position: absolute; right: var(--gutter); bottom: var(--s-4); z-index: 3; min-height: 44px; padding: 0 1rem; border-radius: 999px; cursor: pointer;
    border: 1.5px solid rgba(255, 255, 255, 0.3); background: rgba(0, 0, 0, 0.5); color: var(--blanco); font-size: var(--t-xs); font-weight: 600;
  }
  .empresas-hero :global(.lluvia-pausa:hover) { border-color: var(--amarillo); }
  @media (max-width: 700px) { .empresas-hero::after { background: rgba(0, 0, 0, 0.45); } }
  .empresas-hero .intro { color: #d9d9d9; }
  .acciones { display: flex; flex-wrap: wrap; gap: var(--s-3); margin-top: var(--s-6); }
  .dos { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr); gap: var(--s-8); align-items: start; }
  .areas-lista { display: grid; gap: 0; margin-top: var(--s-6); border-top: 1px solid var(--negro); }
  .areas-lista li { display: grid; grid-template-columns: 6px 1fr; gap: var(--s-4); padding: var(--s-4) 0; border-bottom: 1px solid var(--linea); color: var(--gris-oscuro); font-size: var(--t-sm); }
  .areas-lista span { background: var(--c); border-radius: 3px; }
  .areas-lista strong { display: block; color: var(--negro); font-size: var(--t-base); }
  .pasos { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--s-6); margin-top: var(--s-7); }
  .pasos li { padding-top: var(--s-5); border-top: 1px solid var(--gris-claro); }
  .n { display: grid; place-items: center; width: 2.75rem; height: 2.75rem; border-radius: 50%; background: var(--negro); color: var(--amarillo); font-weight: 900; margin-bottom: var(--s-5); }
  .pasos h3 { font-size: var(--t-lg); }
  .pasos p { margin-top: var(--s-3); color: var(--gris-oscuro); font-size: var(--t-sm); }
  @media (max-width: 900px) { .dos, .pasos { grid-template-columns: 1fr; gap: var(--s-6); } }
  @media (max-width: 560px) { .acciones .btn { width: 100%; } }
</style>
