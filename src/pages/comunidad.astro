---
import Base from "../layouts/Base.astro";
import Flecha from "../components/Flecha.astro";
import { WorksWheel, type WorksWheelItem } from "@/components/ui/works-wheel";
import { galeria } from "../data/galeria";
import { getImage } from "astro:assets";
// Tailwind solo se carga en las páginas que usan componentes de src/components/ui
import "../styles/tailwind.css";

// La rueda recibe URLs ya optimizadas (WebP de 1200 px) generadas al compilar
const items: WorksWheelItem[] = await Promise.all(
  galeria.map(async (g) => ({
    title: g.titulo,
    image: (await getImage({ src: g.foto, width: 1200, format: "webp", quality: 78 })).src,
  })),
);
---
<Base titulo="Comunidad" descripcion="Talleres, charlas y campañas presenciales de la Cámara de Comercio Exterior: la comunidad detrás de los programas virtuales.">
  <section class="encabezado-pagina">
    <div class="contenedor">
      <h1 class="titulo-pagina">Conectamos talento, impulsamos desarrollo.</h1>
      <p class="intro">Además de los programas virtuales, llevamos la formación a espacios presenciales. Gira la rueda con el scroll, arrastrando o con las flechas del teclado.</p>
    </div>
  </section>

  <div class="contenedor">
    <div class="rueda ui">
      <!-- Solo en el cliente: la rueda mide su escenario al montarse, así que su versión de servidor
           no aporta nada y retrasaba el pintado de la página en celulares -->
      <WorksWheel client:only="react" items={items} label="Comunidad CE">
        <p slot="fallback" class="rueda__espera">Cargando la galería…</p>
      </WorksWheel>
    </div>
  </div>

  <section class="seccion">
    <div class="contenedor cierre">
      <h2 class="titulo-seccion">¿Quieres ser parte?</h2>
      <a class="btn btn--negro" href="/programas">Ver programas <Flecha /></a>
    </div>
  </section>
</Base>

<style>
  /* Altura menor que la pantalla: en móvil queda espacio arriba y abajo para seguir desplazando la página */
  .rueda { height: clamp(26rem, 72svh, 52rem); border-radius: var(--radio-l); overflow: hidden; background: var(--blanco); box-shadow: 0 0 0 1px var(--linea); }
  /* En pantallas angostas el índice de la rueda queda demasiado pequeño para leerse: se navega arrastrando */
  @media (max-width: 640px) { .rueda { height: clamp(22rem, 58svh, 30rem); } .rueda :global(ol) { display: none; } }
  /* Índice: cada entrada con al menos 24 px de alto, para que se pueda tocar o hacer clic con precisión */
  .rueda :global(ol button) { min-height: 24px; }
  .rueda__espera { display: grid; place-items: center; height: 100%; color: var(--gris-oscuro); }
  .cierre { display: flex; justify-content: space-between; align-items: end; gap: var(--s-5); flex-wrap: wrap; }
</style>
