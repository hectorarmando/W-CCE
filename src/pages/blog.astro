---
// Blog con la estructura del prototipo HTML del usuario: nota destacada, filtros por categoría y rejilla de notas.
// Todavía no hay notas escritas: se muestran los temas propuestos como «En preparación» (src/data/blog.ts).
import Base from "../layouts/Base.astro";
import { sitio } from "../data/sitio";
import { notas, categoriasBlog } from "../data/blog";

const destacada = notas.find((n) => n.destacada) ?? notas[0];
const resto = notas.filter((n) => n !== destacada);
---
<Base titulo="Blog" descripcion="Ideas, tendencias y casos reales de educación continua de la Cámara de Comercio Exterior (CE).">
  <div class="phead">
    <div class="contenedor">
      <nav class="migas-d" aria-label="Ruta de navegación"><a href="/">Inicio</a> / Blog</nav>
      <span class="eyebrow">Blog {sitio.sigla}</span>
      <h1>Ideas, tendencias y <span class="dorado">casos reales</span></h1>
      <p>Análisis del mercado laboral, historias de egresados y novedades de educación continua.</p>
    </div>
  </div>

  <section class="seccion-d" aria-label="Notas">
    <div class="contenedor">
      <article class="destacada">
        <div class="destacada__th" aria-hidden="true">{sitio.sigla}</div>
        <div class="destacada__bd">
          <span class="eyebrow">Destacado · {destacada.categoria}</span>
          <h2>{destacada.titulo}</h2>
          <p class="mut">{destacada.resumen ?? "Nota en preparación: autor, cargo y fecha se publicarán con el texto."}</p>
          {!destacada.resumen && <span class="pendiente">En preparación</span>}
        </div>
      </article>

      <div class="filtros" role="group" aria-label="Filtrar por categoría" data-filtros>
        <button type="button" aria-pressed="true" data-c="todas">Todas</button>
        {categoriasBlog.map((c) => <button type="button" aria-pressed="false" data-c={c}>{c}</button>)}
      </div>

      <ul role="list" class="notas" data-notas>
        {resto.map((n) => (
          <li data-c={n.categoria}>
            <article class="nota">
              <div class="nota__th" aria-hidden="true">{sitio.sigla}</div>
              <div class="nota__bd">
                <span class="nota__tg">{n.categoria}</span>
                <h3>{n.titulo}</h3>
                <p>{n.resumen ?? <span class="pendiente">En preparación</span>}</p>
                <div class="nota__mt">{n.autor ? `${n.autor} · ${n.minutos} min` : "Autor por confirmar"}</div>
              </div>
            </article>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>

<style>
  .destacada { display: grid; grid-template-columns: 1.2fr 1fr; margin-bottom: 26px; border: 1px solid var(--gold); background: var(--card); }
  .destacada__th { display: grid; place-items: center; min-height: 260px; background: linear-gradient(135deg, #2a2110, #0c0c0c); font: 600 2.4rem var(--serif); color: rgba(201, 162, 75, 0.6); letter-spacing: 0.2em; }
  .destacada__bd { padding: 34px; }
  .destacada h2 { font-size: 2rem; margin: 0.7rem 0; }
  .filtros { display: flex; gap: 10px; flex-wrap: wrap; margin: 2rem 0; }
  .filtros button { min-height: 44px; padding: 9px 18px; border: 1px solid var(--line); background: none; color: var(--mut); font: 500 0.74rem var(--sans); letter-spacing: 0.14em; text-transform: uppercase; cursor: pointer; }
  .filtros button[aria-pressed="true"], .filtros button:hover { border-color: var(--gold); color: var(--gold2); }
  .notas { display: grid; grid-template-columns: repeat(auto-fill, minmax(290px, 1fr)); gap: 22px; }
  .notas li[hidden] { display: none; }
  .nota { display: flex; flex-direction: column; height: 100%; background: var(--card); border: 1px solid var(--line); }
  .nota__th { display: grid; place-items: center; aspect-ratio: 16 / 9; background: linear-gradient(135deg, #1c170c, #0c0c0c 60%, #2a2110); border-bottom: 1px solid var(--line); font: 600 1.6rem var(--serif); color: rgba(201, 162, 75, 0.55); letter-spacing: 0.2em; }
  .nota__bd { padding: 22px; }
  .nota__tg { font: 500 0.68rem var(--sans); letter-spacing: 0.22em; text-transform: uppercase; color: var(--gold); }
  .nota h3 { font-size: 1.35rem; margin: 0.6rem 0; }
  .nota p { margin: 0; color: var(--mut); font-size: 0.9rem; }
  .nota__mt { margin-top: 14px; font-size: 0.74rem; color: var(--mut); letter-spacing: 0.08em; }
  @media (max-width: 820px) { .destacada { grid-template-columns: 1fr; } .destacada__th { min-height: 180px; } }
</style>

<script>
  const grupo = document.querySelector<HTMLElement>("[data-filtros]");
  const filas = document.querySelectorAll<HTMLElement>("[data-notas] > li");
  grupo?.addEventListener("click", (e) => {
    const b = (e.target as HTMLElement).closest("button");
    if (!b) return;
    grupo.querySelectorAll("button").forEach((x) => x.setAttribute("aria-pressed", String(x === b)));
    filas.forEach((f) => { f.hidden = !(b.dataset.c === "todas" || f.dataset.c === b.dataset.c); });
  });
</script>
