---
import Base from "../layouts/Base.astro";
import { Picture } from "astro:assets";
import fotoBatucada from "../assets/fotos/evento-batucada.jpg";
---
<Base titulo="Página no encontrada" descripcion="La página que buscas no existe o cambió de dirección." noIndex>
  <section class="encabezado-pagina no-encontrada">
    <div class="contenedor">
      <h1 class="titulo-pagina">Esta página no existe o cambió de dirección</h1>
      <p class="intro">Revisa la dirección o sigue desde alguna de estas secciones.</p>
      <div class="acciones">
        <a class="btn btn--negro" href="/programas">Ver programas</a>
        <a class="btn btn--contorno" href="/">Ir al inicio</a>
        <a class="btn btn--contorno" href="/contacto">Contacto</a>
      </div>
    </div>
    <figure class="contenedor foto">
      <Picture src={fotoBatucada} formats={["avif", "webp"]} widths={[640, 1000, 1400]} sizes="(max-width: 1280px) 100vw, 1200px" alt="Batucada con sombreros y lentes amarillos y polos de la Cámara de Comercio Exterior" />
    </figure>
  </section>
</Base>

<style>
  .no-encontrada { padding-block: clamp(3rem, 2rem + 4vw, 6rem); }
  .foto { margin: var(--s-7) auto 0; }
  .foto :global(img) { display: block; width: 100%; height: auto; aspect-ratio: 21 / 9; object-fit: cover; object-position: 50% 40%; border-radius: var(--radio); }
  @media (max-width: 640px) { .foto :global(img) { aspect-ratio: 4 / 3; } }
  .acciones { display: flex; flex-wrap: wrap; gap: var(--s-3); margin-top: var(--s-6); }
</style>
