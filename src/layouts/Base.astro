---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { sitio, enlaceWhatsapp } from "../data/sitio";
// Montserrat (alfabeto latino, incluye tildes y ñ) precargada: evita el salto de diseño al cambiar de fuente
import fuenteLatina from "@fontsource-variable/montserrat/files/montserrat-latin-wght-normal.woff2?url";
import fuenteTexto from "@fontsource-variable/inter-tight/files/inter-tight-latin-wght-normal.woff2?url";

interface Props {
  titulo: string;
  descripcion: string;
  imagenOg?: string;
  noIndex?: boolean;
  jsonLd?: Record<string, unknown>;
}
const { titulo, descripcion, imagenOg = "/og/og-default.png", noIndex = false, jsonLd } = Astro.props;
const canonical = new URL(Astro.url.pathname.replace(/\.html$/, ""), Astro.site);
const tituloCompleto = titulo === sitio.nombre ? titulo : `${titulo} | ${sitio.nombre}`;
const og = new URL(imagenOg, Astro.site);
---
<!doctype html>
<html lang="es-PE">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonical} />
    {noIndex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#ffffff" />
    <link rel="preload" href={fuenteTexto} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={fuenteLatina} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_PE" />
    <meta property="og:site_name" content={sitio.nombre} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <script is:inline>document.documentElement.classList.add("js");</script>
    <style is:global>
      .senal-fija {
        position: fixed; right: max(var(--gutter), env(safe-area-inset-right)); bottom: max(1.25rem, env(safe-area-inset-bottom)); z-index: 45;
        display: inline-flex; align-items: center; gap: 0.6rem; min-height: 3.25rem; padding: 0 1.25rem 0 1rem; border-radius: 999px;
        background: var(--negro); color: var(--blanco); text-decoration: none;
        font-family: var(--font-marca); font-size: var(--t-sm); font-weight: 700; letter-spacing: -0.01em;
        box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.22), 0 18px 40px -18px rgba(0, 0, 0, 0.55);
        transition: transform var(--t-entrada) var(--ease), opacity var(--t-entrada) var(--ease), visibility 0s;
      }
      .senal-fija svg { color: var(--amarillo); }
      .senal-fija:hover { background: #262626; }
      /* Oculta mientras se ve la parte superior; sin JS queda siempre visible */
      .efectos .senal-fija:not(.activa) { transform: translateY(calc(100% + 2rem)); opacity: 0; visibility: hidden; transition: transform var(--t-entrada) var(--ease), opacity var(--t-entrada) var(--ease), visibility 0s var(--t-entrada); }
      @media (max-width: 560px) { .senal-fija { min-height: 3rem; padding: 0 1rem 0 0.85rem; font-size: var(--t-xs); } }
    </style>
  </head>
  <body>
    <a class="saltar" href="#contenido">Saltar al contenido</a>
    <Header />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
    <!-- Señal fija: aparece al dejar la parte superior de la página (scripts/efectos.ts) -->
    <a class="senal-fija" data-senal-fija href={enlaceWhatsapp("Hola, quiero que un asesor me ayude a elegir un programa.")} target="_blank" rel="noopener">
      <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2c-1.5 0-3-.4-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.4.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2l-.5-.3Z"/></svg>
      <span>Hablar con un asesor</span>
    </a>
    <script>
      import "../scripts/efectos";
    </script>
  </body>
</html>
